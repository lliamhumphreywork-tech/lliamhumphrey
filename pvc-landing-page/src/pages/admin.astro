    .copy-btn.copied { border-color: var(--green); color: var(--green); }

    /* ── LOADING STATE ── */
    .loading { padding: 60px 0; text-align: center; font-family: var(--g); font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: var(--silver-dim); animation: ldpulse 1.4s ease-in-out infinite; }
    @keyframes ldpulse { 0%,100% { opacity: 0.4; } 50% { opacity: 1; } }

    @media (max-width: 800px) {
      .panel { padding: 32px 20px 60px; }
      .dash-grid { grid-template-columns: 1fr 1fr; }
      .lead-biz, .lead-status, .lead-revenue { display: none; }
      .grid2 { grid-template-columns: 1fr; }
      .nav-brand, .nav-user { display: none; }
    }
  </style>
</head>
