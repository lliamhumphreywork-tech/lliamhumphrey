// ── Recordings ──
let recLoaded = false;

async function loadRecordings() {
  if (recLoaded) return;
  recLoaded = true;
  const list = document.getElementById('rec-list');
  if (!list) return;
  list.innerHTML = '<div style="font-size:12px;color:var(--silver-dim);padding:20px 0">Loading...</div>';
  try {
    const res = await fetch('/api/admin/upload-recording', { headers: H });
    const data = await res.json();
    renderRecList(data.recordings || []);
  } catch {
    list.innerHTML = '<div style="font-size:12px;color:#c94a5c;padding:20px 0">Failed to load</div>';
  }
}

function renderRecList(recs) {
  const list = document.getElementById('rec-list');
  const count = document.getElementById('rec-count');
  if (count) count.textContent = recs.length + ' recording' + (recs.length !== 1 ? 's' : '');
  if (!recs.length) {
    list.innerHTML = '<div style="font-size:12px;color:var(--silver-dim);padding:20px 0;text-align:center">No recordings yet</div>';
    return;
  }
  list.innerHTML = recs.map(r => `
    <div class="rec-item">
      <div class="rec-icon">
        <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:#4a8fe8;fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round">
          <polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/>
        </svg>
      </div>
      <div class="rec-body">
        <div class="rec-title">${esc(r.title)}</div>
        <div class="rec-date">${esc(r.date)}</div>
      </div>
      <button class="rec-del" onclick="deleteRecording('${esc(r.id)}', this)">Remove</button>
    </div>
  `).join('');
}

async function uploadRecording() {
  const fileInput = document.getElementById('rec-file');
  const titleInput = document.getElementById('rec-title');
  const file = fileInput?.files?.[0];
  const title = titleInput?.value.trim();
  if (!file) return showRecMsg('Choose a video file first.', 'err');
  if (!title) return showRecMsg('Add a title.', 'err');

  const blobUpload = window._blobUpload;
  if (!blobUpload) return showRecMsg('Upload not ready. Refresh and try again.', 'err');

  const btn = document.getElementById('rec-upload-btn');
  const progress = document.getElementById('rec-progress');
  const fill = document.getElementById('rec-progress-fill');
  const ptext = document.getElementById('rec-progress-text');
  btn.disabled = true; btn.textContent = 'Uploading...';
  progress.style.display = 'block';

  const ext = file.name.split('.').pop() ?? 'mp4';
  const pathname = `recordings/video/rec_${Date.now()}.${ext}`;
  const date = new Date().toLocaleDateString('en-ZA', { month: 'short', year: 'numeric' });

  try {
    await blobUpload(pathname, file, {
      access: 'public',
      handleUploadUrl: '/api/admin/blob-upload-token',
      clientPayload: JSON.stringify({ title, date }),
      headers: H,
      onUploadProgress: ({ percentage }) => {
        fill.style.width = percentage + '%';
        ptext.textContent = percentage < 100 ? `Uploading ${Math.round(percentage)}%` : 'Processing...';
      },
    });
    showRecMsg('Uploaded. Recording is now live.', 'ok');
    fileInput.value = '';
    document.getElementById('rec-file-name').textContent = '';
    titleInput.value = '';
    recLoaded = false;
    loadRecordings();
  } catch (e) {
    showRecMsg(e.message ?? 'Upload failed', 'err');
  } finally {
    btn.disabled = false; btn.textContent = 'Upload Recording';
    progress.style.display = 'none';
    fill.style.width = '0';
  }
}

async function deleteRecording(id, btn) {
  if (!confirm('Remove this recording?')) return;
  btn.textContent = '...'; btn.disabled = true;
  try {
    const r = await fetch('/api/admin/upload-recording', {
      method: 'DELETE',
      headers: H,
      body: JSON.stringify({ id }),
    }).then(r => r.json());
    if (r.ok) { recLoaded = false; loadRecordings(); }
    else { btn.textContent = 'Remove'; btn.disabled = false; }
  } catch {
    btn.textContent = 'Remove'; btn.disabled = false;
  }
}

function showRecMsg(msg, type) {
  const el = document.getElementById('rec-msg');
  if (!el) return;
  el.textContent = msg;
  el.style.display = 'block';
  el.style.color = type === 'ok' ? '#3ecf8e' : '#e05555';
  el.style.background = type === 'ok' ? 'rgba(62,207,142,0.08)' : 'rgba(224,85,85,0.08)';
  el.style.border = type === 'ok' ? '1px solid rgba(62,207,142,0.2)' : '1px solid rgba(224,85,85,0.2)';
  setTimeout(() => { el.style.display = 'none'; }, 4000);
}

window.uploadRecording = uploadRecording;
window.deleteRecording = deleteRecording;

// ── CT Leads ──
const EVENT_DATE = new Date('2026-10-10T00:00:00+02:00');

function ctFmt(iso) {
  if (!iso) return '';
  const d = new Date(iso);
  return d.toLocaleDateString('en-ZA', { day: 'numeric', month: 'short' });
}

function ctDaysSince(iso) {
  return Math.floor((Date.now() - new Date(iso).getTime()) / 86400000);
}

function ctTierBadge(tier) {
  const colors = { Hot: '#e05555', Warm: '#e08c2e', Cold: '#4a7a9b' };
  return `<span style="font-size:9px;letter-spacing:1.5px;text-transform:uppercase;color:${colors[tier]||'var(--silver-dim)'};border:1px solid ${colors[tier]||'var(--border)'};padding:2px 6px;">${tier}</span>`;
}

function ctStatusBadge(status) {
  const map = {
    New:          ['var(--silver-dim)', 'var(--border)'],
    Contacted:    ['#3ecf8e',           'rgba(62,207,142,0.3)'],
    'Timing Issue':['#e08c2e',          'rgba(224,140,46,0.3)'],
    'Link Sent':  ['#7cb9e8',           'rgba(124,185,232,0.3)'],
    Paid:         ['#3ecf8e',           'rgba(62,207,142,0.5)'],
    Declined:     ['#e05555',           'rgba(224,85,85,0.3)'],
    '2nd Touch':  ['#e08c2e',           'rgba(224,140,46,0.3)'],
  };
  const [c, b] = map[status] || ['var(--silver-dim)', 'var(--border)'];
  return `<span style="font-size:9px;letter-spacing:1px;text-transform:uppercase;color:${c};border:1px solid ${b};padding:2px 6px;">${esc(status)}</span>`;
}

function ctActionBadge(action) {
  const map = {
    contact:        ['#ffd97d', 'rgba(255,217,125,0.25)', 'First contact'],
    follow_up:      ['#7cb9e8', 'rgba(124,185,232,0.25)', 'Follow up'],
    switch_channel: ['#e08c2e', 'rgba(224,140,46,0.25)',  'Switch channel'],
  };
  if (!map[action]) return '';
  const [c, b, label] = map[action];
  return `<span style="font-size:9px;letter-spacing:1px;text-transform:uppercase;color:${c};border:1px solid ${b};padding:2px 6px;">${label}</span>`;
}

function ctLeadCard(lead) {
  const daysSince = lead.status === 'New' ? lead.daysSinceLead : lead.daysSinceChange;
  const overdueBadge = lead.overdue ? `<span style="font-size:9px;color:#e05555;letter-spacing:1px;text-transform:uppercase;border:1px solid rgba(224,85,85,0.4);padding:2px 6px;">Overdue</span>` : '';
  const daysLabel = daysSince > 0 ? `${daysSince}d ${lead.status === 'New' ? 'in' : 'since contact'}` : 'Today';
  const sub = [lead.email, lead.ticket, lead.business].filter(Boolean).map(esc).join(' · ');
  return `<div style="border:1px solid var(--border);padding:14px 16px;background:rgba(168,184,200,0.03);">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;">
      <div style="display:flex;flex-direction:column;gap:6px;">
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
          <span style="font-size:14px;color:var(--cream);">${esc(lead.name)}</span>
          ${ctTierBadge(lead.tier)}
          ${ctStatusBadge(lead.status)}
          ${lead.action !== 'none' ? ctActionBadge(lead.action) : ''}
          ${overdueBadge}
        </div>
        ${sub ? `<div style="font-size:12px;color:var(--silver-dim);">${sub}</div>` : ''}
      </div>
      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex-shrink:0;">
        <span style="font-size:11px;color:var(--silver-dim);">${daysLabel}</span>
      </div>
    </div>
  </div>`;
}

async function loadCTLeads() {
  const errEl         = document.getElementById('ctleads-err');
  const setupEl       = document.getElementById('ctleads-setup');
  const todaySec      = document.getElementById('ctleads-today-section');
  const switchSec     = document.getElementById('ctleads-switch-section');
  const communitySec  = document.getElementById('ctleads-community-section');
  const allList       = document.getElementById('ctleads-all-list');
  const todayList     = document.getElementById('ctleads-today-list');
  const switchList    = document.getElementById('ctleads-switch-list');
  const communityList = document.getElementById('ctleads-community-list');
  const todayCnt      = document.getElementById('ctleads-today-count');
  const totalCnt      = document.getElementById('ctleads-total-count');
  const communityCnt  = document.getElementById('ctleads-community-count');

  errEl.style.display = 'none';
  setupEl.style.display = 'none';
  allList.innerHTML = '<div style="font-size:12px;color:var(--silver-dim);padding:16px 0;">Loading...</div>';
  todaySec.style.display = 'none';
  switchSec.style.display = 'none';
  communitySec.style.display = 'none';

  try {
    const res  = await fetch('/api/admin/leads-slack', { headers: H });
    const data = await res.json();

    if (!res.ok) { errEl.textContent = data.error || 'Failed to load leads'; errEl.style.display = 'block'; allList.innerHTML = ''; return; }
    if (!data.configured) { setupEl.style.display = 'block'; allList.innerHTML = ''; return; }

    const leads = data.leads || [];
    if (!leads.length) { allList.innerHTML = '<div style="font-size:12px;color:var(--silver-dim);padding:16px 0;">No leads found in the last 45 days.</div>'; return; }

    const communityLeads = leads.filter(l => l.isCommunityLead);
    const eventLeads     = leads.filter(l => !l.isCommunityLead);
    const switchNeeded   = eventLeads.filter(l => l.action === 'switch_channel');
    const today          = eventLeads.filter(l => l.dueToday && l.action !== 'switch_channel');

    if (today.length) {
      todayList.innerHTML = today.map(l => ctLeadCard(l)).join('');
      todayCnt.textContent = today.length;
      todaySec.style.display = 'block';
    }

    if (switchNeeded.length) {
      switchList.innerHTML = switchNeeded.map(l => ctLeadCard(l)).join('');
      switchSec.style.display = 'block';
    }

    if (communityLeads.length) {
      communityList.innerHTML = communityLeads.map(l =>
        `<div style="border:1px solid rgba(124,185,232,0.2);padding:14px 16px;background:rgba(124,185,232,0.03);">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;">
            <div style="display:flex;flex-direction:column;gap:5px;">
              <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                <span style="font-size:14px;color:var(--cream);">${esc(l.name)}</span>
                <span style="font-size:9px;letter-spacing:1.5px;text-transform:uppercase;color:#7cb9e8;border:1px solid rgba(124,185,232,0.4);padding:2px 6px;">Community</span>
                ${ctStatusBadge(l.status)}
              </div>
              ${[l.email, l.business].filter(Boolean).map(esc).join(' · ') ? `<div style="font-size:12px;color:var(--silver-dim);">${[l.email, l.business].filter(Boolean).map(esc).join(' · ')}</div>` : ''}
            </div>
            <span style="font-size:11px;color:var(--silver-dim);flex-shrink:0;">${ctDaysSince(l.initialDate)}d ago</span>
          </div>
        </div>`
      ).join('');
      communityCnt.textContent = `${communityLeads.length}`;
      communitySec.style.display = 'block';
    }

    totalCnt.textContent = `${eventLeads.length} lead${eventLeads.length !== 1 ? 's' : ''}`;
    allList.innerHTML = eventLeads.length
      ? eventLeads.map(l => ctLeadCard(l)).join('')
      : '<div style="font-size:12px;color:var(--silver-dim);padding:16px 0;">No event leads.</div>';
  } catch (e) {
    errEl.textContent = e.message || 'Unexpected error';
    errEl.style.display = 'block';
    allList.innerHTML = '';
  }
}

window.loadCTLeads = loadCTLeads;

async function sendDailySummary() {
  const btn = document.getElementById('ctleads-send-btn');
  const msgEl = document.getElementById('ctleads-send-msg');
  btn.disabled = true; btn.textContent = 'Sending...';
  msgEl.style.display = 'none';
  try {
    const res  = await fetch('/api/admin/leads-daily-summary', { method: 'POST', headers: H });
    const data = await res.json();
    if (data.ok) {
      msgEl.textContent = 'Summary posted to Slack.';
      msgEl.style.color = '#3ecf8e';
      msgEl.style.background = 'rgba(62,207,142,0.08)';
      msgEl.style.border = '1px solid rgba(62,207,142,0.2)';
    } else {
      msgEl.textContent = data.error || 'Failed to send.';
      msgEl.style.color = '#e05555';
      msgEl.style.background = 'rgba(224,85,85,0.08)';
      msgEl.style.border = '1px solid rgba(224,85,85,0.2)';
    }
    msgEl.style.display = 'block';
    setTimeout(() => { msgEl.style.display = 'none'; }, 5000);
  } catch(e) {
    msgEl.textContent = e.message || 'Unexpected error';
    msgEl.style.color = '#e05555';
    msgEl.style.display = 'block';
  } finally {
    btn.disabled = false; btn.textContent = 'Send Now';
  }
}

window.sendDailySummary = sendDailySummary;
</script>

<script>
  import { upload as blobUpload } from '@vercel/blob/client';
  (window as any)._blobUpload = blobUpload;
</script>
</body>
</html>
