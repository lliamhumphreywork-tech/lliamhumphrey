<script type="module" is:inline>
import { initializeApp } from "https://www.gstatic.com/firebasejs/11.0.0/firebase-app.js";
import { getAuth, signInWithEmailAndPassword, signOut as fbSignOut, onAuthStateChanged }
  from "https://www.gstatic.com/firebasejs/11.0.0/firebase-auth.js";

const firebaseConfig = {
  apiKey: "AIzaSyClcxxc3RVCM5giPNF0fPw5Sv6HNmbYhzQ",
  authDomain: "pvc-workspace.firebaseapp.com",
  projectId: "pvc-workspace",
  storageBucket: "pvc-workspace.firebasestorage.app",
  messagingSenderId: "28852834979",
  appId: "1:28852834979:web:ccfe6e6e185d885b396516"
};

const app  = initializeApp(firebaseConfig);
const auth = getAuth(app);
const KEY  = document.getElementById('admin-data').dataset.key;
const H    = { 'Content-Type': 'application/json', 'x-admin-key': KEY };

// ── Auth state ──
onAuthStateChanged(auth, user => {
  document.getElementById('loading').classList.add('hidden');
  if (user) {
    document.getElementById('auth-screen').classList.remove('visible');
    document.getElementById('app').style.display = 'block';
    const name = user.email.split('@')[0];
    document.getElementById('nav-user').textContent = user.email;
    document.getElementById('dash-name').textContent = name.charAt(0).toUpperCase() + name.slice(1) + '.';
    loadLeads();
    loadOverviewRevenue();
  } else {
    document.getElementById('auth-screen').classList.add('visible');
    document.getElementById('app').style.display = 'none';
  }
});

document.getElementById('auth-btn').addEventListener('click', async () => {
  const email = document.getElementById('auth-email').value.trim();
  const pass  = document.getElementById('auth-pass').value;
  const btn   = document.getElementById('auth-btn');
  const err   = document.getElementById('auth-err');
  err.textContent = '';
  btn.disabled = true; btn.textContent = 'Signing in...';
  try {
    await signInWithEmailAndPassword(auth, email, pass);
  } catch(e) {
    err.textContent = e.code === 'auth/invalid-credential' ? 'Invalid email or password.' : 'Sign-in failed. Try again.';
    btn.disabled = false; btn.textContent = 'Sign In';
  }
});
document.getElementById('auth-pass').addEventListener('keydown', e => { if (e.key === 'Enter') document.getElementById('auth-btn').click(); });
document.getElementById('sign-out-btn').addEventListener('click', () => fbSignOut(auth));

// ── Tabs ──
document.querySelectorAll('.tab').forEach(tab => {
  tab.addEventListener('click', () => {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
    tab.classList.add('active');
    const panel = document.getElementById('tab-' + tab.dataset.tab);
    panel.classList.add('active');
    if (tab.dataset.tab === 'brevo') loadBrevoLeads();
  if (tab.dataset.tab === 'revenue') { revenueLoaded = false; loadRevenue(); }
  });
});

// ── Copy links ──
document.querySelectorAll('.copy-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const url = btn.closest('.link-row').dataset.url;
    navigator.clipboard.writeText(url).then(() => {
      const orig = btn.textContent;
      btn.textContent = 'Copied'; btn.classList.add('copied');
      setTimeout(() => { btn.textContent = orig; btn.classList.remove('copied'); }, 2000);
    });
  });
});

// ── Pipeline ──
let allLeads = [], activeFilter = '', activeType = '', activeRevenue = '';

async function loadLeads() {
  try {
    const res  = await fetch(`/api/admin/applicants?key=${encodeURIComponent(KEY)}`);
    if (res.status === 401) return;
    allLeads = (await res.json()).filter(l => l.status !== 'Membership Activated');
    renderLeads();
    renderDashboard();
  } catch {
    document.getElementById('lead-list').innerHTML = '<div class="loading" style="color:#c94a5c">Failed to load</div>';
  }
}

function statusClass(s) {
  if (!s) return 's-applied';
  if (['Member','Founding Member','Membership Activated'].includes(s)) return 's-member';
  if (['Approved - Call Email Sent','Call Booked'].includes(s)) return 's-called';
  if (['Qualified','Payment Link Sent'].includes(s)) return 's-qualified';
  if (['Pending Review','Reviewing'].includes(s)) return 's-pending';
  return 's-applied';
}

function statusLabel(s) {
  if (!s) return 'Applied';
  return { 'Approved - Call Email Sent': 'Call Email Sent', 'Founding Member': 'Founding', 'Membership Activated': 'Member', 'Discovery Call Booked': 'Call Booked' }[s] || s;
}

function renderLeads() {
  let f = activeFilter ? allLeads.filter(l => l.status === activeFilter) : allLeads;
  if (activeType)    f = f.filter(l => (l.type || []).includes(activeType));
  if (activeRevenue) f = f.filter(l => l.r === activeRevenue);
  document.getElementById('lead-count').textContent = f.length + ' leads';
  if (!f.length) { document.getElementById('lead-list').innerHTML = '<div class="loading">No leads in this stage</div>'; return; }
  document.getElementById('lead-list').innerHTML = f.map((lead, i) => {
    const email = lead.e || '', fn = (lead.n || '').split(' ')[0];
    const initials = (lead.n || '?').split(' ').map(w => w[0]).join('').slice(0,2).toUpperCase();
    const tierHtml  = lead.t ? `<span class="tier-badge tier-${esc(lead.t)}">${esc(lead.t)}</span>` : '';
    const tagsHtml  = (lead.type || []).map(t => `<span class="expand-tag">${esc(t)}</span>`).join('');
    const goalsHtml = lead.w ? `<div class="expand-goals"><div class="expand-goals-label">Goals</div>${esc(lead.w)}</div>` : '';
    const scoreHtml = lead.s != null ? `<span class="expand-tier">${tierHtml} Score ${lead.s}/10</span>` : '';
    return `<div class="lead-card" style="animation-delay:${Math.min(i*40,600)}ms" data-page-id="${esc(lead.id||'')}" data-email="${esc(email)}" data-firstname="${esc(fn)}">
      <div class="lead-row">
        <div class="lead-initials">${initials}</div>
        <div class="lead-body">
          <div class="lead-name">${esc(lead.n||'—')}</div>
          <div class="lead-biz">${esc(lead.b||'—')}</div>
          <div class="lead-meta">
            <span class="lead-status ${statusClass(lead.status)}">${statusLabel(lead.status)}</span>
            ${lead.r ? `<div class="lead-sep"></div><span class="lead-revenue">${esc(lead.r)}</span>` : ''}
          </div>
        </div>
        <svg class="lead-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><polyline points="4,6 8,10 12,6"/></svg>
      </div>
      <div class="lead-expand">
        <div class="expand-grid">
          <div class="expand-field"><span class="expand-label">Email</span><span class="expand-val">${email?`<a href="mailto:${esc(email)}">${esc(email)}</a>`:'<em class="empty">—</em>'}</span></div>
          <div class="expand-field"><span class="expand-label">Phone</span><span class="expand-val">${lead.p?`<a href="tel:${esc(lead.p)}">${esc(lead.p)}</a>`:'<em class="empty">—</em>'}</span></div>
          <div class="expand-field"><span class="expand-label">Instagram</span><span class="expand-val">${lead.i?esc(lead.i):'<em class="empty">—</em>'}</span></div>
          <div class="expand-field"><span class="expand-label">Revenue</span><span class="expand-val">${lead.r?esc(lead.r):'<em class="empty">—</em>'}</span></div>
          <div class="expand-field"><span class="expand-label">Status</span><span class="expand-val">${esc(lead.status||'Applied')}</span></div>
          <div class="expand-field"><span class="expand-label">Score</span><span class="expand-val">${scoreHtml||'<em class="empty">—</em>'}</span></div>
          <div class="expand-field"><span class="expand-label">Source</span><span class="expand-val">${lead.src?esc(lead.src):'<em class="empty">—</em>'}</span></div>
        </div>
        ${goalsHtml}
        ${tagsHtml?`<div class="expand-tags">${tagsHtml}</div>`:''}
        <div class="expand-footer">
          <div class="expand-action-row">
            ${email?`<button class="expand-act send-call-btn">Send Call Email</button>`:''}
            ${email?`<button class="expand-act secondary log-btn">Log Interaction</button>`:''}
          </div>
          ${scoreHtml}
        </div>
        <div class="timeline"><div class="timeline-label">Touchpoints</div><div class="timeline-list"><div class="timeline-loading">Loading...</div></div></div>
      </div>
    </div>`;
  }).join('');

  document.querySelectorAll('.lead-card').forEach(card => {
    card.querySelector('.lead-row').addEventListener('click', e => {
      if (e.target.closest('.expand-act')) return;
      card.classList.toggle('expanded');
      if (card.classList.contains('expanded')) loadTimeline(card);
    });
    card.querySelector('.send-call-btn')?.addEventListener('click', e => { e.stopPropagation(); prefillCall(card.dataset.firstname, card.dataset.email); });
    card.querySelector('.log-btn')?.addEventListener('click', e => { e.stopPropagation(); prefillLog(card.dataset.email); });
  });
}

function renderDashboard() {
  const stages = [
    { label: 'Pending Review',    key: 'Pending Review' },
    { label: 'Call Email Sent',   key: 'Approved - Call Email Sent' },
    { label: 'Call Booked',       key: 'Call Booked' },
    { label: 'Qualified',         key: 'Qualified' },
    { label: 'Payment Link Sent', key: 'Payment Link Sent' },
    { label: 'Member',            key: 'Member' },
    { label: 'Founding Member',   key: 'Founding Member' },
    { label: 'Not a Fit',         key: 'Not a Fit' },
  ];
  document.getElementById('dash-total').textContent     = allLeads.length;
  document.getElementById('dash-pending').textContent   = allLeads.filter(l => l.status === 'Pending Review').length;
  document.getElementById('dash-qualified').textContent = allLeads.filter(l => ['Qualified','Payment Link Sent'].includes(l.status)).length;
  document.getElementById('dash-members').textContent   = allLeads.filter(l => ['Member','Founding Member','Membership Activated'].includes(l.status)).length;

  const counts  = stages.map(s => allLeads.filter(l => l.status === s.key).length);
  const maxCount = Math.max(...counts, 1);
  document.getElementById('dash-funnel-rows').innerHTML = stages.map((s, i) => {
    const pct = Math.round((counts[i] / maxCount) * 100);
    return `<div class="funnel-row">
      <div class="funnel-label">${s.label}</div>
      <div class="funnel-bar-wrap"><div class="funnel-bar-fill" style="width:0%" data-pct="${pct}"></div></div>
      <div class="funnel-count">${counts[i]}</div>
    </div>`;
  }).join('');
  // Animate bars after render
  requestAnimationFrame(() => requestAnimationFrame(() => {
    document.querySelectorAll('.funnel-bar-fill').forEach(el => {
      el.style.width = el.dataset.pct + '%';
    });
  }));
}

async function loadTimeline(card) {
  const list = card.querySelector('.timeline-list');
  if (!list || list.dataset.loaded) return;
  list.dataset.loaded = '1';
  const pageId = card.dataset.pageId;
  if (!pageId) { list.innerHTML = '<div class="timeline-empty">No page ID</div>'; return; }
  try {
    const entries = await fetch(`/api/admin/interactions?key=${encodeURIComponent(KEY)}&pageId=${encodeURIComponent(pageId)}`).then(r => r.json());
    if (!entries.length) { list.innerHTML = '<div class="timeline-empty">No touchpoints recorded yet</div>'; return; }
    list.innerHTML = entries.map(entry => {
      const parts = entry.text.split(' · ');
      const date = parts[0] || '', rest = parts.slice(1).join(' · ');
      const type = rest.split(':')[0]?.toLowerCase() || '';
      const dot  = type.includes('email') ? 'email' : type.includes('call') ? 'call' : type.includes('dm') || type.includes('ig') ? 'dm' : type.includes('whatsapp') ? 'whatsapp' : '';
      return `<div class="timeline-entry"><div class="timeline-dot ${dot}"></div><div class="timeline-text"><div>${esc(rest||entry.text)}</div>${date?`<div class="timeline-date">${esc(date)}</div>`:''}</div></div>`;
    }).join('');
  } catch { list.innerHTML = '<div class="timeline-empty">Failed to load</div>'; }
}

['filters','type-filters','revenue-filters'].forEach(id => {
  document.getElementById(id).addEventListener('click', e => {
    const btn = e.target.closest('.filter-btn');
    if (!btn) return;
    document.querySelectorAll(`#${id} .filter-btn`).forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    if (id === 'filters')         activeFilter  = btn.dataset.status;
    else if (id === 'type-filters')   activeType    = btn.dataset.type;
    else                              activeRevenue = btn.dataset.revenue;
    renderLeads();
  });
});

function prefillCall(name, email) { document.querySelector('[data-tab="actions"]').click(); document.getElementById('call-name').value = name; document.getElementById('call-email').value = email; }
function prefillLog(email)         { document.querySelector('[data-tab="actions"]').click(); document.getElementById('log-email').value  = email; }
function esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }

// ── Call Email ──
document.getElementById('call-form').addEventListener('submit', async e => {
  e.preventDefault();
  const firstName = document.getElementById('call-name').value.trim();
  const email     = document.getElementById('call-email').value.trim();
  if (!firstName || !email) { setMsg('call-msg', 'Name and email required', true); return; }
  const btn = e.target.querySelector('button');
  btn.disabled = true; btn.textContent = 'Sending...';
  try {
    const res = await fetch('/api/send-call-email', { method: 'POST', headers: H, body: JSON.stringify({ email, firstName }) });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    setMsg('call-msg', `Sent to ${email}`, false); e.target.reset(); setTimeout(loadLeads, 2000);
  } catch(err) { setMsg('call-msg', err.message, true); }
  finally { btn.disabled = false; btn.textContent = 'Send + Update CRM'; }
});

// ── Log Interaction ──
document.getElementById('log-form').addEventListener('submit', async e => {
  e.preventDefault();
  const email = document.getElementById('log-email').value.trim();
  const note  = document.getElementById('log-note').value.trim();
  if (!email || !note) { setMsg('log-msg', 'Email and note required', true); return; }
  const btn = e.target.querySelector('button');
  btn.disabled = true; btn.textContent = 'Logging...';
  try {
    const body = { email, type: document.getElementById('log-type').value, note, status: document.getElementById('log-status').value || undefined };
    const res  = await fetch('/api/log-interaction', { method: 'POST', headers: H, body: JSON.stringify(body) });
    if (res.status === 404) { setMsg('log-msg', 'Contact not found', true); return; }
    if (!res.ok) throw new Error('HTTP ' + res.status);
    setMsg('log-msg', 'Logged', false); e.target.reset(); setTimeout(loadLeads, 1500);
  } catch(err) { setMsg('log-msg', err.message, true); }
  finally { btn.disabled = false; btn.textContent = 'Log Interaction'; }
});

// ── Add Lead ──
document.getElementById('add-form').addEventListener('submit', async e => {
  e.preventDefault();
  const name = document.getElementById('add-name').value.trim();
  if (!name) { setMsg('add-msg', 'Name is required', true); return; }
  const btn = e.target.querySelector('button');
  btn.disabled = true; btn.textContent = 'Adding...';
  try {
    const res = await fetch(`/api/admin/add?key=${encodeURIComponent(KEY)}`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, email: document.getElementById('add-email').value.trim(), phone: document.getElementById('add-phone').value.trim(), insta: document.getElementById('add-insta').value.trim(), biz: document.getElementById('add-biz').value.trim(), interaction: document.getElementById('add-interaction').value, type: document.getElementById('add-type').value, notes: document.getElementById('add-notes').value.trim() }),
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    setMsg('add-msg', 'Added to CRM', false); e.target.reset(); setTimeout(loadLeads, 1500);
  } catch(err) { setMsg('add-msg', err.message, true); }
  finally { btn.disabled = false; btn.textContent = 'Add to CRM'; }
});

// ── Brevo Activity ──
let brevoLoaded = false;
async function loadBrevoLeads() {
  if (brevoLoaded && !document.getElementById('brevo-list').querySelector('.brevo-empty')) return;
  brevoLoaded = true;
  try {
    const res  = await fetch(`/api/admin/brevo-leads?key=${encodeURIComponent(KEY)}`);
    const data = await res.json();
    const contacts = data.contacts ?? [];
    if (data.error) {
      const msg = data.error.includes('429') ? 'Brevo rate limit hit — try again in a few minutes.' : `Error: ${data.error}`;
      document.getElementById('brevo-list').innerHTML = `<div class="brevo-empty">${msg}</div>`;
      return;
    }
    document.getElementById('brevo-count').textContent = contacts.length + ' contacts';
    const evCount = data.eventCount ?? 0;
    document.getElementById('brevo-meta').innerHTML = `From <strong>${evCount} tracked events</strong> across all emails. Ranked by opens + clicks.`;
    if (!contacts.length) { document.getElementById('brevo-list').innerHTML = '<div class="brevo-empty">No engagement data yet</div>'; return; }
    const maxScore = contacts[0].opens + contacts[0].clicks * 2;
    document.getElementById('brevo-list').innerHTML = contacts.map((c, i) => {
      const score = c.opens + c.clicks * 2;
      const pct   = maxScore > 0 ? Math.round((score / maxScore) * 100) : 0;
      return `<div class="brevo-lead" style="animation-delay:${Math.min(i*30,600)}ms">
        <div class="brevo-rank">${i + 1}</div>
        <div class="brevo-info"><div class="brevo-email">${esc(c.email)}</div></div>
        <div class="brevo-bar-wrap"><div class="brevo-bar"><div class="brevo-bar-fill" style="width:0%" data-pct="${pct}"></div></div></div>
        <div class="brevo-stats">
          <div class="brevo-stat"><div class="brevo-stat-val">${c.opens}</div><div class="brevo-stat-label">Opens</div></div>
          <div class="brevo-stat"><div class="brevo-stat-val">${c.clicks}</div><div class="brevo-stat-label">Clicks</div></div>
        </div>
      </div>`;
    }).join('');
    requestAnimationFrame(() => requestAnimationFrame(() => {
      document.querySelectorAll('.brevo-bar-fill').forEach(el => { el.style.width = el.dataset.pct + '%'; });
    }));
  } catch { document.getElementById('brevo-list').innerHTML = '<div class="brevo-empty">Failed to load</div>'; }
}

// ── Overview Revenue ──
async function loadOverviewRevenue() {
  try {
    const res  = await fetch(`/api/admin/revenue?key=${encodeURIComponent(KEY)}`);
    const data = await res.json();
    const fmt  = n => 'R' + Math.round(n).toLocaleString('en-ZA');
    const now  = new Date();
    const monthLabel = now.toLocaleString('en', { month: 'long' });

    document.getElementById('dash-rev-total').textContent     = fmt(data.total);
    document.getElementById('dash-rev-total-sub').textContent = data.count + ' payments';
    document.getElementById('dash-rev-month').textContent     = fmt(data.thisMonth);
    document.getElementById('dash-rev-month-sub').textContent = monthLabel;
    document.getElementById('dash-rev-mem').textContent       = fmt(data.byCategory['Membership'] ?? 0);
    document.getElementById('dash-rev-evt').textContent       = fmt(data.byCategory['Event'] ?? 0);

    const recent = data.recent.slice(0, 8);
    document.getElementById('dash-recent-payments').innerHTML = recent.length
      ? recent.map(p => `<div style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border:1px solid var(--border);background:var(--navy);gap:16px;">
          <div style="min-width:0;">
            <div style="font-size:13px;color:var(--white);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(p.name || p.email)}</div>
            <div style="font-size:10px;color:var(--silver-dim);margin-top:2px;letter-spacing:0.5px;">${esc(p.item)}</div>
          </div>
          <div style="font-family:var(--g);font-size:15px;font-weight:700;color:var(--silver);white-space:nowrap;font-variant-numeric:tabular-nums;">R${Math.round(p.amount).toLocaleString('en-ZA')}</div>
        </div>`).join('')
      : '<div style="font-size:12px;color:var(--silver-dim);">No payments yet</div>';
  } catch(e) {
    document.getElementById('dash-rev-total').textContent = 'Error';
  }
}

// ── Revenue Tab ──
let revenueLoaded = false;
async function loadRevenue() {
  if (revenueLoaded) return;
  revenueLoaded = true;
  try {
    const res  = await fetch(`/api/admin/revenue?key=${encodeURIComponent(KEY)}`);
    const data = await res.json();
    const fmt  = n => 'R' + Math.round(n).toLocaleString('en-ZA');
    const now  = new Date();
    const monthLabel = now.toLocaleString('en', { month: 'long', year: 'numeric' });

    document.getElementById('rev-total').textContent      = fmt(data.total);
    document.getElementById('rev-month').textContent      = fmt(data.thisMonth);
    document.getElementById('rev-month-label').textContent = monthLabel;
    document.getElementById('rev-membership').textContent = fmt(data.byCategory['Membership'] ?? 0);
    document.getElementById('rev-event').textContent      = fmt(data.byCategory['Event'] ?? 0);
    document.getElementById('rev-count').textContent      = data.count + ' payments';

    const maxItem = Math.max(...Object.values(data.byItem).map(v => v.amount), 1);
    document.getElementById('rev-by-item').innerHTML = Object.entries(data.byItem)
      .sort((a, b) => b[1].amount - a[1].amount)
      .map(([item, v]) => {
        const pct = Math.round((v.amount / maxItem) * 100);
        return `<div class="funnel-row">
          <div class="funnel-label" style="width:220px;font-size:12px;">${esc(item)}</div>
          <div class="funnel-bar-wrap"><div class="funnel-bar-fill" style="width:0%" data-pct="${pct}"></div></div>
          <div class="funnel-count" style="width:80px;text-align:right;font-size:12px;">${fmt(v.amount)}</div>
          <div style="width:36px;text-align:right;font-size:10px;color:var(--silver-dim);margin-left:8px;">${v.count}x</div>
        </div>`;
      }).join('');
    requestAnimationFrame(() => requestAnimationFrame(() => {
      document.querySelectorAll('#rev-by-item .funnel-bar-fill').forEach(el => { el.style.width = el.dataset.pct + '%'; });
    }));

    document.getElementById('rev-recent').innerHTML = data.recent.length
      ? data.recent.map(p => `<div class="brevo-lead" style="animation-delay:0ms">
          <div class="brevo-info">
            <div class="brevo-email">${esc(p.name || p.email)}</div>
            <div style="font-size:11px;color:var(--silver-dim);margin-top:2px;">${esc(p.item)} · ${esc(p.date)}</div>
          </div>
          <div style="font-family:var(--g);font-size:18px;font-weight:700;color:var(--white);font-variant-numeric:tabular-nums;">R${Math.round(p.amount).toLocaleString('en-ZA')}</div>
        </div>`).join('')
      : '<div class="brevo-empty">No payments yet</div>';
  } catch(e) {
    document.getElementById('rev-recent').innerHTML = '<div class="brevo-empty">Failed to load</div>';
  }
}

function setMsg(id, text, isErr) {
  const el = document.getElementById(id);
  el.textContent = text.toUpperCase(); el.className = 'msg ' + (isErr ? 'err' : 'ok');
  setTimeout(() => { el.textContent = ''; el.className = 'msg'; }, 4000);
}
</script>
</body>
</html>
