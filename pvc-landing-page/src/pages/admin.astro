// ── Revenue ──
function loadRevenue() {
  var el = document.getElementById('tab-revenue');
  api('/api/admin/revenue').then(function(data) {
    appData.revenue = data;
    renderRevenue(data);
  }).catch(function(e) {
    el.innerHTML = '<div class="empty-state"><p>' + esc(e.message) + '</p></div>';
  });
}

function renderRevenue(data) {
  var el = document.getElementById('tab-revenue');

  var catMax = Math.max(1, Math.max.apply(null, Object.values(data.byCategory || {1:1})));
  var catHTML = Object.entries(data.byCategory || {}).sort(function(a,b) { return b[1]-a[1]; }).map(function(kv) {
    var w = Math.round((kv[1] / catMax) * 100);
    return '<div class="bar-row"><div class="bar-label">' + esc(kv[0]) + '</div><div class="bar-track"><div class="bar-fill" style="width:' + w + '%"></div></div><div class="bar-count">' + fmt(kv[1]) + '</div></div>';
  }).join('');

  var itemRows = Object.entries(data.byItem || {}).sort(function(a,b) { return b[1].amount - a[1].amount; }).map(function(kv) {
    return '<tr><td class="td-name">' + esc(kv[0]) + '</td><td style="font-weight:600;color:var(--navy)">' + fmt(kv[1].amount) + '</td><td class="td-muted">' + kv[1].count + ' payments</td></tr>';
  }).join('');

  var recentHTML = (data.recent || []).map(function(p) {
    return '<tr><td class="td-name">' + esc(p.name) + '</td><td class="td-muted">' + esc(p.item || p.category) + '</td><td style="font-weight:600;color:var(--navy)">' + fmt(p.amount) + '</td><td class="td-muted">' + esc(p.date) + '</td></tr>';
  }).join('');

  el.innerHTML =
    '<div class="page-title">Revenue</div>' +
    '<div class="page-sub">Pulled from Notion Finance DB + Whop</div>' +
    '<div class="stat-grid">' +
      statCard('Total Revenue', fmt(data.total || 0), 'All sources') +
      statCard('Notion Total', fmt(data.notionTotal || 0), 'Finance DB') +
      statCard('Whop Total', fmt(data.whopTotal || 0), 'Memberships') +
      statCard('This Month', fmt(data.thisMonth || 0), 'Current month') +
      statCard('Total Payments', data.count || 0, 'Transactions') +
    '</div>' +
    '<div class="two-col">' +
      '<div class="card">' +
        '<div class="card-title">Revenue by Category</div>' +
        '<div class="bar-chart">' + (catHTML || '<p class="td-muted">No data</p>') + '</div>' +
      '</div>' +
      '<div class="card">' +
        '<div class="card-title">Revenue by Item</div>' +
        '<div class="table-wrap"><table><thead><tr><th>Item</th><th>Total</th><th>Payments</th></tr></thead><tbody>' + (itemRows || '<tr><td colspan="3" class="td-muted">No data</td></tr>') + '</tbody></table></div>' +
      '</div>' +
    '</div>' +
    '<div class="card">' +
      '<div class="card-title">Recent Transactions</div>' +
      '<div class="table-wrap"><table><thead><tr><th>Name</th><th>Item</th><th>Amount</th><th>Date</th></tr></thead><tbody>' + (recentHTML || '<tr><td colspan="4" class="td-muted">No data</td></tr>') + '</tbody></table></div>' +
    '</div>';
}

// ── Inline edit helpers ──
// After any write, bust the cache for every tab that shows lead data
// so the next visit to those tabs fetches fresh data from Notion.
function invalidateLeadData() {
  loaded.overview     = false;
  loaded.applications = false;
  loaded.crm          = false;
  loaded.members      = false;
  loaded.revenue      = false;
  // If overview is currently visible, reload it right away
  var activePanel = document.querySelector('.tab-panel.active');
  if (activePanel && activePanel.id === 'tab-overview') {
    loaded.overview = true;
    loadOverview();
  }
}

function updateStatus(sel) {
  var pageId = sel.dataset.page;
  var val    = sel.value;
  patchAPI(pageId, { status: val }).then(function() {
    toast('Status updated');
    invalidateLeadData();
  }).catch(function(e) {
    toast('Failed: ' + e.message, true);
  });
}

function editNotes(el, pageId) {
  var current = el.textContent.trim();
  var inp = document.createElement('input');
  inp.type = 'text';
  inp.className = 'edit-input';
  inp.value = current === '—' ? '' : current;
  inp.style.width = '200px';
  el.parentNode.replaceChild(inp, el);
  inp.focus();

  function save() {
    var val = inp.value.trim();
    patchAPI(pageId, { notes: val }).then(function() {
      toast('Notes saved');
      var span = document.createElement('span');
      span.className = 'editable';
      span.setAttribute('onclick', 'editNotes(this, \'' + pageId + '\')');
      span.innerHTML = val || '<span style="color:#9ca3af">—</span>';
      inp.parentNode.replaceChild(span, inp);
    }).catch(function(e) {
      toast('Failed: ' + e.message, true);
      var span = document.createElement('span');
      span.className = 'editable';
      span.setAttribute('onclick', 'editNotes(this, \'' + pageId + '\')');
      span.innerHTML = esc(current) || '<span style="color:#9ca3af">—</span>';
      inp.parentNode.replaceChild(span, inp);
    });
  }

  inp.addEventListener('blur', save);
  inp.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') { e.preventDefault(); inp.blur(); }
    if (e.key === 'Escape') {
      var span = document.createElement('span');
      span.className = 'editable';
      span.setAttribute('onclick', 'editNotes(this, \'' + pageId + '\')');
      span.innerHTML = esc(current) || '<span style="color:#9ca3af">—</span>';
      inp.removeEventListener('blur', save);
      inp.parentNode.replaceChild(span, inp);
    }
  });
}

// ── Drawer ──
document.getElementById('drawer-overlay').addEventListener('click', closeDrawer);
document.getElementById('drawer-close-btn').addEventListener('click', closeDrawer);

function openDrawer(name, bodyHTML) {
  document.getElementById('drawer-name').textContent = name;
  document.getElementById('drawer-body').innerHTML = bodyHTML;
  document.getElementById('drawer').classList.add('open');
  document.getElementById('drawer-overlay').classList.add('open');
}

function closeDrawer() {
  document.getElementById('drawer').classList.remove('open');
  document.getElementById('drawer-overlay').classList.remove('open');
}

function dField(label, value) {
  if (value === null || value === undefined || value === '') return '';
  return '<div class="d-field"><div class="d-label">' + label + '</div><div class="d-value">' + value + '</div></div>';
}

