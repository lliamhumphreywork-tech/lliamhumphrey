---
export const prerender = false;
const ADMIN_KEY = import.meta.env.ADMIN_KEY ?? '';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PVC — Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --black:        #08111f;
      --navy:         #0a1628;
      --navy-mid:     #0d1e35;
      --surface:      #0f1f38;
      --border:       rgba(168,184,200,0.1);
      --border-mid:   rgba(168,184,200,0.18);
      --border-bright:rgba(168,184,200,0.35);
      --silver:       #a8b8c8;
      --silver-dim:   #4a5a6a;
      --silver-light: #dde4ec;
      --white:        #f4f5f6;
      --cream:        #ece6da;
      --green:        #52b788;
      --red:          #c94a5c;
      --blue:         #3a7bd5;
      --amber:        #d4a017;
      --g: 'Syne', sans-serif;
      --s: 'DM Sans', sans-serif;
    }

    html { -webkit-font-smoothing: antialiased; }
    body { background: var(--black); color: var(--white); font-family: var(--s); font-size: 14px; min-height: 100vh; }

    /* ── LOADING ── */
    #loading {
      position: fixed; inset: 0; background: var(--black);
      display: flex; align-items: center; justify-content: center;
      z-index: 1000; transition: opacity 0.4s ease;
    }
    #loading.hidden { opacity: 0; pointer-events: none; }
    .loading-mark {
      width: 32px; height: 32px; border: 1px solid var(--silver);
      position: relative; animation: markpulse 2s ease-in-out infinite;
    }
    .loading-mark::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--silver); }
    @keyframes markpulse { 0%,100% { opacity: 0.3; } 50% { opacity: 1; } }

    /* ── AUTH ── */
    #auth-screen { display: none; min-height: 100vh; align-items: center; justify-content: center; }
    #auth-screen.visible { display: flex; }
    .auth-wrap { width: 100%; max-width: 420px; padding: 24px; }
    .auth-box {
      display: flex; flex-direction: column; gap: 32px;
      padding: 56px 48px; border: 1px solid var(--border);
      background: var(--navy);
      animation: authFadeUp 0.6s cubic-bezier(0.16,1,0.3,1) both;
    }
    @keyframes authFadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    .auth-mark { display: flex; align-items: center; gap: 12px; margin-bottom: 4px; }
    .auth-mark-icon { width: 28px; height: 28px; border: 1px solid var(--silver); position: relative; flex-shrink: 0; }
    .auth-mark-icon::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--silver); }
    .auth-mark-text { font-family: var(--g); font-size: 10px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: var(--silver-dim); }
    .auth-title { font-family: var(--g); font-size: 28px; font-weight: 700; color: var(--white); letter-spacing: -0.01em; }
    .auth-sub { font-size: 13px; color: var(--silver-dim); line-height: 1.6; }
    .auth-fields { display: flex; flex-direction: column; gap: 20px; }
    .auth-field { display: flex; flex-direction: column; gap: 8px; }
    .auth-field label { font-family: var(--g); font-size: 9px; letter-spacing: 3px; text-transform: uppercase; color: var(--silver-dim); font-weight: 600; }
    .auth-field input {
      border: none; border-bottom: 1px solid var(--border-mid);
      padding: 12px 0; font-size: 15px; background: transparent;
      color: var(--white); font-family: var(--s); outline: none;
      transition: border-color 0.2s; width: 100%; -webkit-appearance: none; border-radius: 0;
    }
    .auth-field input:focus { border-bottom-color: var(--silver); }
    .auth-field input::placeholder { color: var(--silver-dim); }
    .auth-btn {
      padding: 17px; background: var(--silver); color: var(--black);
      font-family: var(--g); font-size: 10px; font-weight: 700; letter-spacing: 3px;
      text-transform: uppercase; border: none; cursor: pointer;
      transition: background 0.2s, transform 0.15s;
    }
    .auth-btn:hover:not(:disabled) { background: var(--silver-light); transform: translateY(-1px); }
    .auth-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }
    .auth-err { font-size: 12px; color: var(--red); min-height: 16px; }
    .auth-footer { font-size: 10px; color: var(--silver-dim); text-align: center; letter-spacing: 1px; padding-top: 20px; border-top: 1px solid var(--border); }

    /* ── ADMIN APP ── */
    #admin-app { display: none; flex-direction: column; min-height: 100vh; }
    #admin-app.visible { display: flex; }

    /* ── HEADER ── */
    .app-header {
      background: var(--navy); border-bottom: 1px solid var(--border);
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: stretch; gap: 0;
    }
    .app-logo {
      display: flex; align-items: center; gap: 10px;
      padding: 0 24px; border-right: 1px solid var(--border);
      font-family: var(--g); font-size: 13px; font-weight: 700;
      letter-spacing: 2px; text-transform: uppercase; flex-shrink: 0;
      min-height: 52px;
    }
    .app-logo .mark { width: 20px; height: 20px; border: 1px solid var(--silver); position: relative; flex-shrink: 0; }
    .app-logo .mark::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--silver); }
    .app-logo span { color: var(--silver-dim); }
    .tab-nav {
      display: flex; align-items: stretch; overflow-x: auto; flex: 1;
      scrollbar-width: none;
    }
    .tab-nav::-webkit-scrollbar { display: none; }
    .tab-btn {
      padding: 0 20px; font-family: var(--g); font-size: 10px; font-weight: 600;
      letter-spacing: 2px; text-transform: uppercase; color: var(--silver-dim);
      background: transparent; border: none; border-bottom: 2px solid transparent;
      cursor: pointer; white-space: nowrap; transition: color 0.15s, border-color 0.15s;
      min-height: 52px;
    }
    .tab-btn:hover { color: var(--silver); }
    .tab-btn.active { color: var(--white); border-bottom-color: var(--white); }
    .header-end {
      display: flex; align-items: center; padding: 0 20px;
      border-left: 1px solid var(--border); flex-shrink: 0;
    }
    .signout-btn {
      font-family: var(--g); font-size: 9px; font-weight: 600;
      letter-spacing: 2px; text-transform: uppercase; color: var(--silver-dim);
      background: transparent; border: none; cursor: pointer;
      transition: color 0.15s;
    }
    .signout-btn:hover { color: var(--red); }

    /* ── CONTENT ── */
    .tab-content { flex: 1; background: #f0f2f5; }
    .tab-panel { display: none; padding: 28px; }
    .tab-panel.active { display: block; }

    /* ── PAGE HEADER ── */
    .page-title {
      font-family: var(--g); font-size: 22px; font-weight: 700;
      color: var(--navy); letter-spacing: -0.02em; margin-bottom: 6px;
    }
    .page-sub { font-size: 13px; color: #6b7280; margin-bottom: 24px; }

    /* ── CARDS ── */
    .card {
      background: #fff; border-radius: 8px;
      border: 1px solid #e5e7eb; padding: 24px;
    }
    .card-title {
      font-family: var(--g); font-size: 11px; font-weight: 700;
      letter-spacing: 2px; text-transform: uppercase; color: #6b7280;
      margin-bottom: 16px;
    }

    /* ── STAT GRID ── */
    .stat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .stat-card {
      background: #fff; border-radius: 8px; border: 1px solid #e5e7eb;
      padding: 20px 24px;
    }
    .stat-label { font-family: var(--g); font-size: 10px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: #6b7280; margin-bottom: 8px; }
    .stat-value { font-family: var(--g); font-size: 28px; font-weight: 700; color: var(--navy); letter-spacing: -0.02em; }
    .stat-sub { font-size: 12px; color: #9ca3af; margin-top: 4px; }
    .stat-positive { color: var(--green); }
    .stat-negative { color: var(--red); }

    /* ── GRID LAYOUTS ── */
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; }
    .three-col { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-bottom: 24px; }
    @media (max-width: 900px) { .two-col, .three-col { grid-template-columns: 1fr; } }

    /* ── TABLE ── */
    .table-wrap { overflow-x: auto; border-radius: 8px; border: 1px solid #e5e7eb; }
    table { width: 100%; border-collapse: collapse; background: #fff; font-size: 13px; }
    thead th {
      background: var(--navy); color: var(--silver-light);
      font-family: var(--g); font-size: 9px; font-weight: 700;
      letter-spacing: 2px; text-transform: uppercase;
      padding: 12px 16px; text-align: left; white-space: nowrap;
    }
    tbody tr { border-bottom: 1px solid #f3f4f6; }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: #f9fafb; }
    tbody td { padding: 12px 16px; color: #111827; vertical-align: top; }
    .td-name { font-weight: 600; color: var(--navy); }
    .td-muted { color: #6b7280; }

    /* ── BADGES ── */
    .badge {
      display: inline-block; padding: 2px 8px; border-radius: 4px;
      font-family: var(--g); font-size: 9px; font-weight: 700;
      letter-spacing: 1.5px; text-transform: uppercase;
    }
    .badge-hot { background: #fef2f2; color: #b91c1c; }
    .badge-warm { background: #fffbeb; color: #92400e; }
    .badge-cold { background: #f9fafb; color: #6b7280; }
    .badge-green { background: #f0fdf4; color: #166534; }
    .badge-blue { background: #eff6ff; color: #1d4ed8; }
    .badge-navy { background: #eff6ff; color: var(--navy); }
    .badge-applied { background: #eff6ff; color: #1d4ed8; }
    .badge-invited { background: #f0fdf4; color: #166534; }
    .badge-confirmed { background: #f0fdf4; color: #166534; }
    .badge-paid { background: #ecfdf5; color: #065f46; }
    .badge-default { background: #f3f4f6; color: #374151; }

    /* ── INLINE EDIT ── */
    .editable {
      cursor: pointer; padding: 4px 8px; border-radius: 4px;
      transition: background 0.15s; display: inline-block; min-width: 60px;
    }
    .editable:hover { background: #f3f4f6; }
    .edit-input {
      font-size: 13px; font-family: var(--s); padding: 4px 8px;
      border: 1px solid var(--blue); border-radius: 4px; outline: none;
      background: #fff; color: #111827; width: 100%; min-width: 120px;
    }
    select.edit-input { cursor: pointer; }

    /* ── TOOLBAR ── */
    .toolbar { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
    .search-input {
      padding: 9px 14px; border: 1px solid #e5e7eb; border-radius: 6px;
      font-size: 13px; font-family: var(--s); outline: none; background: #fff;
      color: #111827; flex: 1; min-width: 200px; max-width: 360px;
      transition: border-color 0.15s;
    }
    .search-input:focus { border-color: var(--blue); }
    .filter-btn {
      padding: 8px 16px; border: 1px solid #e5e7eb; border-radius: 6px;
      font-family: var(--g); font-size: 9px; font-weight: 700; letter-spacing: 1.5px;
      text-transform: uppercase; cursor: pointer; background: #fff; color: #6b7280;
      transition: all 0.15s;
    }
    .filter-btn:hover { border-color: var(--navy); color: var(--navy); }
    .filter-btn.active { background: var(--navy); color: #fff; border-color: var(--navy); }
    .count-tag {
      font-size: 11px; color: #6b7280; margin-left: auto;
      font-family: var(--g); letter-spacing: 0.5px;
    }

    /* ── SUB TABS ── */
    .subtab-row { display: flex; gap: 4px; margin-bottom: 16px; }
    .subtab-btn {
      padding: 7px 16px; border-radius: 6px; font-family: var(--g);
      font-size: 10px; font-weight: 600; letter-spacing: 1.5px;
      text-transform: uppercase; cursor: pointer; border: 1px solid #e5e7eb;
      background: #fff; color: #6b7280; transition: all 0.15s;
    }
    .subtab-btn:hover { border-color: var(--navy); color: var(--navy); }
    .subtab-btn.active { background: var(--navy); color: #fff; border-color: var(--navy); }
    .subtab-panel { display: none; }
    .subtab-panel.active { display: block; }

    /* ── SOP CARDS ── */
    .sop-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
    .sop-card {
      background: #fff; border-radius: 8px; border: 1px solid #e5e7eb;
      padding: 24px; display: flex; flex-direction: column; gap: 12px;
    }
    .sop-card-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
    .sop-card-title { font-family: var(--g); font-size: 15px; font-weight: 700; color: var(--navy); line-height: 1.3; }
    .sop-card-meta { font-size: 12px; color: #6b7280; }
    .sop-card-desc { font-size: 13px; color: #374151; line-height: 1.5; }
    .notion-link {
      display: inline-flex; align-items: center; gap: 6px;
      font-family: var(--g); font-size: 9px; font-weight: 700;
      letter-spacing: 2px; text-transform: uppercase; color: var(--navy);
      text-decoration: none; margin-top: auto; padding: 8px 0;
      border-top: 1px solid #f3f4f6; transition: opacity 0.15s;
    }
    .notion-link:hover { opacity: 0.6; }

    /* ── ANALYTICS ── */
    .analytics-row { display: flex; gap: 16px; margin-bottom: 16px; flex-wrap: wrap; }
    .analytics-card { flex: 1; min-width: 140px; }
    .bar-chart { display: flex; flex-direction: column; gap: 10px; }
    .bar-row { display: grid; grid-template-columns: 140px 1fr 40px; align-items: center; gap: 12px; }
    .bar-label { font-size: 12px; color: #374151; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .bar-track { background: #f3f4f6; border-radius: 4px; height: 8px; }
    .bar-fill { background: var(--navy); border-radius: 4px; height: 8px; transition: width 0.4s ease; }
    .bar-count { font-size: 12px; color: #6b7280; text-align: right; font-variant-numeric: tabular-nums; }

    /* ── REVENUE ── */
    .revenue-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; }
    @media (max-width: 700px) { .revenue-grid { grid-template-columns: 1fr; } }

    /* ── MEMBER CARDS ── */
    .member-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
    .member-card {
      background: #fff; border-radius: 8px; border: 1px solid #e5e7eb; padding: 20px;
      display: flex; flex-direction: column; gap: 10px;
    }
    .member-card-name { font-family: var(--g); font-size: 15px; font-weight: 700; color: var(--navy); }
    .member-card-biz { font-size: 13px; color: #374151; }
    .member-card-meta { display: flex; gap: 8px; flex-wrap: wrap; }
    .member-card-info { display: flex; flex-direction: column; gap: 4px; }
    .member-info-row { display: flex; gap: 8px; font-size: 12px; color: #6b7280; }
    .member-info-label { font-family: var(--g); font-size: 9px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: #9ca3af; min-width: 40px; }

    /* ── TALENT GRID ── */
    .talent-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
    .talent-card {
      background: #fff; border-radius: 8px; border: 1px solid #e5e7eb; padding: 20px;
      display: flex; flex-direction: column; gap: 10px;
    }
    .talent-name { font-family: var(--g); font-size: 15px; font-weight: 700; color: var(--navy); }
    .talent-skills { display: flex; gap: 6px; flex-wrap: wrap; }
    .skill-tag {
      padding: 3px 10px; background: #f0f4ff; color: #1d4ed8;
      border-radius: 4px; font-family: var(--g); font-size: 9px;
      font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
    }
    .talent-info { font-size: 12px; color: #6b7280; display: flex; flex-direction: column; gap: 3px; }

    /* ── TOAST ── */
    #toast {
      position: fixed; bottom: 24px; right: 24px; z-index: 9999;
      background: var(--navy); color: #fff; padding: 12px 20px;
      border-radius: 6px; font-size: 13px; font-family: var(--s);
      opacity: 0; transform: translateY(8px);
      transition: opacity 0.2s, transform 0.2s; pointer-events: none;
      max-width: 320px; border: 1px solid var(--border-mid);
    }
    #toast.show { opacity: 1; transform: translateY(0); }
    #toast.error { background: var(--red); border-color: transparent; }

    /* ── EMPTY STATE ── */
    .empty-state { text-align: center; padding: 60px 20px; color: #6b7280; }
    .empty-state p { font-size: 14px; margin-top: 8px; }

    /* ── LOADING SPINNER ── */
    .spinner {
      width: 20px; height: 20px; border: 2px solid #e5e7eb;
      border-top-color: var(--navy); border-radius: 50%;
      animation: spin 0.7s linear infinite; margin: 40px auto;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── REFRESH BTN ── */
    .refresh-btn {
      padding: 8px 16px; border: 1px solid #e5e7eb; border-radius: 6px;
      font-family: var(--g); font-size: 9px; font-weight: 700; letter-spacing: 1.5px;
      text-transform: uppercase; cursor: pointer; background: #fff; color: var(--navy);
      transition: all 0.15s; margin-left: auto;
    }
    .refresh-btn:hover { background: var(--navy); color: #fff; border-color: var(--navy); }

    /* ── NOTES CELL ── */
    .notes-cell { max-width: 220px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #6b7280; font-size: 12px; }
    .status-select {
      font-size: 12px; font-family: var(--s); padding: 3px 6px;
      border: 1px solid #e5e7eb; border-radius: 4px; background: #fff;
      color: #111827; cursor: pointer; outline: none;
    }
    .status-select:focus { border-color: var(--blue); }

    /* ── TABLE — better row separation ── */
    tbody tr { border-bottom: 1px solid #e5e7eb; }
    tbody td { padding: 14px 16px; }

    /* ── DELETE BUTTON ── */
    .delete-btn {
      background: none; border: none; cursor: pointer; font-size: 15px;
      color: #d1d5db; padding: 4px 6px; border-radius: 4px;
      transition: color 0.15s, background 0.15s; line-height: 1;
    }
    .delete-btn:hover { color: var(--red); background: #fff0f0; }

    /* ── ANALYTICS FORM CARDS ── */
    .form-stat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .form-stat-card { background: #fff; border-radius: 8px; border: 1px solid #e5e7eb; padding: 20px; }
    .form-stat-name { font-family: var(--g); font-size: 12px; font-weight: 700; color: var(--navy); margin-bottom: 12px; }
    .form-stat-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-bottom: 1px solid #f3f4f6; }
    .form-stat-row:last-child { border-bottom: none; }
    .form-stat-label { font-size: 11px; color: #6b7280; }
    .form-stat-val { font-family: var(--g); font-size: 14px; font-weight: 700; color: var(--navy); }

    /* ── HORIZONTAL SCROLL FIX ── */
    .tab-content { overflow-x: hidden; }
    .tab-panel { min-width: 0; }

    /* ── EXTRA BADGES ── */
    .badge-amber { background: #fff7ed; color: #9a3412; }
    .badge-mastermind { background: #eef2ff; color: #3730a3; }
    .badge-dinner { background: #fff7ed; color: #9a3412; }

    /* ── CLICKABLE ROW ── */
    .clickable-row { cursor: pointer; }
    .clickable-row:hover td { background: #f0f6ff !important; }

    /* ── DETAIL DRAWER ── */
    .drawer-overlay {
      position: fixed; inset: 0; background: rgba(8,17,31,0.45);
      z-index: 200; opacity: 0; transition: opacity 0.25s; pointer-events: none;
    }
    .drawer-overlay.open { opacity: 1; pointer-events: all; }
    .drawer {
      position: fixed; top: 0; right: 0; bottom: 0; width: 480px; max-width: 96vw;
      background: #fff; z-index: 201; transform: translateX(100%);
      transition: transform 0.3s cubic-bezier(0.16,1,0.3,1); overflow-y: auto;
      border-left: 1px solid #e5e7eb;
    }
    .drawer.open { transform: translateX(0); }
    .drawer-header {
      padding: 20px 24px; border-bottom: 1px solid #e5e7eb;
      display: flex; align-items: center; justify-content: space-between;
      position: sticky; top: 0; background: #fff; z-index: 1;
    }
    .drawer-name { font-family: var(--g); font-size: 20px; font-weight: 700; color: var(--navy); }
    .drawer-close {
      background: none; border: none; cursor: pointer; font-size: 16px;
      color: #9ca3af; padding: 6px 8px; border-radius: 4px; transition: all 0.15s; line-height: 1;
    }
    .drawer-close:hover { color: var(--navy); background: #f3f4f6; }
    .drawer-body { padding: 24px; display: flex; flex-direction: column; }
    .d-field { padding: 10px 0; border-bottom: 1px solid #f3f4f6; }
    .d-field:last-child { border-bottom: none; }
    .d-label { font-family: var(--g); font-size: 9px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #9ca3af; margin-bottom: 3px; }
    .d-value { font-size: 14px; color: #111827; line-height: 1.5; }
    .d-value a { color: var(--blue); text-decoration: none; }
    .d-value a:hover { text-decoration: underline; }
    .d-section { font-family: var(--g); font-size: 9px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--navy); padding: 16px 0 4px; border-bottom: 2px solid var(--navy); margin-bottom: 4px; }
  </style>
</head>
<body>

<!-- LOADING -->
<div id="loading"><div class="loading-mark"></div></div>

<!-- AUTH -->
<div id="auth-screen">
  <div class="auth-wrap">
    <div class="auth-box">
      <div>
        <div class="auth-mark">
          <div class="auth-mark-icon"></div>
          <span class="auth-mark-text">Private Victories Club</span>
        </div>
        <div class="auth-title" style="margin-top:16px">Admin Portal</div>
        <div class="auth-sub" style="margin-top:8px">Sign in with your PVC account to continue.</div>
      </div>
      <div class="auth-fields">
        <div class="auth-field">
          <label for="auth-email">Email</label>
          <input type="email" id="auth-email" placeholder="lliam@privatevictoriesclub.com" autocomplete="email" />
        </div>
        <div class="auth-field">
          <label for="auth-pass">Password</label>
          <input type="password" id="auth-pass" placeholder="••••••••••" autocomplete="current-password" />
        </div>
        <button class="auth-btn" id="signin-btn">Sign In</button>
        <div class="auth-err" id="auth-err"></div>
      </div>
      <div class="auth-footer">SECURE ADMIN ACCESS · PVC INTERNAL</div>
    </div>
  </div>
</div>

<!-- ADMIN APP -->
<div id="admin-app">
  <header class="app-header">
    <div class="app-logo">
      <div class="mark"></div>
      PVC <span>Admin</span>
    </div>
    <nav class="tab-nav" id="tab-nav">
      <button class="tab-btn active" data-tab="overview">Overview</button>
      <button class="tab-btn" data-tab="applications">Applications</button>
      <button class="tab-btn" data-tab="crm">CRM</button>
      <button class="tab-btn" data-tab="analytics">Analytics</button>
      <button class="tab-btn" data-tab="talent">Talent Network</button>
      <button class="tab-btn" data-tab="members">Members</button>
      <button class="tab-btn" data-tab="sops">SOPs</button>
      <button class="tab-btn" data-tab="revenue">Revenue</button>
    </nav>
    <div class="header-end">
      <button class="signout-btn" id="signout-btn">Sign Out</button>
    </div>
  </header>

  <main class="tab-content">
    <div id="tab-overview"     class="tab-panel active"><div class="spinner"></div></div>
    <div id="tab-applications" class="tab-panel"><div class="spinner"></div></div>
    <div id="tab-crm"          class="tab-panel"><div class="spinner"></div></div>
    <div id="tab-analytics"    class="tab-panel"><div class="spinner"></div></div>
    <div id="tab-talent"       class="tab-panel"><div class="spinner"></div></div>
    <div id="tab-members"      class="tab-panel"><div class="spinner"></div></div>
    <div id="tab-sops"         class="tab-panel"><div class="spinner"></div></div>
    <div id="tab-revenue"      class="tab-panel"><div class="spinner"></div></div>
  </main>
</div>

<div id="toast"></div>

<!-- DETAIL DRAWER -->
<div class="drawer-overlay" id="drawer-overlay"></div>
<div class="drawer" id="drawer">
  <div class="drawer-header">
    <div class="drawer-name" id="drawer-name">—</div>
    <button class="drawer-close" id="drawer-close-btn">✕</button>
  </div>
  <div class="drawer-body" id="drawer-body"></div>
</div>

<script is:inline>
// ── Firebase SDK ──
(function() {
  var s1 = document.createElement('script');
  s1.src = 'https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js';
  s1.onload = function() {
    var s2 = document.createElement('script');
    s2.src = 'https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js';
    s2.onload = initFirebase;
    document.head.appendChild(s2);
  };
  document.head.appendChild(s1);
})();

var ADMIN_KEY = '';
var loaded = {};
var appData = {};

// ── Toasts ──
function toast(msg, isErr) {
  var t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'show' + (isErr ? ' error' : '');
  clearTimeout(t._timer);
  t._timer = setTimeout(function() { t.className = ''; }, 3000);
}

// ── Tabs ──
function showTab(id) {
  document.querySelectorAll('.tab-btn').forEach(function(b) {
    b.classList.toggle('active', b.dataset.tab === id);
  });
  document.querySelectorAll('.tab-panel').forEach(function(p) {
    p.classList.toggle('active', p.id === 'tab-' + id);
  });
  if (!loaded[id]) {
    loaded[id] = true;
    loadTab(id);
  }
}

function loadTab(id) {
  switch (id) {
    case 'overview':     loadOverview();     break;
    case 'applications': loadApplications(); break;
    case 'crm':          loadCRM();          break;
    case 'analytics':    loadAnalytics();    break;
    case 'talent':       loadTalent();       break;
    case 'members':      loadMembers();      break;
    case 'sops':         loadSOPs();         break;
    case 'revenue':      loadRevenue();      break;
  }
}

// ── API helpers ──
function api(path) {
  return fetch(path, { headers: { 'x-admin-key': ADMIN_KEY } }).then(function(r) {
    if (!r.ok) throw new Error('API error ' + r.status);
    return r.json();
  });
}

function patchAPI(pageId, props) {
  return fetch('/api/admin/update', {
    method: 'PATCH',
    headers: { 'x-admin-key': ADMIN_KEY, 'Content-Type': 'application/json' },
    body: JSON.stringify({ pageId: pageId, props: props }),
  }).then(function(r) {
    if (!r.ok) return r.text().then(function(t) { throw new Error(t); });
  });
}

function deleteEntry(pageId, rowEl) {
  if (!confirm('Archive this entry? It will be removed from the view but stays in Notion.')) return;
  fetch('/api/admin/delete', {
    method: 'DELETE',
    headers: { 'x-admin-key': ADMIN_KEY, 'Content-Type': 'application/json' },
    body: JSON.stringify({ pageId: pageId }),
  }).then(function(r) {
    if (!r.ok) throw new Error('Delete failed ' + r.status);
    toast('Entry archived');
    if (rowEl) {
      rowEl.style.transition = 'opacity 0.3s';
      rowEl.style.opacity = '0';
      setTimeout(function() { rowEl.remove(); }, 300);
    }
    invalidateLeadData();
  }).catch(function(e) {
    toast('Failed: ' + e.message, true);
  });
}

// ── Formatters ──
function fmt(n) {
  if (n >= 1000000) return 'R' + (n / 1000000).toFixed(1) + 'M';
  if (n >= 1000) return 'R' + (n / 1000).toFixed(0) + 'k';
  return 'R' + n.toLocaleString();
}
function pct(v) { return (v * 100).toFixed(1) + '%'; }
function badge(status) {
  if (!status) return '<span class="badge badge-default">—</span>';
  var s = status.toLowerCase().replace(/\s+/g, '-');
  var cls = 'badge-default';
  if (s === 'applied')   cls = 'badge-applied';
  else if (s === 'invited') cls = 'badge-invited';
  else if (s === 'confirmed') cls = 'badge-confirmed';
  else if (s === 'paid') cls = 'badge-paid';
  else if (s === 'active') cls = 'badge-green';
  else if (s === 'vip')  cls = 'badge-blue';
  return '<span class="badge ' + cls + '">' + esc(status) + '</span>';
}
function tierBadge(t) {
  var cls = t === 'A' ? 'badge-hot' : t === 'B' ? 'badge-warm' : 'badge-cold';
  return '<span class="badge ' + cls + '">' + t + '</span>';
}
function esc(s) {
  return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ── Status select HTML ──
var CRM_STATUSES = ['Applied','Invited','Confirmed','Paid','Attended','No-Show','Rejected'];
var MEMBER_STATUSES = ['Active','Alumni','Churned','Paused'];

function statusSelect(id, current, options) {
  var html = '<select class="status-select" data-page="' + id + '" onchange="updateStatus(this)">';
  options.forEach(function(opt) {
    html += '<option value="' + esc(opt) + '"' + (opt === current ? ' selected' : '') + '>' + esc(opt) + '</option>';
  });
  html += '</select>';
  return html;
}

// ── Overview ──
function loadOverview() {
  var el = document.getElementById('tab-overview');
  Promise.all([
    api('/api/admin/revenue'),
    api('/api/admin/applicants'),
    api('/api/admin/members'),
  ]).then(function(results) {
    var rev   = results[0];
    var leads = results[1];
    var mems  = results[2];
    appData.revenue = rev;
    appData.leads   = leads;
    appData.members = mems;
    renderOverview(rev, leads, mems);
  }).catch(function(e) {
    el.innerHTML = '<div class="empty-state"><p>Failed to load overview: ' + esc(e.message) + '</p></div>';
  });
}

function renderOverview(rev, leads, mems) {
  var el = document.getElementById('tab-overview');
  var hotLeads    = leads.filter(function(l) { return l.t === 'A'; }).length;
  var recentLeads = leads.filter(function(l) {
    return l.status === 'Applied';
  }).slice(0, 5);
  var recentRev   = (rev.recent || []).slice(0, 6);
  var activeMembers = mems.filter(function(m) { return m.status && m.status.toLowerCase().includes('active'); }).length;

  var recentLeadsHTML = recentLeads.map(function(l) {
    return '<tr><td class="td-name">' + esc(l.n) + '</td><td class="td-muted">' + esc(l.b) + '</td>' +
      '<td>' + tierBadge(l.t) + '</td><td>' + esc(l.r) + '</td></tr>';
  }).join('');

  var recentRevHTML = recentRev.map(function(p) {
    return '<tr><td class="td-name">' + esc(p.name) + '</td><td class="td-muted">' + esc(p.item || p.category) + '</td>' +
      '<td style="font-weight:600;color:var(--navy)">' + fmt(p.amount) + '</td><td class="td-muted">' + esc(p.date) + '</td></tr>';
  }).join('');

  el.innerHTML =
    '<div class="page-title">Overview</div>' +
    '<div class="page-sub">Your business at a glance</div>' +
    '<div class="stat-grid">' +
      statCard('Total Revenue', fmt(rev.total || 0), 'All time') +
      statCard('This Month', fmt(rev.thisMonth || 0), 'Current month') +
      statCard('Total Leads', leads.length, 'In CRM') +
      statCard('Hot Leads', hotLeads, 'Score tier A') +
      statCard('Active Members', activeMembers || mems.length, 'Member Intelligence') +
      statCard('New Applications', recentLeads.length, 'Status: Applied') +
    '</div>' +
    '<div class="two-col">' +
      '<div class="card">' +
        '<div class="card-title">Recent Applications</div>' +
        (recentLeads.length ? '<div class="table-wrap"><table><thead><tr><th>Name</th><th>Business</th><th>Tier</th><th>Revenue</th></tr></thead><tbody>' + recentLeadsHTML + '</tbody></table></div>' : '<div class="empty-state" style="padding:20px"><p>No recent applications</p></div>') +
      '</div>' +
      '<div class="card">' +
        '<div class="card-title">Recent Revenue</div>' +
        (recentRev.length ? '<div class="table-wrap"><table><thead><tr><th>Name</th><th>Item</th><th>Amount</th><th>Date</th></tr></thead><tbody>' + recentRevHTML + '</tbody></table></div>' : '<div class="empty-state" style="padding:20px"><p>No revenue data</p></div>') +
      '</div>' +
    '</div>';
}

function statCard(label, value, sub) {
  return '<div class="stat-card"><div class="stat-label">' + label + '</div><div class="stat-value">' + value + '</div><div class="stat-sub">' + sub + '</div></div>';
}

// ── Applications ──
function loadApplications() {
  var el = document.getElementById('tab-applications');
  api('/api/admin/applicants').then(function(leads) {
    appData.leads = leads;
    appData.leadsMap = {};
    leads.forEach(function(l) { appData.leadsMap[l.id] = l; });
    renderApplications(leads, 'all');
  }).catch(function(e) {
    el.innerHTML = '<div class="empty-state"><p>' + esc(e.message) + '</p></div>';
  });
}

function renderApplications(leads, filter) {
  var el = document.getElementById('tab-applications');
  var filtered = leads;
  if (filter === 'events') filtered = leads.filter(function(l) {
    return (l.type || []).some(function(t) {
      var lc = t.toLowerCase();
      return lc.includes('mastermind') || lc.includes('cape town') || lc.includes('dinner') || lc.includes('event');
    });
  });
  else if (filter === 'membership') filtered = leads.filter(function(l) {
    return (l.type || []).some(function(t) {
      return t.toLowerCase().includes('membership') || t.toLowerCase().includes('member');
    });
  });

  var rows = filtered.map(function(l) {
    return '<tr class="clickable-row" data-id="' + l.id + '" data-rowtype="app" id="row-' + l.id + '">' +
      '<td><div class="td-name">' + esc(l.n) + '</div><div style="margin-top:3px;font-size:11px;color:#6b7280">' + esc(l.b) + '</div></td>' +
      '<td>' + eventBadge(l.type) + '</td>' +
      '<td>' + esc(l.r) + '</td>' +
      '<td>' + tierBadge(l.t) + '</td>' +
      '<td>' + statusSelect(l.id, l.status, CRM_STATUSES) + '</td>' +
      '<td class="notes-cell">' +
        '<span class="editable" onclick="editNotes(this, \'' + l.id + '\')">' + (esc(l.w) || '<span style="color:#9ca3af">Add notes...</span>') + '</span>' +
      '</td>' +
      '<td><button class="delete-btn" title="Archive" onclick="deleteEntry(\'' + l.id + '\', document.getElementById(\'row-' + l.id + '\'))">✕</button></td>' +
    '</tr>';
  }).join('');

  el.innerHTML =
    '<div class="page-title">Applications</div>' +
    '<div class="page-sub">All event applications — click a row to see full details</div>' +
    '<div class="toolbar">' +
      '<button class="filter-btn' + (filter === 'all' ? ' active' : '') + '" onclick="renderApplications(appData.leads, \'all\')">All</button>' +
      '<button class="filter-btn' + (filter === 'events' ? ' active' : '') + '" onclick="renderApplications(appData.leads, \'events\')">Events</button>' +
      '<button class="filter-btn' + (filter === 'membership' ? ' active' : '') + '" onclick="renderApplications(appData.leads, \'membership\')">Membership</button>' +
      '<span class="count-tag">' + filtered.length + ' entries</span>' +
      '<button class="refresh-btn" onclick="loaded.applications=false; loadApplications()">Refresh</button>' +
    '</div>' +
    (filtered.length ? '<div class="table-wrap"><table><thead><tr><th>Applicant</th><th>Event</th><th>Revenue</th><th>Tier</th><th>Status</th><th>Goals / Notes</th><th></th></tr></thead><tbody>' + rows + '</tbody></table></div>' : '<div class="empty-state"><p>No applications found</p></div>');
}

// ── CRM ──
function loadCRM() {
  var el = document.getElementById('tab-crm');
  api('/api/admin/applicants').then(function(leads) {
    appData.leads = leads;
    appData.leadsMap = {};
    leads.forEach(function(l) { appData.leadsMap[l.id] = l; });
    renderCRM(leads, '');
  }).catch(function(e) {
    el.innerHTML = '<div class="empty-state"><p>' + esc(e.message) + '</p></div>';
  });
}

function renderCRM(leads, q) {
  var el = document.getElementById('tab-crm');
  var filtered = q ? leads.filter(function(l) {
    var s = (l.n + ' ' + l.b + ' ' + l.e + ' ' + (l.type || []).join(' ')).toLowerCase();
    return s.includes(q.toLowerCase());
  }) : leads;

  var rows = filtered.map(function(l) {
    return '<tr class="clickable-row" data-id="' + l.id + '" data-rowtype="crm" id="crm-' + l.id + '">' +
      '<td><div class="td-name">' + esc(l.n) + '</div></td>' +
      '<td>' + esc(l.b) + '</td>' +
      '<td class="td-muted" style="font-size:12px">' + esc(l.e) + '</td>' +
      '<td>' + esc(l.r) + '</td>' +
      '<td>' + tierBadge(l.t) + '</td>' +
      '<td>' + statusSelect(l.id, l.status, CRM_STATUSES) + '</td>' +
      '<td class="notes-cell">' +
        '<span class="editable" onclick="editNotes(this, \'' + l.id + '\')">' + (esc(l.w) || '<span style="color:#9ca3af">Add notes...</span>') + '</span>' +
      '</td>' +
      '<td><button class="delete-btn" title="Archive" onclick="deleteEntry(\'' + l.id + '\', document.getElementById(\'crm-' + l.id + '\'))">✕</button></td>' +
    '</tr>';
  }).join('');

  el.innerHTML =
    '<div class="page-title">CRM</div>' +
    '<div class="page-sub">All leads — click a row to see full info, click notes to edit inline</div>' +
    '<div class="toolbar">' +
      '<input class="search-input" type="text" placeholder="Search name, business, email..." value="' + esc(q) + '" oninput="renderCRM(appData.leads, this.value)" />' +
      '<span class="count-tag">' + filtered.length + ' of ' + leads.length + '</span>' +
      '<button class="refresh-btn" onclick="loaded.crm=false; loadCRM()">Refresh</button>' +
    '</div>' +
    (filtered.length ? '<div class="table-wrap"><table><thead><tr><th>Name</th><th>Business</th><th>Email</th><th>Revenue</th><th>Tier</th><th>Status</th><th>Goals / Notes</th><th></th></tr></thead><tbody>' + rows + '</tbody></table></div>' : '<div class="empty-state"><p>No results</p></div>');
}

// ── Analytics ──
function loadAnalytics() {
  var el = document.getElementById('tab-analytics');
  api('/api/admin/analytics').then(function(data) {
    appData.analytics = data;
    renderAnalytics(data);
  }).catch(function(e) {
    el.innerHTML = '<div class="empty-state"><p>' + esc(e.message) + '</p></div>';
  });
}

function renderAnalytics(data) {
  var el    = document.getElementById('tab-analytics');
  var crm   = data.crmStats || {};
  var camps = data.campaigns || [];
  var forms = data.tallyForms || [];

  // ─ Tally form stats ─
  var formCardsHTML = forms.map(function(f) {
    var hasData = f.views !== null || f.responses !== null;
    return '<div class="form-stat-card">' +
      '<div class="form-stat-name">' + esc(f.name) + '</div>' +
      (hasData
        ? '<div class="form-stat-row"><span class="form-stat-label">Views</span><span class="form-stat-val">' + (f.views !== null ? f.views.toLocaleString() : '—') + '</span></div>' +
          '<div class="form-stat-row"><span class="form-stat-label">Responses</span><span class="form-stat-val">' + (f.responses !== null ? f.responses.toLocaleString() : '—') + '</span></div>' +
          '<div class="form-stat-row"><span class="form-stat-label">Conversion</span><span class="form-stat-val">' + (f.conversionRate !== null ? pct(f.conversionRate) : '—') + '</span></div>'
        : '<div style="font-size:12px;color:#9ca3af;padding:8px 0">Add TALLY_API_KEY in Vercel to see form stats</div>'
      ) +
    '</div>';
  }).join('');

  // ─ CRM submission stats ─
  var byTypeMax = Math.max(1, Math.max.apply(null, Object.values(crm.byType || { _: 1 })));
  var byTypeHTML = Object.entries(crm.byType || {}).sort(function(a,b) { return b[1]-a[1]; }).map(function(kv) {
    var w = Math.round((kv[1] / byTypeMax) * 100);
    return '<div class="bar-row"><div class="bar-label">' + esc(kv[0]) + '</div><div class="bar-track"><div class="bar-fill" style="width:' + w + '%"></div></div><div class="bar-count">' + kv[1] + '</div></div>';
  }).join('');

  var byStatusHTML = Object.entries(crm.byStatus || {}).sort(function(a,b) { return b[1]-a[1]; }).map(function(kv) {
    return '<tr><td class="td-name">' + esc(kv[0]) + '</td><td><span class="badge badge-default">' + kv[1] + '</span></td></tr>';
  }).join('');

  // ─ Brevo campaigns ─
  var campsHTML = camps.map(function(c) {
    return '<tr>' +
      '<td class="td-name" style="max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">' + esc(c.name) + '</td>' +
      '<td class="td-muted" style="max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">' + esc(c.subject) + '</td>' +
      '<td class="td-muted">' + esc(c.sentAt ? c.sentAt.slice(0,10) : '—') + '</td>' +
      '<td style="font-variant-numeric:tabular-nums">' + (c.sent ? c.sent.toLocaleString() : '—') + '</td>' +
      '<td style="font-variant-numeric:tabular-nums">' + (c.delivered ? c.delivered.toLocaleString() : '—') + '</td>' +
      '<td>' + (c.opens ? c.opens.toLocaleString() : '—') + '</td>' +
      '<td><span class="badge badge-green">' + pct(c.openRate || 0) + '</span></td>' +
      '<td><span class="badge badge-blue">' + pct(c.clickRate || 0) + '</span></td>' +
      '<td class="td-muted">' + (c.unsubscribed || 0) + '</td>' +
    '</tr>';
  }).join('');

  el.innerHTML =
    '<div class="page-title">Analytics</div>' +
    '<div class="page-sub">Form performance and email campaign metrics</div>' +
    '<div class="card" style="margin-bottom:24px">' +
      '<div class="card-title">Tally Forms</div>' +
      '<div class="form-stat-grid">' + (formCardsHTML || '<p class="td-muted">No forms configured</p>') + '</div>' +
    '</div>' +
    '<div class="two-col">' +
      '<div class="card">' +
        '<div class="card-title">CRM Leads by Type</div>' +
        '<div class="bar-chart">' + (byTypeHTML || '<p class="td-muted">No data</p>') + '</div>' +
      '</div>' +
      '<div class="card">' +
        '<div class="card-title">Leads by Status</div>' +
        '<div class="table-wrap"><table><thead><tr><th>Status</th><th>Count</th></tr></thead><tbody>' + (byStatusHTML || '<tr><td colspan="2" class="td-muted">No data</td></tr>') + '</tbody></table></div>' +
      '</div>' +
    '</div>' +
    '<div class="card" style="margin-bottom:24px">' +
      '<div class="card-title">Email Campaigns — Brevo</div>' +
      (camps.length ? '<div class="table-wrap"><table><thead><tr><th>Campaign</th><th>Subject</th><th>Date</th><th>Sent</th><th>Delivered</th><th>Opens</th><th>Open Rate</th><th>Click Rate</th><th>Unsub</th></tr></thead><tbody>' + campsHTML + '</tbody></table></div>' : '<div class="empty-state" style="padding:20px"><p>No campaign data yet — check BREVO_API_KEY in Vercel</p></div>') +
    '</div>';
}

// ── Talent Network ──
function loadTalent() {
  var el = document.getElementById('tab-talent');
  api('/api/admin/talent').then(function(data) {
    appData.talent = data;
    renderTalent(data);
  }).catch(function(e) {
    el.innerHTML = '<div class="empty-state"><p>' + esc(e.message) + '</p></div>';
  });
}

function talentCategoryColor(skills) {
  if (!skills) return { bg: '#f3f4f6', text: '#6b7280', border: '#d1d5db' };
  var s = skills.toLowerCase();
  if (s.includes('sales') || s.includes('closer') || s.includes('setter'))
    return { bg: '#ede9fe', text: '#7c3aed', border: '#7c3aed' };
  if (s.includes('ads') || s.includes('media buy') || s.includes('paid'))
    return { bg: '#fff7ed', text: '#c2410c', border: '#f97316' };
  if (s.includes('edit') || s.includes('video') || s.includes('content'))
    return { bg: '#ecfdf5', text: '#065f46', border: '#10b981' };
  if (s.includes('dev') || s.includes('web') || s.includes('code') || s.includes('tech'))
    return { bg: '#eff6ff', text: '#1d4ed8', border: '#3b82f6' };
  if (s.includes('design') || s.includes('graphic') || s.includes('brand'))
    return { bg: '#fdf2f8', text: '#9d174d', border: '#ec4899' };
  if (s.includes('copy') || s.includes('writ'))
    return { bg: '#fefce8', text: '#854d0e', border: '#eab308' };
  if (s.includes('market') || s.includes('growth') || s.includes('seo'))
    return { bg: '#f0fdf4', text: '#166534', border: '#22c55e' };
  return { bg: '#f3f4f6', text: '#6b7280', border: '#d1d5db' };
}

function renderTalent(data) {
  var el      = document.getElementById('tab-talent');
  var entries = data.supply || [];

  if (data.noKey) {
    el.innerHTML =
      '<div class="page-title">Talent Network</div>' +
      '<div class="page-sub">Form submissions from tally.so/r/dWJdNz</div>' +
      '<div class="empty-state"><p style="font-size:14px">Add <strong>TALLY_API_KEY</strong> in Vercel → Settings → Environment Variables to load submissions.</p></div>';
    return;
  }

  var cards = entries.map(function(e) {
    var col = talentCategoryColor(e.skills);
    var isPVC = e.member && e.member.toLowerCase().includes('yes');

    return '<div class="talent-card" id="tal-' + e.id + '" onclick="openTalentDrawer(appData.talent.supply.find(function(x){return x.id===\'' + e.id + '\'}))" style="border-top:3px solid ' + col.border + ';padding-top:14px;cursor:pointer">' +

      // Header: name + date
      '<div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:8px">' +
        '<div class="talent-name">' + esc(e.n) + '</div>' +
        (e.since ? '<span style="font-size:11px;color:#9ca3af;flex-shrink:0">' + esc(e.since) + '</span>' : '') +
      '</div>' +

      // Category pill
      '<div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px">' +
        (e.skills ? '<span style="display:inline-block;padding:2px 10px;border-radius:20px;font-size:11px;font-weight:600;background:' + col.bg + ';color:' + col.text + '">' + esc(e.skills) + '</span>' : '') +
      '</div>' +

      // Rate
      (e.rate ? '<div style="font-size:13px;font-weight:700;color:var(--navy);margin-bottom:6px">' + esc(e.rate) + '</div>' : '') +

      // Contact footer
      '<div style="display:flex;gap:10px;flex-wrap:wrap;padding-top:8px;border-top:1px solid #f3f4f6;margin-top:auto">' +
        (e.e ? '<span style="font-size:12px;color:var(--blue)">' + esc(e.e) + '</span>' : '') +
        (e.p ? '<span style="font-size:12px;color:#9ca3af">' + esc(e.p) + '</span>' : '') +
      '</div>' +

    '</div>';
  }).join('');

  el.innerHTML =
    '<div class="page-title">Talent Network</div>' +
    '<div class="page-sub">Form submissions from the PVC Talent Network form — ' + entries.length + ' entries</div>' +
    '<div style="display:flex;justify-content:flex-end;margin-bottom:16px">' +
      '<button class="refresh-btn" onclick="loaded.talent=false; loadTalent()">Refresh</button>' +
    '</div>' +
    (entries.length ? '<div class="talent-grid">' + cards + '</div>' : '<div class="empty-state"><p>No submissions yet</p></div>');
}

// ── Members ──
function loadMembers() {
  var el = document.getElementById('tab-members');
  api('/api/admin/members').then(function(members) {
    appData.members = members;
    appData.membersMap = {};
    members.forEach(function(m) { appData.membersMap[m.id] = m; });
    renderMembers(members, '');
  }).catch(function(e) {
    el.innerHTML = '<div class="empty-state"><p>' + esc(e.message) + '</p></div>';
  });
}

function renderMembers(members, q) {
  var el = document.getElementById('tab-members');
  var filtered = q ? members.filter(function(m) {
    return (m.n + ' ' + m.b + ' ' + m.e).toLowerCase().includes(q.toLowerCase());
  }) : members;

  var rows = filtered.map(function(m) {
    return '<tr class="clickable-row" data-id="' + m.id + '" data-rowtype="member" id="mem-' + m.id + '">' +
      '<td><div class="td-name">' + esc(m.n) + '</div><div style="font-size:11px;color:#6b7280;margin-top:2px">' + esc(m.b) + '</div></td>' +
      '<td>' + esc(m.r) + '</td>' +
      '<td>' + (m.tier ? '<span class="badge badge-blue" style="white-space:nowrap">' + esc(m.tier) + '</span>' : '—') + '</td>' +
      '<td class="td-muted" style="font-size:12px;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + esc(m.bottleneck || '—') + '</td>' +
      '<td class="notes-cell"><span class="editable" onclick="editNotes(this, \'' + m.id + '\')">' + (esc(m.notes) || '<span style="color:#9ca3af">—</span>') + '</span></td>' +
      '<td><button class="delete-btn" title="Archive" onclick="deleteEntry(\'' + m.id + '\', document.getElementById(\'mem-' + m.id + '\'))">✕</button></td>' +
    '</tr>';
  }).join('');

  el.innerHTML =
    '<div class="page-title">Member Intelligence</div>' +
    '<div class="page-sub">All PVC members — click a row to see full details</div>' +
    '<div class="toolbar">' +
      '<input class="search-input" type="text" placeholder="Search name, business..." value="' + esc(q) + '" oninput="renderMembers(appData.members, this.value)" />' +
      '<span class="count-tag">' + filtered.length + ' of ' + members.length + '</span>' +
      '<button class="refresh-btn" onclick="loaded.members=false; loadMembers()">Refresh</button>' +
    '</div>' +
    (filtered.length ? '<div class="table-wrap"><table><thead><tr><th>Member</th><th>Revenue</th><th>Tier</th><th>Current Bottleneck</th><th>Notes</th><th></th></tr></thead><tbody>' + rows + '</tbody></table></div>' : '<div class="empty-state"><p>No members found</p></div>');
}

