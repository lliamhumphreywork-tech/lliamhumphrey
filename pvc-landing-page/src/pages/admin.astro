// Click-to-open row delegation
document.addEventListener('click', function(e) {
  var row = e.target.closest('tr.clickable-row');
  if (!row) return;
  if (e.target.closest('button,select,.editable,.edit-input')) return;
  var id   = row.dataset.id;
  var type = row.dataset.rowtype;
  if (type === 'member' && appData.membersMap && appData.membersMap[id]) openMemberDrawer(appData.membersMap[id]);
  else if (type === 'crm' && appData.leadsMap && appData.leadsMap[id]) openCRMDrawer(appData.leadsMap[id]);
  else if (type === 'app' && appData.leadsMap && appData.leadsMap[id]) openAppDrawer(appData.leadsMap[id]);
});

function eventBadge(types) {
  return (types || []).map(function(t) {
    var lc = t.toLowerCase();
    var cls = 'badge-default';
    if (lc.includes('mastermind') || lc.includes('cape town')) cls = 'badge-mastermind';
    else if (lc.includes('dinner')) cls = 'badge-dinner';
    else if (lc.includes('membership') || lc.includes('member')) cls = 'badge-green';
    return '<span class="badge ' + cls + '">' + esc(t) + '</span>';
  }).join(' ');
}

