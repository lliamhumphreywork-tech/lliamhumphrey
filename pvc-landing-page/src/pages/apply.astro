---
export const prerender = false;
const PH_KEY = import.meta.env.PUBLIC_POSTHOG_KEY ?? '';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Apply — Private Victories Club</title>
<meta name="description" content="Apply for membership to Private Victories Club." />
<meta name="robots" content="noindex" />
<script define:vars={{ PH_KEY }} is:inline>window.__PVC_PH_KEY = PH_KEY;</script>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet" />
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --black:       #000000;
  --charcoal:    #0d0008;
  --plum:        #45183F;
  --plum-deep:   #2d0f29;
  --plum-mid:    #5c2257;
  --lavender:    #C4B8C0;
  --lavender-dim:#6B6068;
  --blush:       #F0EBF0;
  --blush-ink:   #1A0F18;
  --white:       #F4F1EE;
  --border:      rgba(196,184,192,0.12);
  --border-hover:rgba(196,184,192,0.28);
  --g: 'Syne', sans-serif;
  --s: 'DM Sans', sans-serif;
}

html, body {
  height: 100%;
  background: var(--black);
  color: var(--white);
  font-family: var(--s);
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

/* ── Layout ── */
.layout {
  display: flex;
  min-height: 100vh;
}

.form-col {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 0;
  overflow-y: auto;
}

.card-col {
  width: 460px;
  flex-shrink: 0;
  position: sticky;
  top: 0;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--charcoal);
  border-left: 1px solid rgba(196,184,192,0.06);
}

/* ── Nav ── */
.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28px 56px;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}

.nav-wordmark {
  font-family: var(--g);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--white);
  text-decoration: none;
  opacity: 0.9;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 24px;
}

.step-counter {
  font-family: var(--g);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 3px;
  color: var(--lavender-dim);
}

.nav-back {
  font-family: var(--s);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--lavender-dim);
  text-decoration: none;
  transition: color 0.2s;
  cursor: pointer;
  background: none;
  border: none;
  padding: 0;
}

.nav-back:hover { color: var(--lavender); }
.nav-back[hidden] { display: none; }

/* ── Progress bar ── */
.progress-bar {
  height: 1px;
  background: var(--border);
  flex-shrink: 0;
}

.progress-fill {
  height: 100%;
  background: var(--lavender);
  transition: width 0.4s ease;
  width: 10%;
}

/* ── Steps container ── */
.steps-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 56px 56px 64px;
}

/* ── Individual step ── */
.step {
  display: none;
  flex-direction: column;
  animation: fadeIn 0.3s ease;
}

.step.active {
  display: flex;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ── Step header ── */
.step-eyebrow {
  font-family: var(--g);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--lavender-dim);
  margin-bottom: 16px;
}

.step-title {
  font-family: var(--g);
  font-size: clamp(22px, 3.2vw, 34px);
  font-weight: 700;
  line-height: 1.12;
  letter-spacing: -0.4px;
  color: var(--white);
  text-wrap: balance;
  margin-bottom: 8px;
}

.step-hint {
  font-family: var(--s);
  font-size: 14px;
  font-weight: 300;
  line-height: 1.65;
  color: var(--lavender-dim);
  margin-bottom: 36px;
  max-width: 480px;
}

/* ── Field grid ── */
.field-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px 24px;
  margin-bottom: 0;
}

/* ── Input fields ── */
.field {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 24px;
}

.field:last-of-type { margin-bottom: 0; }

.field-grid .field { margin-bottom: 0; }

.field label {
  font-family: var(--g);
  font-size: 9.5px;
  font-weight: 600;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--lavender-dim);
}

.field input,
.field textarea {
  background: transparent;
  border: none;
  border-bottom: 1px solid var(--border);
  color: var(--white);
  font-family: var(--s);
  font-size: 16px;
  font-weight: 300;
  padding: 10px 0 12px;
  outline: none;
  transition: border-color 0.2s;
  width: 100%;
  -webkit-appearance: none;
}

.field input::placeholder,
.field textarea::placeholder {
  color: var(--lavender-dim);
  opacity: 0.45;
}

.field input:focus,
.field textarea:focus {
  border-bottom-color: rgba(196,184,192,0.6);
}

.field textarea {
  resize: none;
  min-height: 100px;
  line-height: 1.65;
}

/* ── Revenue tiles ── */
.tile-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

.tile {
  border: 1px solid var(--border);
  padding: 20px 18px;
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s;
  position: relative;
  user-select: none;
  -webkit-user-select: none;
}

.tile:hover {
  border-color: var(--border-hover);
  background: rgba(196,184,192,0.04);
}

.tile.selected {
  border-color: var(--lavender);
  background: rgba(196,184,192,0.07);
}

.tile.selected::after {
  content: '';
  position: absolute;
  top: 10px;
  right: 10px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--lavender);
}

.tile-value {
  font-family: var(--g);
  font-size: 13px;
  font-weight: 600;
  color: var(--white);
  letter-spacing: -0.2px;
  line-height: 1.3;
  pointer-events: none;
}

.tile-sub {
  font-family: var(--s);
  font-size: 10px;
  font-weight: 400;
  color: var(--lavender-dim);
  margin-top: 3px;
  pointer-events: none;
}

/* ── Need tiles (multi-select) ── */
.need-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

.need-tile {
  border: 1px solid var(--border);
  padding: 18px 16px;
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s;
  position: relative;
  user-select: none;
  -webkit-user-select: none;
}

.need-tile:hover {
  border-color: var(--border-hover);
  background: rgba(196,184,192,0.04);
}

.need-tile.selected {
  border-color: var(--lavender);
  background: rgba(196,184,192,0.07);
}

.need-tile.selected::after {
  content: '';
  position: absolute;
  top: 10px;
  right: 10px;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--lavender);
}

.need-tile-label {
  font-family: var(--g);
  font-size: 12px;
  font-weight: 600;
  color: var(--white);
  pointer-events: none;
}

.need-tile-sub {
  font-family: var(--s);
  font-size: 10px;
  font-weight: 300;
  color: var(--lavender-dim);
  margin-top: 4px;
  pointer-events: none;
}

/* ── Commitment tiles ── */
.commit-grid {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.commit-tile {
  border: 1px solid var(--border);
  padding: 18px 22px;
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s;
  position: relative;
  user-select: none;
  display: flex;
  align-items: center;
  gap: 16px;
}

.commit-tile:hover {
  border-color: var(--border-hover);
  background: rgba(196,184,192,0.04);
}

.commit-tile.selected {
  border-color: var(--lavender);
  background: rgba(196,184,192,0.07);
}

.commit-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: 1px solid var(--lavender-dim);
  flex-shrink: 0;
  transition: background 0.2s, border-color 0.2s;
  pointer-events: none;
}

.commit-tile.selected .commit-dot {
  background: var(--lavender);
  border-color: var(--lavender);
}

.commit-text {
  font-family: var(--s);
  font-size: 14px;
  font-weight: 300;
  color: var(--white);
  line-height: 1.4;
  pointer-events: none;
}

/* ── Step navigation ── */
.step-nav {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-top: 40px;
}

.next-btn {
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--white);
  color: var(--black);
  border: none;
  padding: 18px 32px;
  font-family: var(--g);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.2s, opacity 0.2s;
  outline: none;
  flex-shrink: 0;
}

.next-btn:hover { background: var(--blush); }
.next-btn:disabled { opacity: 0.4; cursor: not-allowed; }

.next-btn.plum {
  background: var(--plum);
  color: var(--white);
}
.next-btn.plum:hover { background: var(--plum-mid); }

.skip-link {
  font-family: var(--s);
  font-size: 12px;
  font-weight: 300;
  color: var(--lavender-dim);
  cursor: pointer;
  background: none;
  border: none;
  padding: 0;
  text-decoration: underline;
  text-underline-offset: 3px;
  transition: color 0.2s;
}

.skip-link:hover { color: var(--lavender); }

/* ── Validation ── */
.field-error {
  font-family: var(--s);
  font-size: 11px;
  color: #d4655d;
  display: none;
}
.field-error.visible { display: block; }

.step-error {
  font-family: var(--s);
  font-size: 12px;
  color: #d4655d;
  margin-top: 12px;
  display: none;
}
.step-error.visible { display: block; }

/* ── Success ── */
.success-step {
  display: none;
  flex-direction: column;
  justify-content: center;
  padding: 56px;
  flex: 1;
}
.success-step.visible { display: flex; }
.form-col.submitted .steps-wrap { display: none; }

.success-eyebrow {
  font-family: var(--g);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--lavender-dim);
  margin-bottom: 20px;
}

.success-title {
  font-family: var(--g);
  font-size: clamp(28px, 4vw, 44px);
  font-weight: 700;
  color: var(--white);
  line-height: 1.1;
  margin-bottom: 20px;
}

.success-body {
  font-family: var(--s);
  font-size: 15px;
  font-weight: 300;
  color: var(--lavender-dim);
  line-height: 1.75;
  max-width: 440px;
}

/* ── Card preview ── */
.card-inner {
  padding: 48px;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}

.preview-card {
  width: 100%;
  max-width: 360px;
  aspect-ratio: 1.58 / 1;
  background: linear-gradient(135deg, var(--blush) 0%, var(--plum-deep) 52%, #000000 100%);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 28px 30px;
  transition: box-shadow 0.4s;
}

.preview-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom right, transparent 30%, rgba(0,0,0,0.45) 100%);
  pointer-events: none;
}

.preview-card.submitted {
  box-shadow: 0 0 0 1px rgba(196,184,192,0.3), 0 20px 60px rgba(69,24,63,0.25);
}

.preview-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.preview-wordmark {
  font-family: var(--g);
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--blush-ink);
  line-height: 1.6;
  mix-blend-mode: multiply;
}

.preview-status {
  font-family: var(--g);
  font-size: 7.5px;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--white);
  border: 1px solid rgba(244,241,238,0.3);
  padding: 4px 9px;
  background: rgba(0,0,0,0.2);
}

.preview-mid {
  position: relative;
  z-index: 1;
}

.preview-name {
  font-family: var(--g);
  font-size: 26px;
  font-weight: 800;
  color: var(--white);
  letter-spacing: -0.5px;
  line-height: 1.05;
  text-shadow: 0 1px 8px rgba(0,0,0,0.4);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  transition: opacity 0.2s;
}

.preview-name.placeholder {
  font-size: 13px;
  font-weight: 300;
  color: rgba(244,241,238,0.35);
  letter-spacing: 0;
}

.preview-biz {
  font-family: var(--s);
  font-size: 11px;
  font-weight: 300;
  color: rgba(196,184,192,0.65);
  margin-top: 6px;
  min-height: 14px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-card-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.preview-revenue {
  font-family: var(--g);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: rgba(196,184,192,0.45);
  transition: color 0.3s;
}

.preview-revenue.active { color: var(--lavender); }

.preview-wm-bg {
  position: absolute;
  bottom: -10px;
  right: -8px;
  font-family: var(--g);
  font-size: 72px;
  font-weight: 800;
  letter-spacing: -6px;
  color: rgba(26,15,24,0.08);
  user-select: none;
  pointer-events: none;
  line-height: 1;
}

.card-caption {
  font-family: var(--g);
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: rgba(196,184,192,0.2);
  text-align: center;
}

/* ── Responsive ── */
@media (max-width: 1024px) {
  .card-col { width: 380px; }
  .preview-card { max-width: 300px; }
  .preview-name { font-size: 20px; }
}

@media (max-width: 768px) {
  .layout { flex-direction: column; }
  .card-col { display: none; }
  .nav { padding: 20px 24px; }
  .steps-wrap { padding: 40px 24px 56px; }
  .success-step { padding: 40px 24px; }
  .tile-grid { grid-template-columns: repeat(2, 1fr); }
  .need-grid { grid-template-columns: repeat(2, 1fr); }
  .field-grid { grid-template-columns: 1fr; }
}
</style>
</head>
<body>
<div class="layout">

  <!-- Form column -->
  <div class="form-col" id="formCol">

    <!-- Nav -->
    <nav class="nav">
      <a href="/" class="nav-wordmark">Private Victories</a>
      <div class="nav-right">
        <button class="nav-back" id="backBtn" onclick="prevStep()" hidden>← Back</button>
      </div>
    </nav>

    <!-- Progress -->
    <div class="progress-bar">
      <div class="progress-fill" id="progressFill"></div>
    </div>

    <!-- Success state -->
    <div class="success-step" id="successStep">
      <p class="success-eyebrow">Application Received</p>
      <h1 class="success-title">We'll be in touch.</h1>
      <p class="success-body">
        Your application is under review. We read every one personally.<br><br>
        If it's a fit, you'll hear from us directly within 24–48 hours.
      </p>
    </div>

    <!-- Steps -->
    <div class="steps-wrap" id="stepsWrap">
      <form id="applyForm" novalidate>

        <!-- Step 1: Who -->
        <div class="step active" data-step="0">
          <p class="step-eyebrow">Step 1 of 10</p>
          <h2 class="step-title">Let's start with the basics.</h2>
          <p class="step-hint">Who's applying?</p>
          <div class="field-grid" style="margin-bottom:20px">
            <div class="field">
              <label for="name">Full Name *</label>
              <input type="text" id="name" placeholder="Your full name" autocomplete="name" />
              <span class="field-error" id="nameErr">Required</span>
            </div>
            <div class="field">
              <label for="email">Email *</label>
              <input type="email" id="email" placeholder="you@example.com" autocomplete="email" />
              <span class="field-error" id="emailErr">Valid email required</span>
            </div>
            <div class="field">
              <label for="phone">WhatsApp Number</label>
              <input type="tel" id="phone" placeholder="+27 82 000 0000" autocomplete="tel" />
            </div>
            <div class="field">
              <label for="instagram">Instagram Handle</label>
              <input type="text" id="instagram" placeholder="@yourhandle" />
            </div>
          </div>
          <div class="step-nav">
            <button type="button" class="next-btn" onclick="nextStep()">Continue <span>→</span></button>
          </div>
        </div>

        <!-- Step 2: Business -->
        <div class="step" data-step="1">
          <p class="step-eyebrow">Step 2 of 10</p>
          <h2 class="step-title">What are you building?</h2>
          <p class="step-hint">What do you do, who do you serve, and what makes it real?</p>
          <div class="field">
            <label for="business">Your Business *</label>
            <textarea id="business" placeholder="Describe what you're building…" rows="4"></textarea>
            <span class="field-error" id="businessErr">Required</span>
          </div>
          <div class="step-nav">
            <button type="button" class="next-btn" onclick="nextStep()">Continue <span>→</span></button>
          </div>
        </div>

        <!-- Step 3: Revenue -->
        <div class="step" data-step="2">
          <p class="step-eyebrow">Step 3 of 10</p>
          <h2 class="step-title">Where are you at right now?</h2>
          <p class="step-hint">Be honest — we use this to understand who we're talking to.</p>
          <div class="tile-grid" id="revenueTiles">
            <div class="tile" data-value="R0 – R20k/month" onclick="selectRevenue(this)">
              <div class="tile-value">R0 – R20k</div>
              <div class="tile-sub">/month</div>
            </div>
            <div class="tile" data-value="R20k – R50k/month" onclick="selectRevenue(this)">
              <div class="tile-value">R20k – R50k</div>
              <div class="tile-sub">/month</div>
            </div>
            <div class="tile" data-value="R50k – R100k/month" onclick="selectRevenue(this)">
              <div class="tile-value">R50k – R100k</div>
              <div class="tile-sub">/month</div>
            </div>
            <div class="tile" data-value="R100k – R250k/month" onclick="selectRevenue(this)">
              <div class="tile-value">R100k – R250k</div>
              <div class="tile-sub">/month</div>
            </div>
            <div class="tile" data-value="R250k – R500k/month" onclick="selectRevenue(this)">
              <div class="tile-value">R250k – R500k</div>
              <div class="tile-sub">/month</div>
            </div>
            <div class="tile" data-value="R500k+/month" onclick="selectRevenue(this)">
              <div class="tile-value">R500k+</div>
              <div class="tile-sub">/month</div>
            </div>
          </div>
          <span class="step-error" id="revenueErr">Please select a revenue range</span>
          <div class="step-nav">
            <button type="button" class="next-btn" onclick="nextStep()">Continue <span>→</span></button>
          </div>
        </div>

        <!-- Step 4: Prompt -->
        <div class="step" data-step="3">
          <p class="step-eyebrow">Step 4 of 10</p>
          <h2 class="step-title">What prompted you to apply to Private Victories right now?</h2>
          <p class="step-hint">Not your elevator pitch. What's actually going on for you as a founder?</p>
          <div class="field">
            <label for="prompt">Your Answer *</label>
            <textarea id="prompt" placeholder="Be direct. We're listening." rows="5"></textarea>
            <span class="field-error" id="promptErr">Required</span>
          </div>
          <div class="step-nav">
            <button type="button" class="next-btn" onclick="nextStep()">Continue <span>→</span></button>
          </div>
        </div>

        <!-- Step 5: Tangible result -->
        <div class="step" data-step="4">
          <p class="step-eyebrow">Step 5 of 10</p>
          <h2 class="step-title">What tangible result in the first 3 months would make being a PVC member valuable for you?</h2>
          <p class="step-hint">A new client, a key hire, a decision made — what does success look like inside this room?</p>
          <div class="field">
            <label for="tangibleResult">Your Answer</label>
            <textarea id="tangibleResult" placeholder="In 3 months, it would mean something if…" rows="4"></textarea>
          </div>
          <div class="step-nav">
            <button type="button" class="next-btn" onclick="nextStep()">Continue <span>→</span></button>
          </div>
        </div>

        <!-- Step 6: Contribute & gain -->
        <div class="step" data-step="5">
          <p class="step-eyebrow">Step 6 of 10</p>
          <h2 class="step-title">What do you believe you could contribute to, and gain from, a private network of entrepreneurs?</h2>
          <p class="step-hint">The best rooms are two-way. What's yours?</p>
          <div class="field">
            <label for="contributeGain">Your Answer</label>
            <textarea id="contributeGain" placeholder="I'd bring… and I'd want to learn / get…" rows="4"></textarea>
          </div>
          <div class="step-nav">
            <button type="button" class="next-btn" onclick="nextStep()">Continue <span>→</span></button>
          </div>
        </div>

        <!-- Step 7: Working on (qualifying) -->
        <div class="step" data-step="6">
          <p class="step-eyebrow">Step 7 of 10</p>
          <h2 class="step-title">What's one thing you're working on right now that almost nobody knows about yet?</h2>
          <p class="step-hint">Private victories. The real work. Not the polished version.</p>
          <div class="field">
            <label for="workingOn">Your Answer</label>
            <textarea id="workingOn" placeholder="Right now I'm quietly working on…" rows="4"></textarea>
          </div>
          <div class="step-nav">
            <button type="button" class="next-btn" onclick="nextStep()">Continue <span>→</span></button>
          </div>
        </div>

        <!-- Step 8: Business needs -->
        <div class="step" data-step="7">
          <p class="step-eyebrow">Step 8 of 10</p>
          <h2 class="step-title">What does your business need most right now?</h2>
          <p class="step-hint">Select all that apply — this helps us make the room useful from day one.</p>
          <div class="need-grid" id="needTiles">
            <div class="need-tile" data-value="Capital" onclick="toggleNeed(this)">
              <div class="need-tile-label">Capital</div>
              <div class="need-tile-sub">Funding, investors, raising</div>
            </div>
            <div class="need-tile" data-value="Customers" onclick="toggleNeed(this)">
              <div class="need-tile-label">Customers</div>
              <div class="need-tile-sub">Sales, leads, distribution</div>
            </div>
            <div class="need-tile" data-value="Team" onclick="toggleNeed(this)">
              <div class="need-tile-label">Team</div>
              <div class="need-tile-sub">Key hires, culture, leadership</div>
            </div>
            <div class="need-tile" data-value="Clarity on direction" onclick="toggleNeed(this)">
              <div class="need-tile-label">Clarity</div>
              <div class="need-tile-sub">Strategy, focus, next move</div>
            </div>
            <div class="need-tile" data-value="Accountability" onclick="toggleNeed(this)">
              <div class="need-tile-label">Accountability</div>
              <div class="need-tile-sub">People to report to, stay sharp</div>
            </div>
            <div class="need-tile" data-value="Introductions" onclick="toggleNeed(this)">
              <div class="need-tile-label">Introductions</div>
              <div class="need-tile-sub">Warm doors, the right rooms</div>
            </div>
          </div>
          <div class="step-nav">
            <button type="button" class="next-btn" onclick="nextStep()">Continue <span>→</span></button>
          </div>
        </div>

        <!-- Step 9: Winning -->
        <div class="step" data-step="8">
          <p class="step-eyebrow">Step 9 of 10</p>
          <h2 class="step-title">What does winning look like for you in the next 12 months?</h2>
          <p class="step-hint">Not the 10-year vision. What's the 12-month version of things going really well?</p>
          <div class="field">
            <label for="winning">Your Answer</label>
            <textarea id="winning" placeholder="In 12 months, winning looks like…" rows="4"></textarea>
          </div>
          <div class="step-nav">
            <button type="button" class="next-btn" onclick="nextStep()">Continue <span>→</span></button>
          </div>
        </div>

        <!-- Step 10: Commitment -->
        <div class="step" data-step="9">
          <p class="step-eyebrow">Step 10 of 10</p>
          <h2 class="step-title">Last one. If we decide it's a fit, are you ready to commit?</h2>
          <p class="step-hint">Membership is a meaningful investment. We want people who are serious about being in the room — not just curious about it.</p>
          <div class="commit-grid" id="commitmentTiles">
            <div class="commit-tile" data-value="Yes, I'm ready if it's a fit" onclick="selectCommitment(this)">
              <div class="commit-dot"></div>
              <div class="commit-text">Yes — if it's the right fit, I'm ready</div>
            </div>
            <div class="commit-tile" data-value="Yes, if the fit is undeniable" onclick="selectCommitment(this)">
              <div class="commit-dot"></div>
              <div class="commit-text">Yes, if the fit is undeniable</div>
            </div>
            <div class="commit-tile" data-value="Not right now, I'm still exploring" onclick="selectCommitment(this)">
              <div class="commit-dot"></div>
              <div class="commit-text">Not right now — I'm still exploring</div>
            </div>
          </div>
          <div class="step-nav" style="flex-direction:column;align-items:flex-start;gap:12px">
            <button type="submit" class="next-btn plum" id="submitBtn">
              Submit Application <span>→</span>
            </button>
            <p style="font-family:var(--s);font-size:11px;font-weight:300;color:var(--lavender-dim);letter-spacing:1px">
              Reviewed personally · Response within 24–48 hours
            </p>
            <span class="step-error" id="formError"></span>
          </div>
        </div>

      </form>
    </div>
  </div>

  <!-- Card column -->
  <div class="card-col">
    <div class="card-inner">
      <div class="preview-card" id="previewCard">
        <div class="preview-card-top">
          <div class="preview-wordmark">Private<br>Victories<br>Club</div>
          <div class="preview-status" id="cardStatus">Drafting</div>
        </div>
        <div class="preview-mid">
          <div class="preview-name placeholder" id="cardName">Your name here</div>
          <div class="preview-biz" id="cardBiz">What are you building?</div>
        </div>
        <div class="preview-card-bottom">
          <div class="preview-revenue" id="cardRevenue">Revenue stage</div>
        </div>
        <div class="preview-wm-bg">PVC</div>
      </div>
      <p class="card-caption">Private Victories Club · Membership</p>
    </div>
  </div>

</div>

<script is:inline>
  const TOTAL = 10;
  let current = 0;
  let selectedRevenue = '';
  let selectedCommitment = '';
  let selectedNeeds = [];

  const steps      = document.querySelectorAll('.step');
  const progFill   = document.getElementById('progressFill');
  const backBtn    = document.getElementById('backBtn');
  const cardName   = document.getElementById('cardName');
  const cardBiz    = document.getElementById('cardBiz');
  const cardRev    = document.getElementById('cardRevenue');

  function setStep(n) {
    steps.forEach((s, i) => s.classList.toggle('active', i === n));
    current = n;
    const pct = Math.round(((n + 1) / TOTAL) * 100);
    progFill.style.width = pct + '%';
    backBtn.hidden = n === 0;
    window.scrollTo(0, 0);
  }

  function nextStep(skip = false) {
    if (current < TOTAL - 1) setStep(current + 1);
  }

  function prevStep() {
    if (current > 0) setStep(current - 1);
  }

  // Live card updates
  document.getElementById('name').addEventListener('input', function() {
    const v = this.value.trim();
    if (v) {
      cardName.textContent = v;
      cardName.classList.remove('placeholder');
    } else {
      cardName.textContent = 'Your name here';
      cardName.classList.add('placeholder');
    }
  });

  document.getElementById('business').addEventListener('input', function() {
    cardBiz.textContent = this.value.trim() || 'What are you building?';
  });

  function selectRevenue(tile) {
    document.querySelectorAll('#revenueTiles .tile').forEach(t => t.classList.remove('selected'));
    tile.classList.add('selected');
    selectedRevenue = tile.dataset.value;
    cardRev.textContent = tile.querySelector('.tile-value').textContent + '/mo';
    cardRev.classList.add('active');
    document.getElementById('revenueErr').classList.remove('visible');
  }

  function toggleNeed(tile) {
    tile.classList.toggle('selected');
    const v = tile.dataset.value;
    selectedNeeds = tile.classList.contains('selected')
      ? [...selectedNeeds, v]
      : selectedNeeds.filter(x => x !== v);
  }

  function selectCommitment(tile) {
    document.querySelectorAll('#commitmentTiles .commit-tile').forEach(t => t.classList.remove('selected'));
    tile.classList.add('selected');
    selectedCommitment = tile.dataset.value;
  }

  // UTM capture
  function utm() {
    const p = new URLSearchParams(window.location.search);
    return {
      utm_source:   p.get('utm_source')   || '',
      utm_medium:   p.get('utm_medium')   || '',
      utm_campaign: p.get('utm_campaign') || '',
      referrer:     document.referrer     || 'direct',
    };
  }

  // Submit
  document.getElementById('applyForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const name  = document.getElementById('name').value.trim();
    const email = document.getElementById('email').value.trim();
    const business = document.getElementById('business').value.trim();
    const prompt = document.getElementById('prompt').value.trim();
    if (!name || !email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || !business || !selectedRevenue || !prompt) {
      const errEl = document.getElementById('formError');
      errEl.textContent = 'Please go back and fill in your name, email, business, revenue, and prompt.';
      errEl.classList.add('visible');
      return;
    }

    const btn = document.getElementById('submitBtn');
    btn.disabled = true;
    btn.querySelector('span').previousSibling.textContent = 'Submitting… ';

    try {
      const res = await fetch('/api/apply/membership', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name:             document.getElementById('name').value.trim(),
          email:            document.getElementById('email').value.trim(),
          phone:            document.getElementById('phone').value.trim(),
          instagram:        document.getElementById('instagram').value.trim(),
          business:         document.getElementById('business').value.trim(),
          revenue:          selectedRevenue,
          prompt:           document.getElementById('prompt').value.trim(),
          tangible_result:  document.getElementById('tangibleResult').value.trim(),
          contribute_gain:  document.getElementById('contributeGain').value.trim(),
          working_on:       document.getElementById('workingOn').value.trim(),
          business_needs:   selectedNeeds.join(', '),
          winning_looks_like: document.getElementById('winning').value.trim(),
          commitment:       selectedCommitment,
          ...utm(),
        }),
      });

      if (!res.ok) {
        const d = await res.json().catch(() => ({}));
        throw new Error(d.error || 'Something went wrong — please try again.');
      }

      // Success
      document.getElementById('cardStatus').textContent = 'Under Review';
      document.getElementById('previewCard').classList.add('submitted');
      document.getElementById('stepsWrap').style.display = 'none';
      document.getElementById('successStep').classList.add('visible');
      window.scrollTo(0, 0);
      if (typeof (window as any).posthog !== 'undefined') {
        (window as any).posthog.capture('application_submitted', { revenue: selectedRevenue, ...utm() });
      }

    } catch (err) {
      const errEl = document.getElementById('formError');
      errEl.textContent = err.message;
      errEl.classList.add('visible');
      btn.disabled = false;
      btn.querySelector('span').previousSibling.textContent = 'Submit Application ';
    }
  });

  // PostHog
  const ph = (window as any).__PVC_PH_KEY;
  if (ph) {
    !function(t: any,e: any){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i: any,s: any,a: any){function g(t: any,e: any){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t: any){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+" people (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||(window.posthog=[]));
    (window as any).posthog.init(ph, { api_host: 'https://eu.posthog.com', capture_pageview: true });
    (window as any).posthog.capture('page_viewed', { page: 'apply', ...utm() });
  }
</script>
</body>
</html>
