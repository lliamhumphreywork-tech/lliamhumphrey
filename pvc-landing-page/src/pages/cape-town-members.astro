---
export const prerender = false;
const PS_KEY = import.meta.env.PUBLIC_PAYSTACK_KEY ?? '';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cape Town · Members Ticket · Private Victories Club</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" href="data:," />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline src="https://js.paystack.co/v1/inline.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --black: #08111f; --navy: #0a1628; --cream: #ece6da; --white: #ffffff;
      --silver: #a8b8c8; --silver-dim: #4a5666; --silver-light: #dde4ec;
      --muted: rgba(236,230,218,0.45);
    }
    html, body { min-height: 100vh; }
    body { background: var(--navy); color: var(--cream); font-family: 'DM Sans', sans-serif; font-size: 16px; line-height: 1.6; }
    .top-bar { height: 2px; background: var(--silver); }
    nav { max-width: 680px; margin: 0 auto; padding: 32px 24px 0; }
    .nav-brand { font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: var(--silver-dim); text-decoration: none; }
    .nav-brand:hover { color: var(--silver); }
    .wrap { max-width: 680px; margin: 0 auto; padding: 72px 24px 120px; }
    .eyebrow { font-size: 10px; font-weight: 500; letter-spacing: 4px; text-transform: uppercase; color: var(--silver); margin-bottom: 20px; }
    h1 { font-family: 'Syne', sans-serif; font-size: clamp(42px, 8vw, 72px); font-weight: 300; line-height: 1.0; color: var(--white); margin-bottom: 8px; }
    .tier-badge { display: inline-block; font-size: 10px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: var(--silver-dim); border: 1px solid rgba(168,184,200,0.25); padding: 5px 12px; margin-bottom: 48px; }
    .price-block { margin-bottom: 48px; padding: 36px; border: 1px solid rgba(168,184,200,0.2); background: rgba(255,255,255,0.02); }
    .price-amount { font-family: 'Syne', sans-serif; font-size: clamp(52px, 10vw, 84px); font-weight: 300; color: var(--white); line-height: 1; margin-bottom: 6px; }
    .price-note { font-size: 12px; letter-spacing: 2px; text-transform: uppercase; color: var(--silver-dim); }
    .includes { margin-bottom: 52px; }
    .includes-label { font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: var(--silver-dim); margin-bottom: 16px; }
    .includes ul { list-style: none; display: flex; flex-direction: column; gap: 12px; }
    .includes li { display: flex; align-items: flex-start; gap: 14px; font-size: 15px; color: rgba(236,230,218,0.75); }
    .includes li::before { content: '·'; color: var(--silver); flex-shrink: 0; }
    .member-note { font-size: 13px; color: var(--silver); line-height: 1.6; margin-bottom: 48px; padding: 20px 24px; border-left: 2px solid rgba(168,184,200,0.3); }
    .price-was { font-size: 13px; color: var(--silver-dim); text-decoration: line-through; margin-bottom: 4px; }
    .divider { height: 1px; background: rgba(168,184,200,0.15); margin-bottom: 48px; }
    .form-label { display: block; font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: var(--silver-dim); margin-bottom: 10px; }
    .form-field { margin-bottom: 24px; }
    input { width: 100%; background: rgba(255,255,255,0.04); border: 1px solid rgba(168,184,200,0.25); color: var(--cream); font-family: 'DM Sans', sans-serif; font-size: 15px; padding: 14px 16px; outline: none; transition: border-color 0.2s; -webkit-appearance: none; }
    input:focus { border-color: var(--silver); }
    input::placeholder { color: var(--silver-dim); }
    .pay-btn { display: flex; align-items: center; justify-content: center; width: 100%; background: var(--silver); color: var(--black); font-family: 'DM Sans', sans-serif; font-size: 12px; font-weight: 600; letter-spacing: 2.5px; text-transform: uppercase; padding: 18px 40px; border: none; cursor: pointer; transition: background 0.2s, transform 0.15s; margin-top: 8px; }
    .pay-btn:hover:not(:disabled) { background: var(--silver-light); transform: translateY(-1px); }
    .pay-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .error-msg { display: none; margin-top: 16px; padding: 14px 16px; background: rgba(200,80,80,0.1); border: 1px solid rgba(200,80,80,0.3); color: #e09090; font-size: 14px; }
    .success-state { display: none; text-align: center; padding: 64px 0; }
    .success-icon { font-family: 'Syne', sans-serif; font-size: 60px; font-weight: 300; color: var(--silver); margin-bottom: 24px; }
    .success-state h2 { font-family: 'Syne', sans-serif; font-size: 36px; font-weight: 300; color: var(--white); margin-bottom: 12px; }
    .success-state p { color: var(--muted); font-size: 15px; }
    footer { max-width: 680px; margin: 0 auto; padding: 32px 24px; border-top: 1px solid rgba(168,184,200,0.1); font-size: 11px; color: var(--silver-dim); letter-spacing: 1px; }
    footer a { color: var(--silver-dim); text-decoration: none; }
    footer a:hover { color: var(--silver); }
  </style>
</head>
<body>
<div class="top-bar"></div>
<nav><a href="/" class="nav-brand">Private Victories Club</a></nav>
<div class="wrap">
  <div class="eyebrow">Cape Town · Private Dinner</div>
  <h1>Members<br />Ticket</h1>
  <div class="tier-badge">Existing Members</div>

  <div class="price-block">
    <div class="price-was">R4,000 standard price</div>
    <div class="price-amount">R2,000</div>
    <div class="price-note">One-time · Members discount · Cape Town event</div>
  </div>

  <div class="member-note">
    As an existing PVC member you get 50% off the General Admission price. Everything included is the same. This is your seat at the same table.
  </div>

  <div class="includes">
    <div class="includes-label">What's included</div>
    <ul>
      <li>Full mastermind access</li>
      <li>All 3 mastermind sessions</li>
      <li>Private dinner</li>
      <li>Keepsakes</li>
    </ul>
  </div>

  <div class="divider"></div>

  <div id="form-section">
    <div class="form-field">
      <label class="form-label" for="name">Full Name</label>
      <input type="text" id="name" placeholder="Your name" autocomplete="name" />
    </div>
    <div class="form-field">
      <label class="form-label" for="email">Email Address</label>
      <input type="email" id="email" placeholder="your@email.com" autocomplete="email" />
    </div>
    <button class="pay-btn" id="pay-btn">Pay R2,000 · Secure Checkout</button>
    <div class="error-msg" id="error-msg"></div>
  </div>

  <div class="success-state" id="success-state">
    <div class="success-icon">✓</div>
    <h2>You're In.</h2>
    <p>Ticket confirmed. Check your inbox for details.</p>
  </div>
</div>
<footer><a href="/legal">Terms &amp; Conditions</a> · <a href="/legal#privacy">Privacy Policy</a> · <a href="/legal#refunds">Refund Policy</a></footer>

<script is:inline define:vars={{ PS_KEY }}>
  if (window.location.search.includes('success=1')) {
    document.getElementById('form-section').style.display = 'none';
    document.getElementById('success-state').style.display = 'block';
  }
  document.getElementById('pay-btn').addEventListener('click', function () {
    const name  = document.getElementById('name').value.trim();
    const email = document.getElementById('email').value.trim();
    document.getElementById('error-msg').style.display = 'none';
    if (!name)  { showError('Please enter your full name.'); return; }
    if (!email || !email.includes('@')) { showError('Please enter a valid email address.'); return; }
    var handler = PaystackPop.setup({
      key: PS_KEY,
      email: email,
      amount: 200000,
      currency: 'ZAR',
      ref: 'pvc_mem_' + Date.now(),
      metadata: { name: name, item_name: 'Cape Town Event: Members Ticket' },
      callback: function () {
        window.location.href = '/cape-town-welcome?tier=members';
      },
      onClose: function () {},
    });
    handler.openIframe();
  });
  function showError(msg) { var el = document.getElementById('error-msg'); el.textContent = msg; el.style.display = 'block'; }
</script>
</body>
</html>
