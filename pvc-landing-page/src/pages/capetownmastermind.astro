---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
const PH_KEY = import.meta.env.PUBLIC_POSTHOG_KEY ?? '';

const NOISE = (id: string) => `
  <filter id="${id}"><feTurbulence type="fractalNoise" baseFrequency="0.7" numOctaves="3" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter>
  <rect width="100%" height="100%" filter="url(#${id})"/>
`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cape Town Mastermind · Private Victories Club</title>
  <meta name="description" content="One day. Multiple entrepreneurs who've actually done it. An experience built for founders scaling. Cape Town · Saturday 10 October." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet" />
  <Analytics />
  {PH_KEY && <script define:vars={{ PH_KEY }}>
    !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+" people (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||(window.posthog=[]));
    posthog.init(PH_KEY, {api_host: 'https://eu.posthog.com', capture_pageview: true});
  </script>}
</head>
<body>

<!-- NAV -->
<nav id="nav" class="dinner-nav">
  <a href="https://privatevictoriesclub.com" class="nav-logo">
    <div class="nav-lock-1">Private Victories · Cape Town Mastermind</div>
  </a>
  <a href="#tickets" class="cta-btn scroll-to-tickets nav-apply">Apply for a Seat</a>
</nav>

<!-- HERO -->
<section class="ct-hero">
  <div class="ct-hero-photo">
    <img src="/images/ct-promenade.jpg" alt="Cape Town at dawn" />
  </div>
  <div class="ct-hero-overlay"></div>
  <svg class="noise-layer" xmlns="http://www.w3.org/2000/svg" style="z-index:2" set:html={NOISE('ct1')} />
  <div class="ct-hero-inner">
    <h1 class="ct-title reveal d1">Cape<br /><em class="ct-title-em">Town</em></h1>
    <div class="ct-three reveal d2">
      <p>One day.</p>
      <p>Multiple entrepreneurs who've actually done it.</p>
      <p>An experience built for founders scaling.</p>
    </div>
    <p class="ct-date reveal d3">Saturday, October 10th</p>
    <a href="#tickets" class="cta-btn scroll-to-tickets reveal d4">Apply for a Seat</a>
    <p class="cta-note reveal d4">Spots are limited. Applications reviewed manually.</p>
  </div>
</section>

<!-- COUNTDOWN -->
<section class="ct-countdown-bar">
  <div class="ct-countdown-inner">
    <div class="ct-countdown-label">Cape Town · Oct 10, 2026</div>
    <div class="ct-countdown-units" id="ct-countdown">
      <div class="ct-cd-unit"><span class="ct-cd-num" id="cd-days">--</span><span class="ct-cd-lbl">Days</span></div>
      <div class="ct-cd-sep">:</div>
      <div class="ct-cd-unit"><span class="ct-cd-num" id="cd-hours">--</span><span class="ct-cd-lbl">Hours</span></div>
      <div class="ct-cd-sep">:</div>
      <div class="ct-cd-unit"><span class="ct-cd-num" id="cd-mins">--</span><span class="ct-cd-lbl">Minutes</span></div>
      <div class="ct-cd-sep">:</div>
      <div class="ct-cd-unit"><span class="ct-cd-num" id="cd-secs">--</span><span class="ct-cd-lbl">Seconds</span></div>
    </div>
  </div>
</section>

<!-- THE PREMISE -->
<section class="ct-section ct-premise">
  <div class="ct-inner">
    <div class="ct-label reveal">The Premise</div>
    <p class="ct-premise-lead reveal d1">Not just your regular networking event.</p>
    <p class="ct-premise-body reveal d2">A real mastermind, multiple entrepreneurs who've built real revenue, a structured session where you work through your actual bottleneck alongside other serious founders, and an evening where the real relationships get built.</p>
    <div class="ct-proof reveal d3">
      <div class="ct-proof-block">
        <div class="ct-proof-stat">172</div>
        <div class="ct-proof-label">applications</div>
      </div>
      <div class="ct-proof-divider"></div>
      <div class="ct-proof-block">
        <div class="ct-proof-stat">15</div>
        <div class="ct-proof-label">seats</div>
      </div>
      <div class="ct-proof-divider"></div>
      <figure class="ct-proof-quote-wrap">
        <p class="ct-proof-quote">"I've been to networking events before. All of them were terrible. This is different."</p>
        <figcaption class="ct-proof-cite">Sachin Moodley · Founder, Revolution Rise Media</figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- VIDEO BREAK: founding dinner clips -->
<div class="ct-video-break">
  <div class="ct-video-strip">
    <video autoplay muted loop playsinline>
      <source src="/videos/dinner-conversation.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="ct-video-strip">
    <video autoplay muted loop playsinline>
      <source src="/videos/dinner-energy.mp4" type="video/mp4" />
    </video>
    <div class="ct-video-caption">The Founding Dinner · Rosebank · August 2026</div>
  </div>
</div>

<!-- WHO THIS IS FOR -->
<section class="ct-section ct-who">
  <div class="ct-inner">
    <div class="ct-label reveal">Who This Is For</div>
    <p class="ct-who-lead reveal d1">Founders already building something real.</p>
    <p class="ct-qualifier reveal d2">R10k/month minimum. Not people still deciding if they should start. People who are in motion and want to move faster.</p>
    <ul class="ct-who-list">
      <li class="reveal d2" data-num="01">You have a specific bottleneck holding you back.</li>
      <li class="reveal d3" data-num="02">You want honest input from people who've been there.</li>
      <li class="reveal d4" data-num="03">You believe the right room changes your trajectory and opens doors you didn't have access to before.</li>
