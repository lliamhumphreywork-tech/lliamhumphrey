  }

  /* ── PREMISE ── */
  .ct-premise-lead {
    font-size: clamp(28px, 4vw, 56px); font-weight: 700; letter-spacing: -1.5px;
    color: var(--white); line-height: 1.05; margin-bottom: 28px;
  }
