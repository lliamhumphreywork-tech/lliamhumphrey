    width: 100%; height: 100%; object-fit: cover; object-position: 50% 35%;
    transform: scale(1.04); transition: transform 6s cubic-bezier(0.16,1,0.3,1);
  }
  .ct-hero-photo img.loaded { transform: scale(1); }
  .ct-hero-overlay {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(to bottom, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.1) 30%, rgba(0,0,0,0.82) 100%);
