</section>

<!-- STATEMENT -->
<section class="ct-section ct-statement">
  <svg class="noise-layer" xmlns="http://www.w3.org/2000/svg" style="z-index:2" set:html={NOISE('ct2')} />
  <div class="ct-inner ct-statement-inner">
    <h2 class="ct-statement-head reveal">Imagine being in a room full of entrepreneurs who've already solved, and are currently solving, the exact problems you're dealing with.</h2>
    <p class="ct-statement-sub reveal d1">That's what this event is. Real founders. Real problems. Real progress.</p>
  </div>
</section>

<!-- SPEAKERS -->
<section class="ct-section ct-speakers">
  <div class="ct-inner">
    <div class="ct-label reveal">The Speakers</div>
    <p class="ct-speakers-intro reveal d1">Multiple entrepreneurs. Multiple different lanes. Real numbers behind every one of them.</p>
