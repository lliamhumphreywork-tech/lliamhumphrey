    <div class="pvc-modal-eyebrow">Cape Town Mastermind &middot; Friday 2 October</div>
    <h2 class="pvc-modal-title">Apply for a Seat</h2>
    <div class="pvc-modal-tiers">
      <div class="pvc-modal-tier">
