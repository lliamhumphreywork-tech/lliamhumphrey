      <div class="ct-speaker reveal d2" style="--accent-op:0.2">
        <div class="ct-speaker-ghost" aria-hidden="true">N</div>
        <img src="/images/noah.jpg" alt="Noah Kerchhoff" class="ct-speaker-photo" style="object-position: center 70%;" />
        <div class="ct-speaker-inner">
          <div class="ct-speaker-name">Noah Kerchhoff</div>
          <div class="ct-speaker-stat">$57k</div>
          <div class="ct-speaker-context">in 5 months</div>
          <p class="ct-speaker-desc">Generated $57k in 5 months in clothing manufacturing. The person to talk to about product, operations, and speed.</p>
        </div>
      </div>
      <div class="ct-speaker reveal d3" style="--accent-op:0.5">
        <div class="ct-speaker-ghost" aria-hidden="true">N</div>
        <img src="/images/niyaaz.jpg" alt="Niyaaz" class="ct-speaker-photo" />
        <div class="ct-speaker-inner">
          <div class="ct-speaker-name">Niyaaz Solomon</div>
          <div class="ct-speaker-stat">$25k to $107k</div>
          <div class="ct-speaker-context">per month</div>
          <p class="ct-speaker-desc">Scaled a high-ticket coaching business from $25k to $107k a month. If you sell services or coaching, pay attention.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PHOTO BREAK 2: Cape Town coastline -->
<div class="ct-photo-break">
  <img src="/images/ct-clifton.jpg" alt="Camps Bay, Cape Town" style="object-position: 50% 60%;" />
  <div class="ct-photo-break-overlay"></div>
  <div class="ct-photo-break-caption">Camps Bay · Cape Town</div>
</div>

<!-- PHOTO BREAK 3: Cape Town evening -->
<div class="ct-photo-break ct-photo-break-tall">
  <img src="/images/ct-night-event.jpg" alt="Cape Town at night" style="object-position: 50% 50%;" />
  <div class="ct-photo-break-overlay"></div>
  <div class="ct-photo-break-caption">Cape Town · The Atlantic Seaboard</div>
</div>

<!-- THE DAY -->
<section class="ct-section ct-day">
  <div class="ct-inner">
    <div class="ct-label reveal">The Day</div>
    <ol class="ct-schedule">
      <li class="ct-schedule-item reveal d1">
        <div class="ct-schedule-tag">VIP Hour</div>
        <div class="ct-schedule-desc">All VIPs and both speakers working through real bottlenecks together as a group.</div>
      </li>
      <li class="ct-schedule-item reveal d2">
        <div class="ct-schedule-tag">Mastermind</div>
        <div class="ct-schedule-desc">Three individual mastermind sessions. Real knowledge and insight in the game of business, to help you scale.</div>
      </li>
      <li class="ct-schedule-item reveal d3">
        <div class="ct-schedule-tag">Closing</div>
        <div class="ct-schedule-desc">Why we're building this, and what's next for Private Victories.</div>
      </li>
      <li class="ct-schedule-item reveal d4">
        <div class="ct-schedule-tag">Dinner</div>
        <div class="ct-schedule-desc">A private dinner. Real conversation, real connection.</div>
      </li>
    </ol>
    <p class="ct-day-note reveal d5">Every ticket includes 30 days of complimentary Private Victories membership.</p>
  </div>
</section>

<!-- TICKETS -->
<section id="tickets" class="ct-tickets-section">
  <svg class="noise-layer" xmlns="http://www.w3.org/2000/svg" style="z-index:2" set:html={NOISE('ct3')} />
  <div class="ct-tickets-inner">
    <div class="ct-tickets-head">
      <div class="ct-label reveal" style="max-width:900px;margin:0 auto 16px;">Apply for a Seat</div>
      <p class="ct-tickets-note reveal d1">Spots are limited and reviewed manually. Choose your tier and apply below.</p>
      <div class="ct-social-proof reveal d2">
        <span class="ct-proof-dot"></span>
        People are confirming seats right now. Oct 10 is 23 days away.
      </div>
    </div>
    <div class="ct-tiers reveal d2">
      <!-- GA -->
      <div class="ct-tier">
        <div class="ct-tier-left">
          <div class="ct-tier-badge">General Admission</div>
          <div class="ct-tier-room">TICKET 01.</div>
          <div class="ct-tier-hint">Apply.</div>
          <div class="ct-tier-wm" aria-hidden="true">PVC</div>
        </div>
        <div class="ct-tier-right">
          <ul class="ct-tier-list">
            <li><span class="ct-tier-check">·</span>Full mastermind access</li>
            <li><span class="ct-tier-check">·</span>Full event shot and captured</li>
            <li><span class="ct-tier-check">·</span>Private dinner</li>
            <li><span class="ct-tier-check">·</span>Keepsakes</li>
            <li><span class="ct-tier-check">·</span>30-day PVC membership</li>
          </ul>
          <div class="ct-tier-cta-row">
            <a href="#" class="cta-btn apply-trigger ct-tier-apply-btn" data-tier="General Admission">Apply Now</a>
            <span class="ct-tier-meta">Reviewed manually</span>
          </div>
        </div>
      </div>
      <!-- VIP -->
      <div class="ct-tier ct-tier-vip">
        <div class="ct-tier-left ct-tier-left-vip">
          <div class="ct-tier-badge ct-tier-badge-vip">VIP Experience</div>
          <div class="ct-tier-room ct-tier-room-vip">TICKET 02.</div>
          <div class="ct-tier-hint ct-tier-hint-vip">3 seats only.</div>
          <div class="ct-tier-wm ct-tier-wm-vip" aria-hidden="true">PVC</div>
        </div>
        <div class="ct-tier-right ct-tier-right-vip">
          <ul class="ct-tier-list ct-tier-list-vip">
            <li><span class="ct-tier-check">·</span>Everything in General Admission</li>
            <li><span class="ct-tier-check">·</span>Shared VIP hour with both speakers</li>
            <li><span class="ct-tier-check">·</span>Full event shot and captured</li>
            <li><span class="ct-tier-check">·</span>A dedicated one-on-one content moment with each speaker, captured by our team, real personal footage for your own brand</li>
            <li><span class="ct-tier-check">·</span>First access to future Private Victories events, before they're announced publicly</li>
          </ul>
          <div class="ct-tier-cta-row ct-tier-cta-row-vip">
            <a href="#" class="cta-btn apply-trigger" data-tier="VIP Admission">Apply Now</a>
            <span class="ct-tier-meta ct-tier-meta-vip">Reviewed manually</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- VVIP -->
<section class="ct-vvip-section">
  <div class="ct-vvip-inner">
    <div class="ct-vvip-label reveal">VVIP</div>
    <p class="ct-vvip-heading reveal d1">The full concierge experience.</p>
    <p class="ct-vvip-body reveal d2">Everything in the event: every session, every speaker, the private dinner. Plus a curated Day 3 activity and full concierge treatment from arrival to departure. Designed for a very small number of people who want the complete experience built around them. Serious inquiries only.</p>
    <a href="https://www.instagram.com/lliam.humphrey/" class="ct-vvip-btn reveal d3" target="_blank" rel="noopener">Contact Directly</a>
  </div>
</section>

<!-- CLOSE -->
<section class="ct-section ct-close">
  <svg class="noise-layer" xmlns="http://www.w3.org/2000/svg" style="z-index:2" set:html={NOISE('ct4')} />
  <div class="ct-inner ct-close-inner">
    <p class="ct-close-quote reveal">The wins you have in public are proportionate to the victories you have in private.</p>
    <a href="#tickets" class="cta-btn scroll-to-tickets reveal d1">Apply for a Seat</a>
    <p class="cta-note reveal d2">Spots are limited. Applications reviewed manually.</p>
  </div>
</section>

<!-- APPLICATION MODAL -->
<div id="applyModal" class="pvc-modal" aria-hidden="true">
  <div class="pvc-modal-overlay" id="modalOverlay"></div>
  <div class="pvc-modal-panel">
    <button class="pvc-modal-close" id="modalClose" aria-label="Close">&times;</button>
    <div class="pvc-modal-eyebrow">Cape Town Mastermind &middot; Saturday 10 October</div>
    <h2 class="pvc-modal-title">Apply for a Seat</h2>
    <div class="pvc-modal-form">
      <iframe data-tally-src="https://tally.so/r/J94gk4?transparentBackground=1&dynamicHeight=1" loading="lazy" width="100%" height="500" frameborder="0" marginheight="0" marginwidth="0" title="Cape Town Mastermind Application"></iframe>
      <script async src="https://tally.so/widgets/embed.js"></script>
    </div>
  </div>
</div>

<!-- FOOTER -->
<footer class="d-footer">
  <div class="footer-lock">
    <div class="footer-mark">PVC</div>
    <div class="footer-name">Private Victories Club</div>
  </div>
  <div class="footer-handle"><a href="https://instagram.com/privatevictories.club" target="_blank" rel="noopener">@privatevictories.club</a> · Built in Africa</div>
  <div class="footer-copy">© MMXXVI · Build in private. Win in public.</div>
</footer>

<script>
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

  const nav = document.getElementById('nav');
  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 60);
  window.addEventListener('scroll', onScroll);
  onScroll();

  setTimeout(() => {
    document.querySelectorAll('.ct-hero .reveal').forEach((el) => el.classList.add('visible'));
  }, 120);

  const heroImg = document.querySelector('.ct-hero-photo img') as HTMLImageElement;
  if (heroImg) {
    const trigger = () => heroImg.classList.add('loaded');
    heroImg.complete ? trigger() : heroImg.addEventListener('load', trigger);
  }

  // Scroll-to-tickets links
  document.querySelectorAll('.scroll-to-tickets').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      document.getElementById('tickets')?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  // Apply modal
  const modal = document.getElementById('applyModal');
  const modalOverlay = document.getElementById('modalOverlay');
  const modalClose = document.getElementById('modalClose');

  const openModal = (e: Event) => {
    e.preventDefault();
    const tier = (e.currentTarget as HTMLElement)?.dataset?.tier ?? 'unknown';
    modal?.classList.add('open');
    document.body.style.overflow = 'hidden';
    if (typeof (window as any).Tally !== 'undefined') (window as any).Tally.loadEmbeds();
    (window as any).posthog?.capture('apply_modal_opened', { page: 'cape-town-mastermind', tier });
  };
  const closeModal = () => { modal?.classList.remove('open'); document.body.style.overflow = ''; };

  document.querySelectorAll('.apply-trigger').forEach((btn) => btn.addEventListener('click', openModal));
  modalOverlay?.addEventListener('click', closeModal);
  modalClose?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  // Countdown to Oct 10 2026 14:00 SAST (UTC+2)
  const eventDate = new Date('2026-10-10T12:00:00Z');
  function updateCountdown() {
    const diff = eventDate - Date.now();
    if (diff <= 0) {
      ['cd-days','cd-hours','cd-mins','cd-secs'].forEach(id => { const el = document.getElementById(id); if (el) el.textContent = '00'; });
      return;
    }
    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    const pad = (n) => String(n).padStart(2, '0');
    const days = document.getElementById('cd-days'); if (days) days.textContent = pad(d);
    const hours = document.getElementById('cd-hours'); if (hours) hours.textContent = pad(h);
    const mins = document.getElementById('cd-mins'); if (mins) mins.textContent = pad(m);
    const secs = document.getElementById('cd-secs'); if (secs) secs.textContent = pad(s);
  }
  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>

<style>
  /* ── COUNTDOWN BAR ── */
  .ct-countdown-bar { background: var(--pure-black); border-top: 1px solid rgba(168,184,200,0.15); border-bottom: 1px solid rgba(168,184,200,0.15); padding: 52px 24px; }
  .ct-countdown-inner { max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 20px; text-align: center; }
  .ct-countdown-label { font-size: 10px; letter-spacing: 4px; text-transform: uppercase; color: var(--silver-dim); }
  .ct-countdown-units { display: flex; align-items: flex-start; gap: 0; }
  .ct-cd-unit { display: flex; flex-direction: column; align-items: center; padding: 0 20px; border-right: 1px solid rgba(168,184,200,0.12); }
  .ct-cd-unit:last-child { border-right: none; }
  .ct-cd-num { font-family: 'Syne', sans-serif; font-size: clamp(52px, 10vw, 96px); font-weight: 300; color: var(--pure-white); line-height: 1; }
  .ct-cd-lbl { font-size: 9px; letter-spacing: 3px; text-transform: uppercase; color: var(--silver-dim); margin-top: 10px; }
  .ct-cd-sep { display: none; }
  /* ── SOCIAL PROOF ── */
  .ct-social-proof { display: inline-flex; align-items: center; gap: 10px; font-size: 13px; color: var(--silver-dim); margin-top: 20px; }
  .ct-proof-dot { width: 7px; height: 7px; border-radius: 50%; background: #4ade80; flex-shrink: 0; animation: proof-pulse 2s ease-in-out infinite; }
  @keyframes proof-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
  /* ── HERO ── */
  .ct-hero {
    min-height: 88vh; background: var(--pure-black); display: flex; align-items: flex-end;
    padding: 80px 80px 96px; position: relative; overflow: hidden;
  }
  .ct-hero::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--silver); z-index: 10; }
  .ct-hero-photo { position: absolute; inset: 0; z-index: 0; }
  .ct-hero-photo img {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 35%;
    transform: scale(1.04); transition: transform 6s cubic-bezier(0.16,1,0.3,1);
    filter: contrast(1.08) saturate(0.88);
  }
  .ct-hero-photo img.loaded { transform: scale(1); }
  .ct-hero-overlay {
    position: absolute; inset: 0; z-index: 1;
    background:
      linear-gradient(to bottom, rgba(0,0,0,0.18) 0%, rgba(0,0,0,0.05) 25%, rgba(0,0,0,0.88) 100%),
      linear-gradient(to right, rgba(0,0,0,0.35) 0%, transparent 60%);
  }
  .ct-hero-inner { position: relative; z-index: 3; max-width: 980px; width: 100%; }

  .ct-eyebrow {
    font-size: 10px; font-weight: 600; letter-spacing: 5px; text-transform: uppercase;
    color: var(--white); margin-bottom: 24px;
  }
  .ct-title {
    font-family: var(--g); font-size: clamp(72px, 12vw, 160px); font-weight: 800;
    letter-spacing: -4px; line-height: 0.88; text-transform: uppercase; color: var(--white); margin-bottom: 36px;
  }
  .ct-title-em {
    font-family: var(--g); font-style: normal; font-weight: 400;
    font-size: clamp(80px, 13vw, 176px); letter-spacing: -5px; color: rgba(221,228,236,0.75); text-transform: none;
  }
  .ct-three { margin-bottom: 28px; }
  .ct-three p {
    font-family: var(--s); font-style: normal; font-weight: 300;
    font-size: clamp(16px, 2vw, 26px); color: rgba(168,184,200,0.65); line-height: 1.7; margin: 0;
    letter-spacing: 0.2px;
