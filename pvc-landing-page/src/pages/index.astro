  const stored = localStorage.getItem(CONSENT_KEY);
  if (stored === 'accepted') {
    loadTracking();
  } else if (!stored) {
    setTimeout(() => { cookieBanner?.removeAttribute('aria-hidden'); cookieBanner?.classList.add('visible'); }, 1800);
  }

  cookieAccept?.addEventListener('click', () => {
    localStorage.setItem(CONSENT_KEY, 'accepted');
    cookieBanner?.classList.remove('visible');
    loadTracking();
  });
  cookieDecline?.addEventListener('click', () => {
    localStorage.setItem(CONSENT_KEY, 'declined');
    cookieBanner?.classList.remove('visible');
  });

  // Meta Pixel — fire CompleteRegistration when Tally membership form submits
  window.addEventListener('message', (e: MessageEvent) => {
    if (e.data?.event === 'Tally.FormSubmitted' || e.data?.name === 'tally-form-submitted') {
      if (typeof (window as any).fbq !== 'undefined') {
        (window as any).fbq('track', 'CompleteRegistration');
      }
    }
  });

  // FAQ accordion
  document.querySelectorAll('.faq-question').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const open = item?.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(!!open));
      const icon = btn.querySelector('.faq-icon');
      if (icon) icon.textContent = open ? '−' : '+';
    });
  });
