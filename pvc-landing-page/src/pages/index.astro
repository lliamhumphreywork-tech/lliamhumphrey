---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
const PH_KEY = import.meta.env.PUBLIC_POSTHOG_KEY ?? '';

const NOISE = (id: string) => `
  <filter id="${id}"><feTurbulence type="fractalNoise" baseFrequency="0.7" numOctaves="3" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter>
  <rect width="100%" height="100%" filter="url(#${id})"/>
`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Private Victories Club · Build in private. Win in public.</title>
  <meta name="description" content="A private network for founders building real businesses in Africa. Round tables, in-person experiences and warm introductions. By application only." />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet" />
  <Analytics />
  <script define:vars={{ PH_KEY }} is:inline>window.__PVC_PH_KEY = PH_KEY;</script>
</head>
<body>

<!-- NAV -->
<nav id="nav">
  <a href="#hero" class="nav-logo">
    <div class="nav-mark"><img src="/images/pvc-v-mark-white-clean.svg" alt="PVC" /></div>
    <div class="nav-lock">
      <div class="nav-lock-1">Private Victories</div>
      <div class="nav-lock-2">A private network for founders building real businesses.</div>
    </div>
  </a>
  <a href="#access" class="nav-apply scroll-to-membership">Apply for Membership</a>
</nav>

<!-- ═══ HERO ═══ -->
<section id="hero" data-screen-label="Hero">
  <div class="hero-top-bar"></div>
  <div class="hero-bg">
    <img src="/images/hero-bg.jpg" alt="PVC members at the Cape Town Mastermind" />
    <div class="hero-overlay"></div>
    <svg class="noise-layer" xmlns="http://www.w3.org/2000/svg" set:html={NOISE('n1')} />
  </div>

  <div class="hero-content">
    <div class="hero-eyebrow reveal">A Private Entrepreneurial Network</div>
    <h1 class="hero-title reveal d1">PRIVATE<br />VICTORIES<br /><span class="lt">CLUB</span></h1>
    <p class="hero-tagline reveal d2">Build in private. Win in public.</p>
    <p class="hero-line reveal d3">A private network for founders building real businesses in Africa. Round tables, in-person experiences and warm introductions.</p>
    <a href="#access" class="cta-btn reveal d4 scroll-to-membership">Apply for Membership</a>
    <div class="cta-note reveal d4">By application only.</div>
  </div>

  <div class="hero-float-card">
    <div class="hero-float-eyebrow">The premise</div>
    <div class="hero-float-text">The room you're in determines how far you go. The right people show you what's possible and make you push harder.</div>
  </div>

  <div class="hero-scroll reveal d5">
    <span>Scroll</span>
    <div class="hero-scroll-line"></div>
  </div>
</section>

<!-- ═══ INDUSTRY TICKER ═══ -->
<div class="industry-ticker">
  <div class="ticker-label">Industries represented</div>
  <div class="ticker-overflow">
    <div class="ticker-track">
      <span class="ticker-item">E-Commerce</span><span class="ticker-dot">·</span>
      <span class="ticker-item">Property</span><span class="ticker-dot">·</span>
      <span class="ticker-item">Sales</span><span class="ticker-dot">·</span>
      <span class="ticker-item">Content &amp; Media</span><span class="ticker-dot">·</span>
      <span class="ticker-item">AI</span><span class="ticker-dot">·</span>
      <span class="ticker-item">Consulting</span><span class="ticker-dot">·</span>
      <span class="ticker-item">Marketing</span><span class="ticker-dot">·</span>
      <span class="ticker-item">Info Products</span><span class="ticker-dot">·</span>
      <!-- duplicate for seamless loop -->
      <span class="ticker-item">E-Commerce</span><span class="ticker-dot">·</span>
      <span class="ticker-item">Property</span><span class="ticker-dot">·</span>
      <span class="ticker-item">Sales</span><span class="ticker-dot">·</span>
      <span class="ticker-item">Content &amp; Media</span><span class="ticker-dot">·</span>
      <span class="ticker-item">AI</span><span class="ticker-dot">·</span>
      <span class="ticker-item">Consulting</span><span class="ticker-dot">·</span>
      <span class="ticker-item">Marketing</span><span class="ticker-dot">·</span>
      <span class="ticker-item">Info Products</span><span class="ticker-dot">·</span>
    </div>
  </div>
</div>

<!-- ═══ 01 · THE PREMISE ═══ -->
<section id="premise" data-screen-label="01 Premise">
  <svg class="noise-layer" xmlns="http://www.w3.org/2000/svg" set:html={NOISE('n2')} />
  <div class="premise-inner">
    <div class="premise-left">
      <div class="section-label reveal"><span class="section-num">01</span> The Premise</div>
      <h2 class="premise-headline reveal d1"><span class="strike">Not a course.</span> <span class="strike">Not a crowd.</span> A private <em class="serif">network.</em></h2>
      <div class="premise-body">
        <p class="reveal d2">A private network for founders who are actively building something real. The network, the calls and the in-person experiences exist to support what you are already doing and put you around people who understand the journey. Every member is reviewed and has a conversation with us before joining.</p>
      </div>
    </div>
    <div class="premise-stats">
      <div class="premise-stat reveal d1">
        <div class="premise-stat-val">R20k+</div>
        <div class="premise-stat-text"><b>Minimum monthly revenue.</b> You're already in motion. PVC puts you in the right room.</div>
      </div>
      <div class="premise-stat reveal d2">
        <div class="premise-stat-val accent">In person</div>
        <div class="premise-stat-text">Curated events across South Africa and beyond — dinners, masterminds and retreats.</div>
      </div>
      <div class="premise-stat reveal d3">
        <div class="premise-stat-val">Reviewed</div>
        <div class="premise-stat-text">Every application is read by a person. <b>Everyone in the room is there for a reason.</b></div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 02 · THE THREE PILLARS ═══ -->
<section id="pillars" data-screen-label="02 Pillars">
  <div class="pillars-header">
    <div class="section-label reveal"><span class="section-num">02</span> What PVC is built on</div>
    <h2 class="pillars-headline reveal d1">Three layers<br />of membership.</h2>
  </div>

  <!-- The Network -->
  <div class="pillar-row reveal">
    <div class="pillar-photo-frame">
      <img src="/images/dinner-cam-connect.jpg" alt="Two PVC founders connecting at the founding dinner" />
      <div class="pillar-photo-overlay">
        <span class="pillar-photo-location">FOUNDING DINNER · CAPE TOWN</span>
        <span class="pillar-photo-num">01 / 03 · THE NETWORK</span>
      </div>
    </div>
    <div class="pillar-row-main">
      <div class="pillar-title-block">
        <span class="pillar-display-title">The Network</span>
        <em class="pillar-subtitle">The Community</em>
      </div>
      <div class="pillar-meta-line">MEMBERS-ONLY · PRIVATE COMMUNITY</div>
      <h3 class="pillar-subheading">The room answers in minutes</h3>
      <p class="pillar-body-text">A private, curated community of founders who are building and scaling their businesses. Active every day, with warm introductions on joining and a monthly round table where members put their business on the table and the room works on it.</p>
      <div class="pillar-pills">
        <span class="pillar-pill">Members-only community</span>
        <span class="pillar-pill">Round tables</span>
        <span class="pillar-pill">Warm introductions</span>
      </div>
    </div>
    <div class="pillar-row-right">
      <div class="pillar-right-group">
        <div class="pillar-right-label">EVERY DAY</div>
        <div class="pillar-right-item">
          <div class="pillar-right-item-title">Members-only community</div>
          <div class="pillar-right-item-desc">Active threads. Real conversations around the clock.</div>
        </div>
      </div>
      <div class="pillar-right-group">
        <div class="pillar-right-label">ON JOINING</div>
        <div class="pillar-right-item">
          <div class="pillar-right-item-title">Warm introductions</div>
          <div class="pillar-right-item-desc">Mapped from your onboarding to the right people.</div>
        </div>
      </div>
      <div class="pillar-right-group">
        <div class="pillar-right-label">MONTHLY</div>
        <div class="pillar-right-item">
          <div class="pillar-right-item-title">Round tables</div>
          <div class="pillar-right-item-desc">Members bring a real problem. The room works through it and shows who can help.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- The Experience -->
  <div class="pillar-row reveal">
    <div class="pillar-photo-frame">
      <img src="/images/pillar-experience.jpg" alt="PVC members at Cape Town D Classic" />
      <div class="pillar-photo-overlay">
        <span class="pillar-photo-location">D CLASSIC · CAPE TOWN</span>
        <span class="pillar-photo-num">02 / 03 · THE EXPERIENCE</span>
      </div>
    </div>
    <div class="pillar-row-main">
      <div class="pillar-title-block">
        <span class="pillar-display-title">The Experience</span>
        <em class="pillar-subtitle">The Events</em>
      </div>
      <div class="pillar-meta-line">FOUNDER DINNERS · MASTERMINDS · MEMBER RETREATS</div>
      <h3 class="pillar-subheading">The network, in person</h3>
      <p class="pillar-body-text">Founder dinners where the network meets in person. Masterminds to give you insights on scaling to the next level. Retreats where you can experience, explore, and build the relationships that compound.</p>
      <div class="pillar-pills">
        <span class="pillar-pill">Founders' dinners</span>
        <span class="pillar-pill">Expert masterminds</span>
        <span class="pillar-pill">Member retreats</span>
      </div>
    </div>
    <div class="pillar-row-right">
      <div class="pillar-right-group">
        <div class="pillar-right-label">IN PERSON</div>
        <div class="pillar-right-item">
          <div class="pillar-right-item-title">Founder dinners</div>
          <div class="pillar-right-item-desc">Intimate tables. Real conversation.</div>
        </div>
      </div>
      <div class="pillar-right-group">
        <div class="pillar-right-label">INSIGHTS</div>
        <div class="pillar-right-item">
          <div class="pillar-right-item-title">Masterminds</div>
          <div class="pillar-right-item-desc">Insights on scaling to the next level.</div>
        </div>
      </div>
      <div class="pillar-right-group">
        <div class="pillar-right-label">EXPERIENCES</div>
        <div class="pillar-right-item">
          <div class="pillar-right-item-title">Member retreats</div>
          <div class="pillar-right-item-desc">Experience and explore together.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- The Opportunity -->
  <div class="pillar-row reveal">
    <div class="pillar-photo-frame">
      <img src="/images/pillar-opportunity.jpg" alt="Founders at the PVC founding dinner" />
      <div class="pillar-photo-overlay">
        <span class="pillar-photo-location">FOUNDING DINNER · CAPE TOWN</span>
        <span class="pillar-photo-num">03 / 03 · THE OPPORTUNITY</span>
      </div>
    </div>
    <div class="pillar-row-main">
      <div class="pillar-title-block">
        <span class="pillar-display-title">The Opportunity</span>
        <em class="pillar-subtitle">The Upside</em>
      </div>
      <div class="pillar-meta-line">WHAT EMERGES FROM THE ROOM</div>
      <h3 class="pillar-subheading">The doors that open themselves</h3>
      <p class="pillar-body-text">What emerges when serious people are in the same room consistently: introductions, collaborations and partnerships. Plus a vetted Talent Network, so when you need a hire, you start with people we have already reviewed.</p>
      <div class="pillar-pills">
        <span class="pillar-pill">Introductions</span>
        <span class="pillar-pill">Collaborations</span>
        <span class="pillar-pill">Talent Network</span>
      </div>
    </div>
    <div class="pillar-row-right">
      <div class="pillar-right-group">
        <div class="pillar-right-label">NATURALLY</div>
        <div class="pillar-right-item">
          <div class="pillar-right-item-title">Collaborations</div>
          <div class="pillar-right-item-desc">Built on trust, not cold outreach.</div>
        </div>
      </div>
      <div class="pillar-right-group">
        <div class="pillar-right-label">THROUGH THE ROOM</div>
        <div class="pillar-right-item">
          <div class="pillar-right-item-title">Introductions</div>
          <div class="pillar-right-item-desc">The right person at the right time.</div>
        </div>
      </div>
      <div class="pillar-right-group">
        <div class="pillar-right-label">HIRING</div>
        <div class="pillar-right-item">
          <div class="pillar-right-item-title">Talent Network</div>
          <div class="pillar-right-item-desc">Vetted sales reps, developers, editors and ad specialists, ready to hire into your business.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ PATH OF A FOUNDER ═══ -->
<section id="path" data-screen-label="Path">
  <div class="path-inner">
    <div class="path-left reveal">
      <div class="path-eyebrow">Why the Room Changes Things</div>
      <h2 class="path-headline">The people you<br />build with are<br /><em>the advantage.</em></h2>
      <a href="#" class="apply-trigger path-cta">Apply for Membership</a>
    </div>
    <div class="path-steps">
      <div class="path-step reveal d1">
        <div class="path-step-num">01</div>
        <div class="path-step-body">
          <p>You figured out the basics yourself. You brute forced your way through the bottlenecks and actually started to see good results and good money in your business, mostly alone. It got you here because it worked. But being in Africa means you've been doing it with people who might not fully understand your journey. A market that is still catching up to what is already out there, and fewer people who've navigated the same path as you. The playbooks that exist were written for different markets.</p>
        </div>
      </div>
      <div class="path-step reveal d2">
        <div class="path-step-num">02</div>
        <div class="path-step-body">
          <p>What it costs to solve alone never shows up as one single item. The person you hired that you kept for six months too long. The decision that you should have made earlier that took you weeks. And the partnership you missed because you weren't able to get an introduction.</p>
        </div>
      </div>
      <div class="path-step reveal d3">
        <div class="path-step-num">03</div>
        <div class="path-step-body">
          <p>Proximity replaces information. The right person with the right answer moves faster than any course or playbook. An offer pressure-tested in one conversation. A channel unlocked by someone who's already been there and built there.</p>
        </div>
      </div>
      <div class="path-step reveal d4">
        <div class="path-step-num">04</div>
        <div class="path-step-body">
          <p>Private Victories is what that room looks like in practice. Not for anyone who calls themselves a founder. A private network for the ones who are actually building, scaling, and surrounding each other with the people and opportunities that compound.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 03 · NOT FOR EVERYONE ═══ -->
<section id="who" data-screen-label="03 Who">
  <div class="photo-slot who-photo">
    <img src="/images/who-interior.jpg" alt="Historic building lit up on a quiet street at night" />
  </div>
  <svg class="noise-layer" xmlns="http://www.w3.org/2000/svg" style="z-index:5" set:html={NOISE('n4')} />
  <div class="who-inner">
    <div class="who-head">
      <div class="section-label reveal"><span class="section-num">03</span> Entry</div>
      <h2 class="who-headline reveal d1">NOT FOR<br />EVERYONE.<br />ON PURPOSE.</h2>
      <p class="who-filter reveal d3">Founders already building something real, doing R20k a month or more in revenue from a business they run. Not people thinking about starting. Not people looking for motivation. People who are in it and want to be surrounded by others doing the same. If you have a specific problem you're solving, skin in the game, and you're already in motion, this is your room. Every application is reviewed by a person, followed by a short call.</p>
    </div>
    <div class="criteria">
      <div class="criterion reveal d1">
        <div class="criterion-num">01</div>
        <div class="criterion-text">You're already building something real.<span>PVC accelerates what you're building. It isn't a programme that teaches you how to start.</span></div>
        <div class="criterion-ghost">01</div>
      </div>
      <div class="criterion reveal d2">
        <div class="criterion-num">02</div>
        <div class="criterion-text">You'd rather do the work<span>than talk about it.</span></div>
        <div class="criterion-ghost">02</div>
      </div>
      <div class="criterion reveal d3">
        <div class="criterion-num">03</div>
        <div class="criterion-text">You understand the room you're in<span>determines how far you go.</span></div>
        <div class="criterion-ghost">03</div>
      </div>
      <div class="criterion reveal d4">
        <div class="criterion-num">04</div>
        <div class="criterion-text">You contribute to the room.<span>You bring experience, share what you've learned, and look for ways to help others.</span></div>
        <div class="criterion-ghost">04</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 04 · WHAT YOU GET ═══ -->
<section id="access" data-screen-label="04 Access">
  <svg class="noise-layer" xmlns="http://www.w3.org/2000/svg" set:html={NOISE('n5')} />
  <div class="member-inner">
    <div class="section-label reveal"><span class="section-num">04</span> Membership</div>
    <h2 class="member-headline reveal d1">Become a <em>Member.</em></h2>
    <div class="member-card reveal d2">

      <div class="member-card-left">
        <div class="member-badge">Inside</div>
        <div class="member-card-title">ROOM 01.</div>
        <div class="member-card-wm" aria-hidden="true">PVC</div>
      </div>

      <div class="member-card-right">
        <ul class="member-list">
          <li class="member-list-item">
            <span class="mli-num">01</span>
            <span class="mli-text">Members-only community, active around the clock</span>
          </li>
          <li class="member-list-item">
            <span class="mli-num">02</span>
            <span class="mli-text">Three calls a month: community call, member round table and guest speaker session</span>
          </li>
          <li class="member-list-item">
            <span class="mli-num">03</span>
            <span class="mli-text">Dedicated financial advisor — monthly session with a licensed financial advisor, exclusive to members</span>
          </li>
          <li class="member-list-item">
            <span class="mli-num">04</span>
            <span class="mli-text">Warm introductions on joining</span>
          </li>
          <li class="member-list-item">
            <span class="mli-num">05</span>
            <span class="mli-text">Talent Network: vetted sales reps, developers, editors and ad specialists</span>
          </li>
          <li class="member-list-item">
            <span class="mli-num">06</span>
            <span class="mli-text">Founder dinners, masterminds and retreats, with 50% off public event tickets</span>
          </li>
          <li class="member-list-item">
            <span class="mli-num">07</span>
            <span class="mli-text">Member directory, call recordings and SOP library</span>
          </li>
        </ul>
        <div class="member-card-cta">
          <a href="#" class="cta-btn apply-trigger">Apply for Membership</a>
          <span class="member-cta-meta">By application only<br />Applications reviewed manually</span>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ═══ 05 · EVENTS GALLERY ═══ -->
<section id="events" data-screen-label="05 Events">
  <div class="events-inner">
    <div class="events-header">
      <div>
        <div class="section-label reveal"><span class="section-num">05</span> What We've Been Up To</div>
        <h2 class="events-headline reveal d1">Inside <em>the room.</em></h2>
      </div>
      <p class="events-sub reveal d2">We have hosted two events since our founding dinner in August 2026: the dinner itself, and a Cape Town Mastermind in October. No panels, no stages. Just founders actually talking. This is what it looked like inside.</p>
    </div>
    <div class="events-video-strip reveal d1">
      <div class="event-video">
        <video autoplay muted loop playsinline>
          <source src="/videos/dinner-energy.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="event-video">
        <video autoplay muted loop playsinline>
          <source src="/videos/dinner-conversation.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="event-video">
        <video autoplay muted loop playsinline>
          <source src="/videos/dinner-table.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="event-video">
        <video autoplay muted loop playsinline style="object-position: center 70%;">
          <source src="/videos/ct-mastermind.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="event-video">
        <video autoplay muted loop playsinline>
          <source src="/videos/pvc-clips.mp4" type="video/mp4" />
        </video>
