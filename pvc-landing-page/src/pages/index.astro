---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
const PH_KEY = import.meta.env.PUBLIC_POSTHOG_KEY ?? '';

const NOISE = (id: string) => `
  <filter id="${id}"><feTurbulence type="fractalNoise" baseFrequency="0.7" numOctaves="3" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter>
  <rect width="100%" height="100%" filter="url(#${id})"/>
`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Private Victories Club · Build in private. Win in public.</title>
  <meta name="description" content="Africa's private network for entrepreneurs scaling their businesses. Connect, grow, and build alongside the people doing the exact same thing. By application only." />
  <link rel="icon" href="data:," />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet" />
  <Analytics />
  <script define:vars={{ PH_KEY }} is:inline>window.__PVC_PH_KEY = PH_KEY;</script>
</head>
<body>

<!-- NAV -->
<nav id="nav">
  <a href="#hero" class="nav-logo">
    <div class="nav-mark"><span>PVC</span></div>
    <div class="nav-lock">
      <div class="nav-lock-1">Private Victories</div>
      <div class="nav-lock-2">Africa's private network for founders scaling businesses.</div>
    </div>
  </a>
  <a href="#" class="nav-apply apply-trigger">Apply for Membership</a>
</nav>

<!-- ═══ HERO ═══ -->
<section id="hero" data-screen-label="Hero">
  <div class="hero-top-bar"></div>

  <div class="hero-left">
    <div class="hero-eyebrow reveal">Africa's Private Members Club</div>
    <h1 class="hero-title reveal d1">PRIVATE<br />VICTORIES<br /><span class="lt">CLUB</span></h1>
    <p class="hero-tagline reveal d2">Build in private. Win in public.</p>
    <p class="hero-line reveal d3">Africa's private network for founders scaling their businesses. The room changes everything.</p>
    <a href="#" class="cta-btn reveal d4 apply-trigger">Apply for Membership</a>
    <div class="cta-note reveal d4">By application only.</div>
  </div>

  <div class="hero-right">
    <div class="photo-slot hero-photo">
      <img src="/images/hero-skyline.jpg" alt="Modern city skyline lit up at night" />
    </div>
    <svg class="noise-layer" xmlns="http://www.w3.org/2000/svg" style="z-index:5" set:html={NOISE('n1')} />
    <div class="hero-float-card">
      <div class="hero-float-eyebrow">The premise</div>
      <div class="hero-float-text">The room you're in determines how far you go. The right people show you what's possible and make you push harder.</div>
    </div>
  </div>

  <div class="hero-scroll reveal d5">
    <span>Scroll</span>
    <div class="hero-scroll-line"></div>
  </div>
</section>

<!-- ═══ 01 · THE PREMISE ═══ -->
<section id="premise" data-screen-label="01 Premise">
  <svg class="noise-layer" xmlns="http://www.w3.org/2000/svg" set:html={NOISE('n2')} />
  <div class="premise-inner">
    <div class="premise-left">
      <div class="section-label reveal"><span class="section-num">01</span> The Premise</div>
      <h2 class="premise-headline reveal d1"><span class="strike">Not a course.</span> <span class="strike">Not a community.</span> A private <em class="serif">network.</em></h2>
      <div class="premise-body">
        <p class="reveal d2">A private network, designed specifically for entrepreneurs scaling their business.</p>
        <p class="reveal d3">The network, the masterclasses, the board of directors, the experiences. All of it exists to accelerate what you're already doing and put you around people who can help you do the exact same thing.</p>
        <p class="reveal d3">Built in Africa. Open to anyone, anywhere, who's dialled in to building and scaling a real business.</p>
        <p class="reveal d4"><b>That's exactly what money can't buy.</b></p>
      </div>
    </div>
    <div class="premise-stats">
      <div class="premise-stat reveal d1">
        <div class="premise-stat-val">R10k</div>
        <div class="premise-stat-text"><b>Minimum to apply.</b> You're already in motion. PVC accelerates it.</div>
      </div>
      <div class="premise-stat reveal d2">
        <div class="premise-stat-val accent">Africa</div>
        <div class="premise-stat-text">Built here. <b>Open to founders globally.</b> The network spans wherever serious people are building.</div>
      </div>
      <div class="premise-stat reveal d3">
        <div class="premise-stat-val">Private</div>
        <div class="premise-stat-text">Vetted. Reviewed. <b>Everyone in the room is there for a reason.</b> No exceptions.</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 02 · THE THREE PILLARS ═══ -->
<section id="pillars" data-screen-label="02 Pillars">
  <div class="pillars-inner">
    <div class="section-label reveal"><span class="section-num">02</span> What PVC is built on</div>
    <h2 class="pillars-headline reveal d1">Three things that <em>actually</em> move the needle.</h2>
    <div class="pillars-grid">
      <div class="pillar reveal d1">
        <div class="pillar-num">01</div>
        <div class="pillar-title">The Network</div>
        <p class="pillar-body">A private, curated community of founders who are actually building. Real conversation, genuine accountability, and connections that compound over time. Not a group chat. A room that stays.</p>
      </div>
      <div class="pillar reveal d2">
        <div class="pillar-num">02</div>
        <div class="pillar-title">The Masterclasses</div>
        <p class="pillar-body">Operators who have actually built, not theorists who've read about it. Board Q&As and masterclasses where you can ask the real questions to people who've already figured it out.</p>
      </div>
      <div class="pillar reveal d3">
        <div class="pillar-num">03</div>
        <div class="pillar-title">The Board</div>
        <p class="pillar-body">Access to operators ahead of you who can see around corners you can't yet. People who've already solved the problems you're facing right now, willing to share the shortcut.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 03 · NOT FOR EVERYONE ═══ -->
<section id="who" data-screen-label="03 Who">
