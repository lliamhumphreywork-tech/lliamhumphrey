  <div class="close-cta-wrap reveal d2">
    <a href="#" class="cta-btn apply-trigger">Apply for Membership</a>
    <div class="cta-note">Applications reviewed manually · <b>@privatevictories.club</b></div>
  </div>
</section>

<!-- APPLICATION MODAL -->
<div id="applyModal" class="pvc-modal" aria-hidden="true">
  <div class="pvc-modal-overlay" id="modalOverlay"></div>
  <div class="pvc-modal-panel">
    <button class="pvc-modal-close" id="modalClose" aria-label="Close">&times;</button>
    <div class="pvc-modal-form">
      <iframe data-tally-src="https://tally.so/r/jarg7Y?transparentBackground=1" loading="lazy" width="100%" height="680" frameborder="0" marginheight="0" marginwidth="0" title="PVC Membership Application" scrolling="no"></iframe>
      <script async src="https://tally.so/widgets/embed.js"></script>
    </div>
  </div>
</div>

<!-- COOKIE BANNER -->
<div id="cookieBanner" class="cookie-banner" aria-hidden="true">
  <p class="cookie-text">We use cookies for analytics and marketing to understand how people find and use PVC.</p>
  <div class="cookie-actions">
    <button id="cookieAccept" class="cookie-btn cookie-accept">Accept</button>
    <button id="cookieDecline" class="cookie-btn cookie-decline">Decline</button>
  </div>
</div>

<!-- FOOTER -->
<footer>
  <div class="footer-lock">
    <div class="footer-mark">PVC</div>
    <div class="footer-name">Private Victories Club</div>
  </div>
  <div class="footer-handle"><a href="https://instagram.com/privatevictories.club" target="_blank" rel="noopener">@privatevictories.club</a> · Built in Africa</div>
  <div class="footer-copy">© MMXXVI · Build in private. Win in public.</div>
  <div class="footer-legal"><a href="/legal">Terms &amp; Conditions</a> · <a href="/legal#privacy">Privacy Policy</a> · <a href="/legal#refunds">Refund Policy</a></div>
</footer>

<script>
  // Reveal on scroll
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.12, rootMargin: '0px 0px -50px 0px' });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

  // Parallax on hero + founder portrait
  const heroPhoto = document.querySelector<HTMLElement>('.hero-photo');
  const founderPortrait = document.querySelector<HTMLElement>('.founder-portrait');
  const onParallax = () => {
    const y = window.scrollY;
    if (heroPhoto) heroPhoto.style.setProperty('--parallax-y', `${y * 0.28}px`);
    if (founderPortrait) {
      const rect = founderPortrait.getBoundingClientRect();
      const offset = (window.innerHeight / 2 - rect.top - rect.height / 2) * 0.12;
      founderPortrait.style.setProperty('--parallax-y', `${offset}px`);
    }
  };
  window.addEventListener('scroll', onParallax, { passive: true });
  onParallax();

  // Nav scroll state
  const nav = document.getElementById('nav');
  const onScroll = () => { nav?.classList.toggle('scrolled', window.scrollY > 60); };
  window.addEventListener('scroll', onScroll);
  onScroll();

  // Hero reveals
  setTimeout(() => {
    document.querySelectorAll('#hero .reveal').forEach((el) => el.classList.add('visible'));
  }, 120);

  // Tally page-change fade animation
  window.addEventListener('message', (e) => {
    if (e.data?.event === 'Tally.FormPageView' || e.data?.name === 'tally-form-page-view') {
      const iframe = document.querySelector<HTMLElement>('.pvc-modal-form iframe');
      if (!iframe) return;
      iframe.classList.add('tally-fade');
      requestAnimationFrame(() => requestAnimationFrame(() => iframe.classList.remove('tally-fade')));
    }
  });

  // Modal
  const modal = document.getElementById('applyModal');
  const modalOverlay = document.getElementById('modalOverlay');
  const modalClose = document.getElementById('modalClose');
  function injectSourceIntoTally(iframeSelector: string) {
    const params = new URLSearchParams(window.location.search);
    const utmSource   = params.get('utm_source')   || '';
    const utmMedium   = params.get('utm_medium')   || '';
    const utmCampaign = params.get('utm_campaign') || '';
    const referrer    = document.referrer
      ? (() => { try { return new URL(document.referrer).hostname; } catch { return document.referrer; } })()
      : 'direct';
    const iframe = document.querySelector<HTMLIFrameElement>(iframeSelector);
    if (!iframe) return;
    const base = iframe.getAttribute('data-tally-src') || iframe.src || '';
    const url = new URL(base.startsWith('http') ? base : 'https://tally.so' + base);
    if (utmSource)   url.searchParams.set('utm_source',   utmSource);
    if (utmMedium)   url.searchParams.set('utm_medium',   utmMedium);
    if (utmCampaign) url.searchParams.set('utm_campaign', utmCampaign);
    url.searchParams.set('referrer', referrer);
    iframe.setAttribute('data-tally-src', url.toString());
    iframe.src = url.toString();
  }

  const openModal = (e: Event) => {
    e.preventDefault();
    injectSourceIntoTally('.pvc-modal-form iframe');
    modal?.classList.add('open');
    document.body.style.overflow = 'hidden';
    if (typeof (window as any).Tally !== 'undefined') (window as any).Tally.loadEmbeds();
    if (typeof (window as any).fbq !== 'undefined') (window as any).fbq('track', 'Lead');
  };
  const closeModal = () => { modal?.classList.remove('open'); document.body.style.overflow = ''; };
  document.querySelectorAll('.apply-trigger').forEach((btn) => btn.addEventListener('click', openModal));
  modalOverlay?.addEventListener('click', closeModal);
  modalClose?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  // Cookie consent
  const cookieBanner = document.getElementById('cookieBanner');
  const cookieAccept = document.getElementById('cookieAccept');
  const cookieDecline = document.getElementById('cookieDecline');
  const CONSENT_KEY = 'pvc_cookie_consent';

  function loadTracking() {
    // Meta Pixel
