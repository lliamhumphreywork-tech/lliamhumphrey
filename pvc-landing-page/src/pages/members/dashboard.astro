    <div id="ob-s3" style="display:none;text-align:center;padding:8px 0;">
      <div style="width:44px;height:44px;border-radius:50%;background:rgba(62,207,142,0.1);border:1px solid rgba(62,207,142,0.25);display:flex;align-items:center;justify-content:center;margin:0 auto 20px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3ecf8e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <h2 class="ob-heading" style="font-size:22px;margin-bottom:8px;">You're in.</h2>
      <p class="ob-sub" style="margin-bottom:24px;">Profile saved. The room knows who you are.</p>
      <button class="ob-btn" style="max-width:180px;margin:0 auto;" onclick="obDismiss()">Go to dashboard</button>
    </div>

  </div>
</div>
)}

<style>
  .ob-bar { height: 2px; border-radius: 1px; flex: 1; background: rgba(168,184,200,0.15); transition: background 0.35s ease; }
  .ob-bar-on { background: #ece6da; }
  .ob-eyebrow { font-family: var(--s); font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: #7a8fa0; margin-bottom: 12px; }
  .ob-heading { font-family: var(--g); font-size: 26px; font-weight: 400; color: #fff; line-height: 1.1; margin-bottom: 8px; }
  .ob-sub { font-family: var(--s); font-size: 13px; color: #8aa0b4; line-height: 1.7; margin-bottom: 28px; }
  .ob-field { margin-bottom: 15px; }
  .ob-label { display: block; font-family: var(--s); font-size: 9px; letter-spacing: 2.5px; text-transform: uppercase; color: #8aa0b4; margin-bottom: 8px; font-weight: 500; }
  .ob-input {
    width: 100%; background: rgba(8,17,31,0.8); border: 1px solid rgba(168,184,200,0.16);
    color: #ece6da; font-family: var(--s); font-size: 13px;
    padding: 12px 14px; outline: none; border-radius: 9px;
    transition: border-color 0.2s; box-sizing: border-box;
  }
  .ob-input:focus { border-color: rgba(168,184,200,0.38); }
  .ob-input::placeholder { color: rgba(168,184,200,0.35); }
  .ob-err { font-family: var(--s); font-size: 11px; color: #e05555; margin-top: 5px; display: none; }
  .ob-btn {
    display: block; width: 100%; background: #ece6da; color: #08111f;
    border: none; padding: 13px; border-radius: 100px;
    font-family: var(--s); font-size: 11px; font-weight: 600; letter-spacing: 2px;
    text-transform: uppercase; cursor: pointer; margin-top: 8px; transition: opacity 0.2s;
  }
  .ob-btn:hover { opacity: 0.82; }
  .ob-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .ob-skip {
    display: block; width: 100%; margin-top: 10px; background: none; border: none;
    font-family: var(--s); font-size: 11px; color: #4a6070; cursor: pointer; padding: 7px;
    transition: color 0.2s; letter-spacing: 0.5px;
  }
  .ob-skip:hover { color: #8aa0b4; }
</style>

<script>
  function obGoTo(n: number) {
    ['ob-s1','ob-s2','ob-s3'].forEach((id, i) => {
      (document.getElementById(id) as HTMLElement).style.display = i === n ? 'block' : 'none';
    });
    ['ob-p1','ob-p2','ob-p3'].forEach((id, i) => {
      const el = document.getElementById(id)!;
      el.classList.toggle('ob-bar-on', i <= n);
    });
  }

  function obNext() {
    const name = (document.getElementById('ob-name') as HTMLInputElement).value.trim();
    const errEl = document.getElementById('ob-name-err')!;
    if (!name) { errEl.style.display = 'block'; (document.getElementById('ob-name') as HTMLInputElement).focus(); return; }
    errEl.style.display = 'none';
    obGoTo(1);
  }

  async function obSave() {
    const btn = document.getElementById('ob-save-btn') as HTMLButtonElement;
    const err = document.getElementById('ob-err')!;
    btn.disabled = true; btn.textContent = 'Saving...';
    err.style.display = 'none';

    const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();

    try {
      const res = await fetch('/api/members/update-profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: val('ob-name'), business: val('ob-business'),
          role: val('ob-role'), instagram: val('ob-instagram'), location: val('ob-location'),
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? 'Save failed');
      try { localStorage.setItem('pvc_onboarded', '1'); } catch {}
      obGoTo(2);
    } catch (e: any) {
      err.textContent = e.message ?? 'Something went wrong';
      err.style.display = 'block';
      btn.disabled = false; btn.textContent = 'Save profile';
    }
  }

  function obSkip() {
    try { localStorage.setItem('pvc_onboarded', '1'); } catch {}
    obDismiss();
  }

  function obDismiss() {
    const overlay = document.getElementById('ob-overlay');
    if (!overlay) return;
    overlay.style.transition = 'opacity 0.3s ease';
    overlay.style.opacity = '0';
    setTimeout(() => overlay.remove(), 320);
  }

  document.getElementById('ob-name')?.addEventListener('input', () => {
    (document.getElementById('ob-name-err') as HTMLElement).style.display = 'none';
  });

  try {
    if (localStorage.getItem('pvc_onboarded') === '1') document.getElementById('ob-overlay')?.remove();
  } catch {}
</script>
</body>
</html>
