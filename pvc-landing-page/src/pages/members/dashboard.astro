---
export const prerender = false;
import { getSession } from '../../lib/members-auth';
import { getMemberByEmail } from '../../lib/members-notion';
import { list } from '@vercel/blob';

const session = getSession(Astro.request.headers.get('cookie'));
if (!session) return Astro.redirect('/members');

const section = Astro.url.searchParams.get('s') ?? 'home';
const email = session.email;

const memberData = await getMemberByEmail(email).catch(() => null);
if (!memberData) return Astro.redirect('/members/pending');
const memberName = memberData?.name ?? '';
const needsOnboarding = !!memberData && (!memberName || memberName.toLowerCase() === email.split('@')[0].toLowerCase());

const displayName = memberName?.split(' ')[0] || email.split('@')[0].split('.')[0];
const firstName2 = displayName.charAt(0).toUpperCase() + displayName.slice(1);
const memberTier = 'Room 01';

interface Recording {
  id: string;
  title: string;
  description: string;
  date: string;
  videoUrl: string;
  uploadedAt: string;
}

let recordings: Recording[] = [];
try {
  const { blobs } = await list({ prefix: 'recordings/meta/' });
  const fetches = blobs.map(b => fetch(b.url).then(r => r.json()));
  recordings = (await Promise.all(fetches)).sort(
    (a, b) => new Date(b.uploadedAt).getTime() - new Date(a.uploadedAt).getTime()
  );
} catch {}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Members · Private Victories Club</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" href="data:," />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,300&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --black: #08111f;
      --navy: #0a1628;
      --panel: #0d1a2e;
      --cream: #ece6da;
      --white: #ffffff;
      --silver: #a8b8c8;
      --silver-dim: #4a5666;
      --silver-light: #dde4ec;
      --border: rgba(168,184,200,0.10);
      --border-mid: rgba(168,184,200,0.18);
      --g: 'Syne', sans-serif;
      --s: 'DM Sans', sans-serif;
      --card: #121d2e;
      --card-hover: #172339;
      --radius: 12px;
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(18px); }
      to { opacity: 1; transform: translateY(0); }
    }
    html, body { height: 100%; }
    body { background: var(--black); color: var(--cream); font-family: var(--s); font-size: 15px; line-height: 1.6; }

    /* Layout */
    .layout { display: grid; grid-template-columns: 220px 1fr; min-height: 100vh; }

    /* Sidebar */
    .sidebar {
      background: var(--panel); border-right: 1px solid var(--border);
      display: flex; flex-direction: column; padding: 32px 0;
      position: sticky; top: 0; height: 100vh; overflow-y: auto;
    }
    .sidebar-brand { font-size: 8px; letter-spacing: 4px; text-transform: uppercase; color: var(--silver-dim); padding: 0 24px; margin-bottom: 40px; }
    .sidebar-section { margin-bottom: 32px; }
    .sidebar-label { font-size: 8px; letter-spacing: 3px; text-transform: uppercase; color: var(--silver-dim); padding: 0 24px; margin-bottom: 10px; }
    .nav-item {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 24px; font-size: 13px; font-weight: 400; color: var(--silver-dim);
      cursor: pointer; transition: color 0.15s, background 0.15s;
      border-left: 2px solid transparent; text-decoration: none;
    }
    .nav-item:hover { color: var(--cream); background: rgba(168,184,200,0.04); }
    .nav-item.active { color: var(--white); border-left-color: var(--silver); background: rgba(168,184,200,0.06); }
    .nav-item svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }

    .sidebar-bottom { margin-top: auto; padding: 24px 24px 0; border-top: 1px solid var(--border); }
    .member-chip { display: flex; align-items: center; gap: 10px; padding-top: 16px; }
    .member-avatar { width: 30px; height: 30px; background: var(--silver-dim); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 600; color: var(--white); flex-shrink: 0; overflow: hidden; }
    .member-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .member-name { font-size: 12px; font-weight: 500; color: var(--cream); }
    .member-tier { font-size: 10px; color: var(--silver-dim); }
    .signout-btn { font-size: 10px; color: var(--silver-dim); background: none; border: none; cursor: pointer; padding: 12px 0 0; display: block; letter-spacing: 0.5px; }
    .signout-btn:hover { color: var(--silver); }

    /* Main */
    .main { padding: 48px 52px; max-width: 960px; }

    /* Sections */
    .section { display: none; }
    .section.active { display: block; }

    /* Home */
    .home-eyebrow { font-size: 9px; letter-spacing: 4px; text-transform: uppercase; color: var(--silver-dim); margin-bottom: 16px; }
    .home-headline { font-family: var(--g); font-size: clamp(32px, 4vw, 48px); font-weight: 400; color: var(--white); line-height: 1.1; margin-bottom: 48px; }


    .stats-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 48px; }
    .stat-cell {
      background: var(--card); padding: 24px 28px; border-radius: var(--radius);
      border: 1px solid var(--border); transition: all 0.25s cubic-bezier(0.4,0,0.2,1);
    }
    .stat-cell:hover { background: var(--card-hover); border-color: var(--border-mid); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.35); }
    .stat-num { font-family: var(--g); font-size: 32px; font-weight: 300; color: var(--white); line-height: 1; margin-bottom: 6px; }
    .stat-lbl { font-size: 9px; letter-spacing: 3px; text-transform: uppercase; color: var(--silver-dim); }

    /* Announcement banner */
    .announce-banner {
      display: flex; align-items: center; gap: 14px;
      background: rgba(201,168,76,0.06); border: 1px solid rgba(201,168,76,0.18);
      border-radius: var(--radius); padding: 14px 18px; margin-bottom: 20px;
    }
    .announce-dot { width: 7px; height: 7px; border-radius: 50%; background: #c9a84c; flex-shrink: 0; box-shadow: 0 0 8px rgba(201,168,76,0.6); animation: pulse-dot 2s ease infinite; }
    @keyframes pulse-dot { 0%,100% { opacity:1; } 50% { opacity:0.4; } }
    .announce-text { font-family: var(--s); font-size: 12px; color: var(--silver); flex: 1; line-height: 1.5; }
    .announce-label { font-family: var(--s); font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: #c9a84c; margin-right: 10px; }
    .announce-cta { font-family: var(--s); font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: #c9a84c; text-decoration: none; flex-shrink: 0; transition: opacity 0.15s; }
    .announce-cta:hover { opacity: 0.7; }

    /* Image tiles */
    .home-tiles { display: grid; grid-template-columns: 1fr 1fr 1fr; grid-template-rows: 210px 165px; gap: 10px; }
    .htile-big { grid-column: span 1; }
    .home-tiles .htile:nth-child(1) { grid-column: 1 / 2; }
    .home-tiles .htile:nth-child(2) { grid-column: 2 / 4; }
    .htile {
      position: relative; border-radius: var(--radius); overflow: hidden;
      background-size: cover; background-position: center;
      text-decoration: none; display: flex; flex-direction: column; justify-content: flex-end;
      border: 1px solid var(--border);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .htile:hover { transform: translateY(-3px); box-shadow: 0 16px 40px rgba(0,0,0,0.55); }
    .htile-big { grid-row: span 1; }
    .htile-sm { }
    .htile-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(5,10,20,0.88) 0%, rgba(5,10,20,0.3) 50%, rgba(5,10,20,0.1) 100%);
    }
    .htile-overlay-heavy {
      background: linear-gradient(to top, rgba(5,10,20,0.92) 0%, rgba(5,10,20,0.55) 60%, rgba(5,10,20,0.25) 100%);
    }
    .htile-content { position: relative; z-index: 1; padding: 18px 20px; }
    .htile-eyebrow { font-family: var(--s); font-size: 9px; letter-spacing: 2.5px; text-transform: uppercase; color: rgba(236,230,218,0.55); margin-bottom: 5px; }
    .htile-title { font-family: var(--g); font-size: 22px; font-weight: 400; color: var(--white); line-height: 1.1; margin-bottom: 4px; }
    .htile-title-sm { font-size: 17px; }
    .htile-sub { font-family: var(--s); font-size: 11px; color: rgba(236,230,218,0.55); }
    .htile-badge {
      position: absolute; top: 16px; right: 16px; z-index: 2;
      font-family: var(--s); font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
      background: rgba(236,230,218,0.15); border: 1px solid rgba(236,230,218,0.25);
      color: var(--cream); padding: 5px 12px; border-radius: 100px;
    }
    .htile-wa { background: #0e1f14; }
    .htile-badge-wa { background: #25D366; border-color: #25D366; color: #fff; display: flex; align-items: center; gap: 0; padding: 8px; border-radius: 50%; }

    /* Talent network */
    .talent-filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 28px; }
    .tfilter {
      padding: 7px 16px; background: transparent; border: 1px solid var(--border);
      color: var(--silver-dim); font-family: var(--s); font-size: 10px; font-weight: 500;
      letter-spacing: 2px; text-transform: uppercase; cursor: pointer; transition: all 0.2s;
      border-radius: 100px;
    }
    .tfilter:hover { border-color: var(--border-mid); color: var(--silver); }
    .tfilter.active { background: var(--silver); color: var(--black); border-color: var(--silver); }

    .talent-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }

    .tcard {
      border: 1px solid var(--border); border-left-width: 3px;
      padding: 24px; display: flex; flex-direction: column; gap: 16px;
      transition: all 0.25s cubic-bezier(0.4,0,0.2,1); border-radius: var(--radius);
      overflow: hidden;
      animation: fadeUp 0.5s ease both;
      animation-delay: calc(var(--i,0) * 0.07s);
    }
    .tcard:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.4); border-color: var(--border-mid); }
    .tcard.hidden { display: none; }
    .tcard[data-cat="Ads"]       { background: rgba(255,160,80,0.05);  border-left-color: #e07840; }
    .tcard[data-cat="Sales"]     { background: rgba(80,140,255,0.05);  border-left-color: #4a8fe8; }
    .tcard[data-cat="Editor"]    { background: rgba(160,100,255,0.05); border-left-color: #9b6be0; }
    .tcard[data-cat="Developer"] { background: rgba(60,200,140,0.05);  border-left-color: #3dc48a; }

    .tcard-top { display: flex; align-items: center; gap: 12px; }
    .tcard-avatar {
      width: 36px; height: 36px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 14px; font-weight: 600; color: var(--white); flex-shrink: 0;
    }
    .tcard[data-cat="Ads"]       .tcard-avatar { background: #7a3c18; }
    .tcard[data-cat="Sales"]     .tcard-avatar { background: #1e3f7a; }
    .tcard[data-cat="Editor"]    .tcard-avatar { background: #4a2880; }
    .tcard[data-cat="Developer"] .tcard-avatar { background: #155c40; }
    .tcard-name { font-size: 14px; font-weight: 500; color: var(--white); }
    .tcard-cat { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--silver-dim); margin-top: 2px; display: flex; align-items: center; gap: 8px; }

    .pvc-badge {
      font-size: 8px; letter-spacing: 1.5px; background: rgba(168,184,200,0.15);
      border: 1px solid var(--border-mid); color: var(--silver); padding: 2px 7px;
      text-transform: uppercase;
    }

    .tcard-result { font-size: 12px; font-weight: 300; color: var(--silver); line-height: 1.7; flex: 1; }

    .tcard-meta { display: flex; flex-direction: column; gap: 4px; }
    .tcard-meta span { font-size: 11px; color: var(--silver-dim); }
    .tcard-meta span:first-child { color: var(--cream); font-weight: 500; }

    .tcard-actions { border-top: 1px solid var(--border); padding-top: 14px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
    .tcard-link {
      font-size: 10px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase;
      color: var(--silver-dim); text-decoration: none; transition: color 0.15s; display: flex; align-items: center; gap: 5px;
    }
    .tcard-link:hover { color: var(--silver); }
    .tcard-link svg { width: 12px; height: 12px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }

    /* Member directory */
    .map-panel {
      position: relative; height: 440px; overflow: hidden;
      background: rgba(3,8,20,0.9); border: 1px solid var(--border); margin-bottom: 24px;
      border-radius: var(--radius);
    }
    .map-left {
      position: absolute; left: 28px; top: 50%; transform: translateY(-50%); z-index: 3;
      pointer-events: none;
    }
    .map-big-num {
      font-family: var(--g); font-size: 48px; font-weight: 300; color: var(--white);
      line-height: 1; margin-bottom: 4px; letter-spacing: -2px;
    }
    .map-big-lbl { font-size: 8px; letter-spacing: 3px; text-transform: uppercase; color: var(--silver-dim); margin-bottom: 18px; }
    .map-legend { display: flex; flex-direction: column; gap: 6px; }
    .map-legend-row { display: flex; align-items: center; gap: 7px; font-size: 10px; color: var(--silver); }
    .map-legend-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
    .map-right { position: absolute; right: -50px; top: 50%; transform: translateY(-50%); }
    #globe-canvas { display: block; filter: drop-shadow(0 20px 50px rgba(0,0,0,0.9)); }

    .member-topbar { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
    .member-search {
      flex: 1; min-width: 180px; background: rgba(168,184,200,0.03); border: 1px solid var(--border);
      color: var(--cream); font-family: var(--s); font-size: 11px; letter-spacing: 0.5px;
      padding: 10px 14px; outline: none; transition: border-color 0.15s; border-radius: 8px;
    }
    .member-search::placeholder { color: var(--silver-dim); letter-spacing: 1px; font-size: 10px; text-transform: uppercase; }
    .member-search:focus { border-color: var(--border-mid); }
    .member-count-tag { font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: var(--silver-dim); white-space: nowrap; }

    .member-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 14px;
    }
    .mcard {
      background: var(--card); padding: 24px; display: flex; flex-direction: column;
      border-radius: var(--radius); border: 1px solid var(--border);
      transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
      animation: fadeUp 0.5s ease both;
      animation-delay: calc(var(--i,0) * 0.07s);
    }
    .mcard:hover { background: var(--card-hover); transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.4); border-color: var(--border-mid); }
    .mcard.hidden { display: none; }

    .mcard-hd { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; }
    .mcard-avatar {
      width: 54px; height: 54px; border-radius: 50%; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-family: var(--g); font-size: 21px; font-weight: 500;
      background: #101e30; color: var(--silver); border: 1px solid var(--border);
    }
    .mcard-name { font-family: var(--g); font-size: 15px; font-weight: 500; color: var(--white); margin-bottom: 3px; }
    .mcard-joined { font-size: 8px; letter-spacing: 2px; text-transform: uppercase; color: var(--silver-dim); }

    .mcard-fields { display: flex; flex-direction: column; gap: 12px; flex: 1; }
    .mf-lbl { font-size: 7px; letter-spacing: 2.5px; text-transform: uppercase; color: var(--silver-dim); margin-bottom: 3px; }
    .mf-val { font-size: 12px; color: var(--silver); font-weight: 400; line-height: 1.5; }
    .mf-val a { color: var(--silver); text-decoration: none; transition: color 0.15s; }
    .mf-val a:hover { color: var(--cream); }

    /* Coming soon placeholder */
    .coming-soon { padding: 80px 0; text-align: center; border: 1px solid var(--border); }
    .coming-soon-label { font-size: 9px; letter-spacing: 4px; text-transform: uppercase; color: var(--silver-dim); margin-bottom: 16px; }
    .coming-soon-title { font-family: var(--g); font-size: 24px; font-weight: 400; color: var(--white); margin-bottom: 12px; }
    .coming-soon-sub { font-size: 13px; color: var(--silver-dim); }

    /* Resource library */
    .rlib-filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 32px; }
    .rfilter {
      font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
      padding: 7px 16px; border: 1px solid var(--border); color: var(--silver-dim);
      background: transparent; cursor: pointer; transition: all 0.2s; font-family: var(--s);
      border-radius: 100px;
    }
    .rfilter:hover { border-color: rgba(168,184,200,0.3); color: var(--silver); }
    .rfilter.active { background: var(--silver); color: var(--black); border-color: var(--silver); }

    .rlib-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; }
    .rcard {
      background: var(--card); padding: 28px; display: flex; flex-direction: column; gap: 16px;
      transition: all 0.3s cubic-bezier(0.4,0,0.2,1); cursor: pointer;
      border-radius: var(--radius); border: 1px solid var(--border);
      animation: fadeUp 0.5s ease both;
      animation-delay: calc(var(--i,0) * 0.07s);
    }
    .rcard:hover { background: var(--card-hover); transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.4); border-color: var(--border-mid); }
    .rcard.hidden { display: none; }

    .rcard-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
    .rcard-cat {
      font-size: 8px; letter-spacing: 2.5px; text-transform: uppercase; padding: 4px 10px;
      border: 1px solid; flex-shrink: 0; border-radius: 100px;
    }
    .rcard-cat[data-t="call"]      { color: #4a8fe8; border-color: rgba(74,143,232,0.25); background: rgba(74,143,232,0.06); }
    .rcard-cat[data-t="sop"]       { color: #3ecf8e; border-color: rgba(62,207,142,0.25); background: rgba(62,207,142,0.06); }
    .rcard-cat[data-t="framework"] { color: #c9a84c; border-color: rgba(201,168,76,0.25);  background: rgba(201,168,76,0.06); }
    .rcard-cat[data-t="playbook"]  { color: #9b6be0; border-color: rgba(155,107,224,0.25); background: rgba(155,107,224,0.06); }

    .rcard-icon { width: 32px; height: 32px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border: 1px solid var(--border); border-radius: 8px; background: rgba(168,184,200,0.04); }
    .rcard-icon svg { width: 14px; height: 14px; stroke: var(--silver-dim); fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }

    .rcard-title { font-family: var(--g); font-size: 16px; font-weight: 500; color: var(--white); line-height: 1.3; }
    .rcard-desc { font-size: 12px; font-weight: 300; color: var(--silver-dim); line-height: 1.8; flex: 1; }
    .rcard-meta { display: flex; align-items: center; gap: 16px; padding-top: 12px; border-top: 1px solid var(--border); }
    .rcard-meta-item { font-size: 9px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--silver-dim); }
    .rcard-action {
      font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: var(--silver-dim);
      border: 1px solid var(--border); padding: 6px 14px; text-decoration: none;
      transition: all 0.2s; display: inline-block; margin-left: auto; border-radius: 100px;
    }
    .rcard-action:hover { color: var(--cream); border-color: rgba(168,184,200,0.3); }

    /* Event cards */
    .event-card { border: 1px solid var(--border); overflow: hidden; border-radius: var(--radius); }
    .event-photo { position: relative; height: 260px; overflow: hidden; }
    .event-photo img { width: 100%; height: 100%; object-fit: cover; display: block; filter: brightness(0.7); }
    .event-photo-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to bottom, transparent 40%, rgba(8,17,31,0.85) 100%);
    }
    .event-photo-date {
      position: absolute; top: 20px; right: 20px;
      background: rgba(8,17,31,0.75); border: 1px solid var(--border);
      padding: 10px 16px; text-align: center; backdrop-filter: blur(4px);
      border-radius: 8px;
    }
    .event-photo-date-day { font-family: var(--g); font-size: 28px; font-weight: 300; color: var(--white); line-height: 1; }
    .event-photo-date-month { font-size: 8px; letter-spacing: 3px; text-transform: uppercase; color: var(--silver-dim); margin-top: 4px; }
    .event-body { padding: 28px 32px; }
    .event-eyebrow { font-size: 8px; letter-spacing: 3px; text-transform: uppercase; color: var(--silver-dim); margin-bottom: 10px; }
    .event-name { font-family: var(--g); font-size: 22px; font-weight: 400; color: var(--white); margin-bottom: 12px; }
    .event-meta { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; flex-wrap: wrap; }
    .event-meta-item { font-size: 11px; color: var(--silver); display: flex; align-items: center; gap: 6px; }
    .event-meta-item svg { width: 12px; height: 12px; stroke: var(--silver-dim); fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
    .event-meta-sep { color: var(--silver-dim); font-size: 11px; }
    .event-desc { font-size: 13px; font-weight: 300; color: var(--silver-dim); line-height: 1.8; max-width: 520px; }
    .event-actions { margin-top: 20px; }
    .event-action-btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; background: #25D366; color: #fff; border-radius: 8px; font-size: 12px; font-weight: 500; letter-spacing: 0.3px; text-decoration: none; transition: opacity 0.15s; }
    .event-action-btn:hover { opacity: 0.85; }

    /* Section header */
    .section-header { margin-bottom: 36px; padding-bottom: 24px; border-bottom: 1px solid var(--border); }
    .section-eyebrow { font-size: 9px; letter-spacing: 4px; text-transform: uppercase; color: var(--silver-dim); margin-bottom: 10px; }
    .section-title { font-family: var(--g); font-size: 28px; font-weight: 400; color: var(--white); }

    /* Mobile */
    .mobile-topbar { display: none; }
    .mobile-nav { display: none; }

    @media (max-width: 768px) {
      .layout { grid-template-columns: 1fr; }
      .sidebar { display: none; }
      .main { padding: 24px 20px 100px; }
      .mobile-topbar {
        display: flex; align-items: center; justify-content: space-between;
        padding: 16px 20px; border-bottom: 1px solid var(--border);
        background: var(--panel); position: sticky; top: 0; z-index: 10;
      }
      .mobile-brand { font-size: 8px; letter-spacing: 3px; text-transform: uppercase; color: var(--silver-dim); }
      .mobile-member { font-size: 12px; color: var(--silver); }
      .mobile-nav {
        display: flex; position: fixed; bottom: 0; left: 0; right: 0;
        background: var(--panel); border-top: 1px solid var(--border);
        padding: env(safe-area-inset-bottom, 0px) 0 0;
        z-index: 10;
      }
      .mobile-nav-item {
        flex: 1; display: flex; flex-direction: column; align-items: center;
        gap: 4px; padding: 12px 8px; cursor: pointer;
        font-size: 9px; letter-spacing: 1px; text-transform: uppercase; color: var(--silver-dim);
        transition: color 0.15s;
      }
      .mobile-nav-item.active { color: var(--white); }
      .mobile-nav-item svg { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
      .stats-row { grid-template-columns: 1fr 1fr; }
      .home-tiles { grid-template-columns: 1fr 1fr; grid-template-rows: 175px 175px 145px; }
      .home-tiles .htile:nth-child(1) { grid-column: 1 / 2; }
      .home-tiles .htile:nth-child(2) { grid-column: 2 / 3; }
      .announce-banner { flex-wrap: wrap; gap: 10px; }

    }

    /* The House */
    .house-composer {
      background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 20px 22px; margin-bottom: 28px;
    }
    .house-input {
      width: 100%; background: transparent; border: none; outline: none;
      color: var(--cream); font-family: var(--s); font-size: 14px; line-height: 1.65;
      resize: none; min-height: 72px;
    }
    .house-input::placeholder { color: var(--silver-dim); }
    .house-composer-footer {
      display: flex; align-items: center; justify-content: space-between;
      padding-top: 14px; border-top: 1px solid var(--border); margin-top: 8px;
    }
    .house-photo-btn {
      display: flex; align-items: center; gap: 7px;
      font-size: 10px; letter-spacing: 2px; text-transform: uppercase;
      color: var(--silver-dim); cursor: pointer; transition: color 0.15s;
    }
    .house-photo-btn:hover { color: var(--silver); }
    .house-photo-btn svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
    .house-photo-btn.has-photo { color: var(--silver); }
    .house-post-btn {
      font-family: var(--s); font-size: 10px; letter-spacing: 2px; text-transform: uppercase;
      font-weight: 600; background: var(--silver); color: var(--black);
      border: none; padding: 9px 20px; border-radius: 100px; cursor: pointer;
      transition: opacity 0.15s;
    }
    .house-post-btn:hover { opacity: 0.85; }
    .house-post-btn:disabled { opacity: 0.35; cursor: not-allowed; }
    .house-msg { font-size: 11px; color: var(--silver-dim); margin-top: 10px; min-height: 16px; }
    .house-msg.err { color: #e05555; }

    .house-feed { display: flex; flex-direction: column; gap: 14px; }
    .house-loading { font-size: 12px; color: var(--silver-dim); padding: 32px 0; text-align: center; }
    .house-empty { font-size: 12px; color: var(--silver-dim); padding: 40px 0; text-align: center; }

    .hpost {
      background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 20px 22px; animation: fadeUp 0.4s ease both;
      transition: border-color 0.2s;
    }
    .hpost:hover { border-color: var(--border-mid); }
    .hpost-header { display: flex; align-items: center; gap: 11px; margin-bottom: 14px; }
    .hpost-avatar {
      width: 32px; height: 32px; border-radius: 50%; background: var(--silver-dim);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--g); font-size: 13px; font-weight: 500; color: var(--white);
      flex-shrink: 0;
    }
    .hpost-meta { flex: 1; }
    .hpost-name { font-size: 13px; font-weight: 500; color: var(--white); }
    .hpost-time { font-size: 10px; color: var(--silver-dim); margin-top: 1px; letter-spacing: 0.3px; }
    .hpost-del {
      font-size: 10px; color: var(--silver-dim); background: none; border: none;
      cursor: pointer; padding: 4px 8px; border-radius: 6px; transition: color 0.15s; flex-shrink: 0;
    }
    .hpost-del:hover { color: #e05555; }
    .hpost-text { font-size: 14px; line-height: 1.7; color: var(--cream); white-space: pre-wrap; word-break: break-word; }
    .hpost-photo { margin-top: 14px; border-radius: 10px; overflow: hidden; max-height: 400px; }
    .hpost-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }

  </style>
</head>
