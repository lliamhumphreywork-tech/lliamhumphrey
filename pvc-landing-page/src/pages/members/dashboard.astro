<script is:inline>
  // Member directory search
  let memberSearchVal = '';

  function applyMemberSearch() {
    let count = 0;
    document.querySelectorAll('.mcard').forEach(card => {
      const name = card.dataset.name ?? '';
      const biz = card.dataset.biz ?? '';
      const show = !memberSearchVal || name.includes(memberSearchVal) || biz.includes(memberSearchVal);
      card.classList.toggle('hidden', !show);
      if (show) count++;
    });
    const ct = document.getElementById('member-count');
    if (ct) ct.textContent = count + (count === 1 ? ' Member' : ' Members');
  }

  const memberSearch = document.getElementById('member-search');
  if (memberSearch) {
    memberSearch.addEventListener('input', () => {
      memberSearchVal = memberSearch.value.trim().toLowerCase();
      applyMemberSearch();
    });
  }

  document.querySelectorAll('.rfilter').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.rfilter').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const cat = btn.dataset.rcat;
      document.querySelectorAll('.rcard').forEach(card => {
        card.classList.toggle('hidden', cat !== 'all' && card.dataset.rcat !== cat);
      });
    });
  });

  document.querySelectorAll('.tfilter').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tfilter').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const cat = btn.dataset.cat;
      document.querySelectorAll('.tcard').forEach(card => {
        card.classList.toggle('hidden', cat !== 'all' && card.dataset.cat !== cat);
      });
    });
  });

  (function initGlobe() {
    const canvas = document.getElementById('globe-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const W = canvas.width, H = canvas.height;
    const R = 218;
    const cx = W / 2 + 14, cy = H / 2;

    const LAT0 = -20 * Math.PI / 180;
    const LON0 = 22 * Math.PI / 180;

    function project(latDeg, lonDeg) {
      const lat = latDeg * Math.PI / 180;
      const lon = lonDeg * Math.PI / 180;
      const x = R * Math.cos(lat) * Math.sin(lon - LON0);
      const y = -R * (Math.cos(LAT0) * Math.sin(lat) - Math.sin(LAT0) * Math.cos(lat) * Math.cos(lon - LON0));
      const z = Math.sin(LAT0) * Math.sin(lat) + Math.cos(LAT0) * Math.cos(lat) * Math.cos(lon - LON0);
      return { x: cx + x, y: cy + y, visible: z > 0 };
    }

    const CONTINENTS = [
      // Africa
      [
        [37,10],[35,11],[32,12],[30,32],[28,34],[12,44],[2,42],[-5,40],[-12,40],
        [-17,36],[-22,35],[-26,33],[-29,31],[-34,26],[-35,20],[-34,18],[-30,17],
        [-25,15],[-18,12],[-5,10],[0,8],[5,2],[4,-9],[5,-5],[6,-3],
        [6,1],[4,7],[5,8],[10,15],[15,16],[20,16],[22,15],[15,20],[12,23],
        [10,24],[15,25],[20,24],[22,30],[22,36],[12,42],[11,43],[12,44],
        [15,42],[20,38],[25,38],[30,33],[33,35],[37,10]
      ],
      // Europe
      [
        [71,29],[70,19],[68,14],[62,4],[56,8],[52,4],[48,2],[44,4],[42,14],
        [42,22],[44,28],[47,30],[52,33],[58,30],[60,25],[64,26],[68,28],[71,29]
      ],
      // Asia
      [
        [42,52],[55,60],[55,80],[60,90],[55,100],[50,140],[45,142],[38,142],
        [35,136],[30,122],[20,110],[10,100],[2,103],[1,104],[10,92],
        [22,88],[24,90],[30,78],[36,74],[42,70],[48,65],[50,58],[46,52],[42,52]
      ],
      // North America
      [
        [70,-140],[72,-110],[70,-85],[55,-64],[50,-54],[45,-60],[40,-70],
        [35,-76],[25,-80],[20,-87],[15,-90],[10,-85],[8,-80],[10,-75],[15,-88],
        [20,-90],[25,-105],[30,-110],[32,-117],[38,-123],[45,-124],[50,-126],
        [55,-130],[60,-140],[70,-140]
      ],
      // South America
      [
        [12,-72],[10,-62],[5,-52],[0,-50],[-5,-36],[-10,-37],[-15,-39],
        [-22,-43],[-30,-50],[-35,-58],[-42,-64],[-55,-66],[-55,-68],
        [-46,-65],[-40,-63],[-34,-58],[-28,-49],[-22,-42],[-10,-35],
        [-5,-35],[0,-50],[5,-52],[10,-62],[12,-72]
      ],
      // Australia
      [
        [-14,128],[-14,136],[-12,136],[-17,140],[-22,150],[-28,154],
        [-38,148],[-38,140],[-34,136],[-32,126],[-22,114],[-18,122],[-14,128]
      ],
    ];

    const SA_OUTLINE = [
      [-34.8,18.4],[-34.4,19.1],[-33.9,18.8],[-33.4,18.0],[-32.8,17.9],
      [-31.5,17.9],[-30.7,17.1],[-29.4,16.9],[-28.7,16.5],[-28.0,16.7],
      [-27.0,17.2],[-26.0,18.0],[-25.3,19.0],[-24.2,20.3],[-23.5,20.0],
      [-22.4,20.0],[-22.0,29.0],[-22.2,31.5],[-22.9,32.0],[-24.0,32.5],
      [-25.5,33.3],[-26.5,33.0],[-27.0,33.2],[-27.3,32.5],[-28.0,32.8],
      [-29.0,31.4],[-29.8,30.8],[-30.5,29.6],[-31.5,29.2],[-32.0,28.7],
      [-33.0,27.5],[-33.8,26.0],[-34.0,25.0],[-34.8,24.0],[-34.9,22.5],
      [-34.8,20.0],[-34.8,18.4]
    ];

    const LESOTHO = [
      [-29.5,27.0],[-28.8,27.2],[-28.5,28.0],[-29.0,29.5],[-29.6,29.5],
      [-30.0,28.5],[-30.0,27.5],[-29.5,27.0]
    ];

    const pins = [
      { lat: -33.9, lon: 18.4, color: '#c9a84c', shadow: 'rgba(201,168,76,0.6)', label: 'CPT' },
      { lat: -26.2, lon: 28.0, color: '#4a8fe8', shadow: 'rgba(74,143,232,0.6)', label: 'JHB' },
      { lat: -25.7, lon: 28.2, color: '#3ecf8e', shadow: 'rgba(62,207,142,0.6)', label: 'PTA' },
      { lat: -29.3, lon: 27.5, color: '#9b6be0', shadow: 'rgba(155,107,224,0.6)', label: 'LES' },
    ];

    let tick = 0;

    function drawPoly(coords, fill, stroke, lw) {
      ctx.beginPath();
      let started = false;
      for (const [lat, lon] of coords) {
        const p = project(lat, lon);
        if (!p.visible) { if (started) { ctx.closePath(); ctx.fillStyle = fill; ctx.fill(); ctx.strokeStyle = stroke; ctx.lineWidth = lw; ctx.stroke(); ctx.beginPath(); started = false; } continue; }
        started ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y);
        started = true;
      }
      if (started) {
        ctx.closePath();
        ctx.fillStyle = fill;
        ctx.fill();
        ctx.strokeStyle = stroke;
        ctx.lineWidth = lw;
        ctx.stroke();
      }
    }

    function drawGlobe() {
      ctx.clearRect(0, 0, W, H);

      const atmGrad = ctx.createRadialGradient(cx - 30, cy - 30, R * 0.6, cx, cy, R * 1.18);
      atmGrad.addColorStop(0, 'rgba(74,143,232,0.08)');
      atmGrad.addColorStop(0.7, 'rgba(30,80,160,0.04)');
      atmGrad.addColorStop(1, 'rgba(74,143,232,0)');
      ctx.beginPath();
      ctx.arc(cx, cy, R * 1.18, 0, Math.PI * 2);
      ctx.fillStyle = atmGrad;
      ctx.fill();

      const oceanGrad = ctx.createRadialGradient(cx - 50, cy - 50, 12, cx, cy, R);
      oceanGrad.addColorStop(0, '#162840');
      oceanGrad.addColorStop(0.5, '#0b1a2e');
      oceanGrad.addColorStop(1, '#050c1a');
      ctx.beginPath();
      ctx.arc(cx, cy, R, 0, Math.PI * 2);
      ctx.fillStyle = oceanGrad;
      ctx.fill();

      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, R, 0, Math.PI * 2);
      ctx.clip();

      ctx.strokeStyle = 'rgba(168,184,200,0.035)';
      ctx.lineWidth = 0.5;
      for (let latDeg = -80; latDeg <= 80; latDeg += 15) {
        ctx.beginPath();
        let first = true;
        for (let lonDeg = -180; lonDeg <= 180; lonDeg += 2) {
          const p = project(latDeg, lonDeg);
          if (!p.visible) { first = true; continue; }
          first ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y);
          first = false;
        }
        ctx.stroke();
      }
      for (let lonDeg = -180; lonDeg < 180; lonDeg += 15) {
        ctx.beginPath();
        let first = true;
        for (let latDeg = -90; latDeg <= 90; latDeg += 2) {
          const p = project(latDeg, lonDeg);
          if (!p.visible) { first = true; continue; }
          first ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y);
          first = false;
        }
        ctx.stroke();
      }
      ctx.restore();

      for (const continent of CONTINENTS) {
        drawPoly(continent, 'rgba(30,60,95,0.75)', 'rgba(100,140,180,0.18)', 0.8);
      }
      drawPoly(SA_OUTLINE, 'rgba(26,52,90,0.9)', 'rgba(168,184,200,0.30)', 1);
      drawPoly(LESOTHO, 'rgba(14,26,50,0.9)', 'rgba(155,107,224,0.35)', 0.8);

      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, R, 0, Math.PI * 2);
      ctx.clip();
      const specGrad = ctx.createRadialGradient(cx - 80, cy - 80, 8, cx - 40, cy - 40, R * 0.8);
      specGrad.addColorStop(0, 'rgba(255,255,255,0.05)');
      specGrad.addColorStop(0.4, 'rgba(255,255,255,0.015)');
      specGrad.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = specGrad;
      ctx.fillRect(cx - R, cy - R, R * 2, R * 2);
      ctx.restore();

      ctx.strokeStyle = 'rgba(168,184,200,0.10)';
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.arc(cx, cy, R, 0, Math.PI * 2);
      ctx.stroke();

      const pulse = 0.5 + 0.5 * Math.sin(tick * 0.05);
      for (const pin of pins) {
        const p = project(pin.lat, pin.lon);
        if (!p.visible) continue;

        const rOuter = 10 + 5 * pulse;
        const glowGrad = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, rOuter * 2.5);
        glowGrad.addColorStop(0, pin.shadow);
        glowGrad.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.beginPath();
        ctx.arc(p.x, p.y, rOuter * 2.5, 0, Math.PI * 2);
        ctx.fillStyle = glowGrad;
        ctx.fill();

        ctx.beginPath();
        ctx.arc(p.x, p.y, rOuter, 0, Math.PI * 2);
        ctx.strokeStyle = pin.shadow;
        ctx.globalAlpha = 0.25 + 0.2 * pulse;
        ctx.lineWidth = 1.5;
        ctx.stroke();
        ctx.globalAlpha = 1;

        ctx.beginPath();
        ctx.arc(p.x, p.y, 4.5, 0, Math.PI * 2);
        ctx.fillStyle = pin.color;
        ctx.fill();
        ctx.strokeStyle = 'rgba(255,255,255,0.35)';
        ctx.lineWidth = 1;
        ctx.stroke();
      }

      tick++;
      requestAnimationFrame(drawGlobe);
    }

    drawGlobe();
  })();

  // The House
  const CURRENT_EMAIL = document.getElementById('section-house')?.dataset.email ?? '';

  function houseTimeAgo(iso) {
    const d = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
    if (d < 60) return 'just now';
    if (d < 3600) return Math.floor(d / 60) + 'm ago';
    if (d < 86400) return Math.floor(d / 3600) + 'h ago';
    return Math.floor(d / 86400) + 'd ago';
  }

  function houseRender(posts) {
    const feed = document.getElementById('house-feed');
    if (!feed) return;
    if (!posts.length) { feed.innerHTML = '<div class="house-empty">Nothing posted yet. Be first.</div>'; return; }
    feed.innerHTML = posts.map((p, i) => `
      <div class="hpost" style="--i:${i}">
        <div class="hpost-header">
          <div class="hpost-avatar">${p.authorInitial}</div>
          <div class="hpost-meta">
            <div class="hpost-name">${p.authorName}</div>
            <div class="hpost-time">${houseTimeAgo(p.createdAt)}</div>
          </div>
          ${p.authorEmail === CURRENT_EMAIL ? `<button class="hpost-del" data-del-id="${p.id}">Remove</button>` : ''}
        </div>
        <div class="hpost-text">${p.text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}</div>
        ${p.photoUrl ? `<div class="hpost-photo"><img src="${p.photoUrl}" alt="" loading="lazy" /></div>` : ''}
      </div>`).join('');
  }

  async function houseLoad() {
    const feed = document.getElementById('house-feed');
    if (!feed) return;
    feed.innerHTML = '<div class="house-loading">Loading...</div>';
    try {
      const r = await fetch('/api/members/house-posts').then(r => r.json());
      houseRender(r.posts ?? []);
    } catch { feed.innerHTML = '<div class="house-empty">Could not load posts.</div>'; }
  }

  async function housePost() {
    const text = document.getElementById('house-text').value.trim();
    if (!text) return;
    const photo = document.getElementById('house-photo-input').files?.[0];
    const btn = document.getElementById('house-post-btn');
    const msg = document.getElementById('house-msg');
    btn.disabled = true; btn.textContent = 'Posting...';
    msg.textContent = ''; msg.className = 'house-msg';
    const fd = new FormData();
    fd.append('text', text);
    if (photo) fd.append('photo', photo);
    try {
      const r = await fetch('/api/members/house-posts', { method: 'POST', body: fd }).then(r => r.json());
      if (r.ok) {
        document.getElementById('house-text').value = '';
        document.getElementById('house-photo-input').value = '';
        document.getElementById('house-photo-label').textContent = 'Photo';
        document.querySelector('.house-photo-btn')?.classList.remove('has-photo');
        await houseLoad();
      } else { msg.textContent = r.error || 'Failed to post'; msg.className = 'house-msg err'; }
    } catch { msg.textContent = 'Network error'; msg.className = 'house-msg err'; }
    finally { btn.disabled = false; btn.textContent = 'Post'; }
  }

  async function houseDel(id, btn) {
    if (!confirm('Remove this post?')) return;
    btn.textContent = '...'; btn.disabled = true;
    const r = await fetch('/api/members/house-posts', {
      method: 'DELETE', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id }),
    }).then(r => r.json());
    if (r.ok) houseLoad();
    else { btn.textContent = 'Remove'; btn.disabled = false; }
  }

  document.getElementById('house-feed')?.addEventListener('click', async e => {
    const btn = e.target.closest('[data-del-id]');
    if (!btn) return;
    const id = btn.dataset.delId;
    await houseDel(id, btn);
  });

  document.getElementById('house-photo-input')?.addEventListener('change', function() {
    const label = document.getElementById('house-photo-label');
    const btn = document.querySelector('.house-photo-btn');
    if (this.files?.[0]) { label.textContent = this.files[0].name.slice(0, 20); btn?.classList.add('has-photo'); }
    else { label.textContent = 'Photo'; btn?.classList.remove('has-photo'); }
  });

  if (document.getElementById('section-house')?.classList.contains('active')) houseLoad();

  document.querySelectorAll('a[href*="s=house"]').forEach(a => {
    a.addEventListener('click', () => setTimeout(houseLoad, 50));
  });

  window.houseDel = houseDel;
</script>

{needsOnboarding && (
<div id="ob-overlay" style="position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;background:rgba(8,17,31,0.78);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);">
