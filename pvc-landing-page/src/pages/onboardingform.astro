---
export const prerender = false;
const PH_KEY = import.meta.env.PUBLIC_POSTHOG_KEY ?? '';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Member Onboarding — Private Victories Club</title>
<meta name="robots" content="noindex" />
<script define:vars={{ PH_KEY }} is:inline>window.__PVC_PH_KEY = PH_KEY;</script>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet" />
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --black:       #000000;
  --charcoal:    #0d0008;
  --plum:        #45183F;
  --plum-deep:   #2d0f29;
  --plum-mid:    #5c2257;
  --lavender:    #C4B8C0;
  --lavender-dim:#9B8F98;
  --blush:       #F0EBF0;
  --blush-ink:   #1A0F18;
  --white:       #F4F1EE;
  --border:      rgba(196,184,192,0.12);
  --border-hover:rgba(196,184,192,0.28);
  --g: 'Syne', sans-serif;
  --s: 'DM Sans', sans-serif;
}

html, body {
  height: 100%;
  background: var(--black);
  color: var(--white);
  font-family: var(--s);
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

.layout {
  display: flex;
  min-height: 100vh;
}

.form-col {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}

.card-col {
  width: 460px;
  flex-shrink: 0;
  position: sticky;
  top: 0;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--charcoal);
  border-left: 1px solid rgba(196,184,192,0.06);
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28px 56px;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}

.nav-wordmark {
  font-family: var(--g);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--white);
  text-decoration: none;
  opacity: 0.9;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 24px;
}

.step-counter {
  font-family: var(--g);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 3px;
  color: var(--lavender-dim);
}

.nav-back {
  font-family: var(--s);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--lavender-dim);
  text-decoration: none;
  transition: color 0.2s;
  cursor: pointer;
  background: none;
  border: none;
  padding: 0;
}
.nav-back:hover { color: var(--lavender); }
.nav-back[hidden] { display: none; }

.progress-bar {
  height: 1px;
  background: var(--border);
  flex-shrink: 0;
}
.progress-fill {
  height: 100%;
  background: var(--lavender);
  transition: width 0.4s ease;
  width: 14%;
}

.steps-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 56px 56px 64px;
}

.step {
  display: none;
  flex-direction: column;
  animation: fadeIn 0.3s ease;
}
.step.active { display: flex; }

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}

.step-eyebrow {
  font-family: var(--g);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--lavender-dim);
  margin-bottom: 16px;
}

.step-title {
  font-family: var(--g);
  font-size: clamp(22px, 3.2vw, 34px);
  font-weight: 700;
  line-height: 1.12;
  letter-spacing: -0.4px;
  color: var(--white);
  text-wrap: balance;
  margin-bottom: 8px;
}

.step-hint {
  font-family: var(--s);
  font-size: 14px;
  font-weight: 300;
  line-height: 1.65;
  color: var(--lavender-dim);
  margin-bottom: 36px;
  max-width: 480px;
}

.field-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px 24px;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 24px;
}
.field:last-of-type { margin-bottom: 0; }
.field-grid .field { margin-bottom: 0; }

.field label {
  font-family: var(--g);
  font-size: 9.5px;
  font-weight: 600;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--lavender-dim);
}

.field input,
.field textarea {
  background: transparent;
  border: none;
  border-bottom: 1px solid var(--border);
  color: var(--white);
  font-family: var(--s);
  font-size: 16px;
  font-weight: 300;
  padding: 10px 0 12px;
  outline: none;
  transition: border-color 0.2s;
  width: 100%;
  -webkit-appearance: none;
}
.field input::placeholder,
.field textarea::placeholder {
  color: var(--lavender-dim);
  opacity: 0.45;
}
.field input:focus,
.field textarea:focus {
  border-bottom-color: rgba(196,184,192,0.6);
}
.field textarea {
  resize: none;
  min-height: 100px;
  line-height: 1.65;
}

/* Team size tiles (single-select) */
.tile-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}
.tile {
  border: 1px solid var(--border);
  padding: 20px 18px;
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s;
  position: relative;
  user-select: none;
  -webkit-user-select: none;
}
.tile:hover { border-color: var(--border-hover); background: rgba(196,184,192,0.04); }
.tile.selected { border-color: var(--lavender); background: rgba(196,184,192,0.07); }
.tile.selected::after {
  content: '';
  position: absolute;
  top: 10px; right: 10px;
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--lavender);
}
.tile-value {
  font-family: var(--g);
  font-size: 13px;
  font-weight: 600;
  color: var(--white);
  letter-spacing: -0.2px;
  line-height: 1.3;
  pointer-events: none;
}
.tile-sub {
  font-family: var(--s);
  font-size: 10px;
  font-weight: 400;
  color: var(--lavender-dim);
  margin-top: 3px;
  pointer-events: none;
}

/* PVC goals multi-select */
.need-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
}
.need-tile {
  border: 1px solid var(--border);
  padding: 18px 16px;
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s;
  position: relative;
  user-select: none;
  -webkit-user-select: none;
}
.need-tile:hover { border-color: var(--border-hover); background: rgba(196,184,192,0.04); }
.need-tile.selected { border-color: var(--lavender); background: rgba(196,184,192,0.07); }
.need-tile.selected::after {
  content: '';
  position: absolute;
  top: 10px; right: 10px;
  width: 5px; height: 5px;
  border-radius: 50%;
  background: var(--lavender);
}
.need-tile-label {
  font-family: var(--g);
  font-size: 12px;
  font-weight: 600;
  color: var(--white);
  pointer-events: none;
}
.need-tile-sub {
  font-family: var(--s);
  font-size: 10px;
  font-weight: 300;
  color: var(--lavender-dim);
  margin-top: 4px;
  pointer-events: none;
}

.step-nav {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-top: 40px;
}

.next-btn {
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--white);
  color: var(--black);
  border: none;
  padding: 18px 32px;
  font-family: var(--g);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.2s, opacity 0.2s;
  outline: none;
  flex-shrink: 0;
}
.next-btn:hover { background: var(--blush); }
.next-btn:disabled { opacity: 0.4; cursor: not-allowed; }
.next-btn.plum { background: var(--plum); color: var(--white); }
.next-btn.plum:hover { background: var(--plum-mid); }

.field-error {
  font-family: var(--s);
  font-size: 11px;
  color: #d4655d;
  display: none;
}
.field-error.visible { display: block; }
.step-error {
  font-family: var(--s);
  font-size: 12px;
  color: #d4655d;
  margin-top: 12px;
  display: none;
}
.step-error.visible { display: block; }

/* Success */
.success-step {
  display: none;
  flex-direction: column;
  justify-content: center;
  padding: 56px;
  flex: 1;
}
.success-step.visible { display: flex; }
.form-col.submitted .steps-wrap { display: none; }

.success-eyebrow {
  font-family: var(--g);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--lavender-dim);
  margin-bottom: 20px;
}
.success-title {
  font-family: var(--g);
  font-size: clamp(28px, 4vw, 44px);
  font-weight: 700;
  color: var(--white);
  line-height: 1.1;
  margin-bottom: 20px;
}
.success-body {
  font-family: var(--s);
  font-size: 15px;
  font-weight: 300;
  color: var(--lavender-dim);
  line-height: 1.75;
  max-width: 440px;
}

/* Card preview */
.card-inner {
  padding: 48px;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}
.preview-card {
  width: 100%;
  max-width: 360px;
  aspect-ratio: 1.58 / 1;
  background: linear-gradient(135deg, var(--blush) 0%, var(--plum-deep) 52%, #000000 100%);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 28px 30px;
  transition: box-shadow 0.4s;
}
.preview-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom right, transparent 30%, rgba(0,0,0,0.45) 100%);
  pointer-events: none;
}
.preview-card.submitted {
  box-shadow: 0 0 0 1px rgba(196,184,192,0.3), 0 20px 60px rgba(69,24,63,0.25);
}
.preview-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}
.preview-wordmark {
  font-family: var(--g);
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--blush-ink);
  line-height: 1.6;
  mix-blend-mode: multiply;
}
.preview-status {
  font-family: var(--g);
  font-size: 7.5px;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--white);
  border: 1px solid rgba(244,241,238,0.3);
  padding: 4px 9px;
  background: rgba(0,0,0,0.2);
}
.preview-mid { position: relative; z-index: 1; }
.preview-name {
  font-family: var(--g);
  font-size: 26px;
  font-weight: 800;
  color: var(--white);
  letter-spacing: -0.5px;
  line-height: 1.05;
  text-shadow: 0 1px 8px rgba(0,0,0,0.4);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  transition: opacity 0.2s;
}
.preview-name.placeholder {
  font-size: 13px;
  font-weight: 300;
  color: rgba(244,241,238,0.35);
  letter-spacing: 0;
}
.preview-biz {
  font-family: var(--s);
  font-size: 11px;
  font-weight: 300;
  color: rgba(196,184,192,0.65);
  margin-top: 6px;
  min-height: 14px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.preview-card-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}
.preview-member-label {
  font-family: var(--g);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--lavender);
}
.preview-wm-bg {
  position: absolute;
  bottom: -10px; right: -8px;
  font-family: var(--g);
  font-size: 72px;
  font-weight: 800;
  letter-spacing: -6px;
  color: rgba(26,15,24,0.08);
  user-select: none;
  pointer-events: none;
  line-height: 1;
}
.card-caption {
  font-family: var(--g);
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: rgba(196,184,192,0.2);
  text-align: center;
}

@media (max-width: 1024px) {
  .card-col { width: 380px; }
  .preview-name { font-size: 20px; }
}
@media (max-width: 768px) {
  .layout { flex-direction: column; }
  .card-col { display: none; }
  .nav { padding: 20px 24px; }
  .steps-wrap { padding: 40px 24px 56px; }
  .success-step { padding: 40px 24px; }
  .tile-grid { grid-template-columns: repeat(2, 1fr); }
  .need-grid { grid-template-columns: 1fr; }
  .field-grid { grid-template-columns: 1fr; }
}
</style>
</head>
<body>
<div class="layout">

  <div class="form-col" id="formCol">

    <nav class="nav">
      <a href="/" class="nav-wordmark">Private Victories</a>
      <div class="nav-right">
        <span class="step-counter" id="stepCounter">1 / 8</span>
        <button class="nav-back" id="backBtn" onclick="prevStep()" hidden>← Back</button>
      </div>
    </nav>

    <div class="progress-bar">
      <div class="progress-fill" id="progressFill"></div>
    </div>

    <div class="success-step" id="successStep">
      <p class="success-eyebrow">Onboarding Complete</p>
      <h1 class="success-title">You're set up.<br>See you in the room.</h1>
      <p class="success-body">
        We've got everything we need. Your integration call is next<br><br>
        if you haven't booked it yet, check your welcome email for the link.
      </p>
    </div>

    <div class="steps-wrap" id="stepsWrap">
      <form id="onboardForm" novalidate>

        <!-- Step 1: About you -->
        <div class="step active" data-step="0">
          <p class="step-eyebrow">Section 01 · About You</p>
          <h2 class="step-title">Let's start with who you are.</h2>
          <p class="step-hint">The person behind the business.</p>
          <div class="field-grid" style="margin-bottom:20px">
            <div class="field">
              <label for="fullName">Full Name *</label>
              <input type="text" id="fullName" placeholder="Your full name" autocomplete="name" />
              <span class="field-error" id="fullNameErr">Required</span>
            </div>
            <div class="field">
              <label for="preferredName">What should members call you?</label>
              <input type="text" id="preferredName" placeholder="Nickname or first name" />
            </div>
            <div class="field">
              <label for="email">Email *</label>
              <input type="email" id="email" placeholder="you@example.com" autocomplete="email" />
              <span class="field-error" id="emailErr">Valid email required</span>
            </div>
            <div class="field">
              <label for="location">Where are you based?</label>
              <input type="text" id="location" placeholder="City, Country" />
            </div>
          </div>
          <div class="field">
            <label for="social">Instagram handle</label>
            <input type="text" id="social" placeholder="@yourhandle" />
          </div>
          <div class="step-nav">
            <button type="button" class="next-btn" onclick="nextStep()">Continue <span>→</span></button>
          </div>
        </div>

        <!-- Step 2: Your business -->
        <div class="step" data-step="1">
          <p class="step-eyebrow">Section 02 · Your Business</p>
          <h2 class="step-title">Tell us about what you're building.</h2>
          <p class="step-hint">Understanding what you do, who you serve, and how you make money.</p>
          <div class="field">
            <label for="businessName">Business name and website</label>
            <input type="text" id="businessName" placeholder="Acme Inc. · acmeinc.co.za" />
          </div>
          <div class="field">
            <label for="businessDescription">What does your business do? Who do you serve, and how do you make money? *</label>
            <textarea id="businessDescription" placeholder="Be specific — what you do, for whom, and how the money flows." rows="5"></textarea>
            <span class="field-error" id="businessDescErr">Required</span>
          </div>
          <div class="step-nav">
            <button type="button" class="next-btn" onclick="nextStep()">Continue <span>→</span></button>
          </div>
        </div>

        <!-- Step 3: Team -->
        <div class="step" data-step="2">
          <p class="step-eyebrow">Section 02 · Your Business</p>
          <h2 class="step-title">How many people are on your team?</h2>
          <p class="step-hint">Including full-time, part-time, and key contractors.</p>
          <div class="tile-grid" id="teamTiles">
            <div class="tile" data-value="Just me" onclick="selectTeam(this)">
              <div class="tile-value">Just me</div>
              <div class="tile-sub">Solo founder</div>
            </div>
            <div class="tile" data-value="2–5 people" onclick="selectTeam(this)">
              <div class="tile-value">2 – 5</div>
              <div class="tile-sub">Small team</div>
            </div>
            <div class="tile" data-value="6–15 people" onclick="selectTeam(this)">
              <div class="tile-value">6 – 15</div>
              <div class="tile-sub">Growing</div>
            </div>
            <div class="tile" data-value="16–50 people" onclick="selectTeam(this)">
              <div class="tile-value">16 – 50</div>
              <div class="tile-sub">Mid-size</div>
            </div>
            <div class="tile" data-value="50+ people" onclick="selectTeam(this)">
              <div class="tile-value">50+</div>
              <div class="tile-sub">Scale</div>
            </div>
          </div>
          <div class="step-nav" style="margin-top:32px">
            <button type="button" class="next-btn" onclick="nextStep()">Continue <span>→</span></button>
          </div>
        </div>

        <!-- Step 4: Where you're going -->
        <div class="step" data-step="3">
          <p class="step-eyebrow">Section 03 · Where You're Going</p>
          <h2 class="step-title">Where are you right now, and where are you headed?</h2>
          <p class="step-hint">Not the polished version. What's actually on your plate.</p>
          <div class="field">
            <label for="challenge">What's your biggest business challenge right now? *</label>
            <textarea id="challenge" placeholder="Be direct. What's the thing you're wrestling with?" rows="4"></textarea>
            <span class="field-error" id="challengeErr">Required</span>
          </div>
          <div class="field">
            <label for="goal90">What's your primary goal over the next 90 days? *</label>
            <textarea id="goal90" placeholder="Specific and measurable if possible." rows="4"></textarea>
            <span class="field-error" id="goal90Err">Required</span>
          </div>
          <div class="step-nav">
            <button type="button" class="next-btn" onclick="nextStep()">Continue <span>→</span></button>
          </div>
        </div>

        <!-- Step 5: What you're looking for -->
        <div class="step" data-step="4">
          <p class="step-eyebrow">Section 04 · What You're Looking For</p>
          <h2 class="step-title">What would you most like to get out of PVC?</h2>
          <p class="step-hint">Select everything that applies.</p>
          <div class="need-grid" id="pvcGoalTiles" style="margin-bottom:32px">
            <div class="need-tile" data-value="Collaborations / Partnerships" onclick="toggleGoal(this)">
              <div class="need-tile-label">Collaborations / Partnerships</div>
            </div>
            <div class="need-tile" data-value="Roundtables &amp; Guest Speakers" onclick="toggleGoal(this)">
              <div class="need-tile-label">Roundtables &amp; Guest Speakers</div>
            </div>
            <div class="need-tile" data-value="Accountability" onclick="toggleGoal(this)">
              <div class="need-tile-label">Accountability</div>
            </div>
            <div class="need-tile" data-value="Talent Network" onclick="toggleGoal(this)">
              <div class="need-tile-label">Talent Network</div>
            </div>
            <div class="need-tile" data-value="Lifestyle Benefits / Concierge" onclick="toggleGoal(this)">
              <div class="need-tile-label">Lifestyle Benefits / Concierge</div>
            </div>
            <div class="need-tile" data-value="Deal Flow / Business Opportunities" onclick="toggleGoal(this)">
              <div class="need-tile-label">Deal Flow / Business Opportunities</div>
            </div>
            <div class="need-tile" data-value="Access to high-value people" onclick="toggleGoal(this)">
              <div class="need-tile-label">Access to high-value people</div>
            </div>
            <div class="need-tile" data-value="Business Development / New Clients" onclick="toggleGoal(this)">
              <div class="need-tile-label">Business Development / New Clients</div>
            </div>
            <div class="need-tile" data-value="Something else" onclick="toggleGoal(this)">
              <div class="need-tile-label">Something else</div>
            </div>
          </div>
          <div class="field">
            <label for="wantsFromRoom">What do you actually want from the room?</label>
            <textarea id="wantsFromRoom" placeholder="In your own words — what would make PVC genuinely valuable to you?" rows="3"></textarea>
          </div>
          <div class="step-nav">
            <button type="button" class="next-btn" onclick="nextStep()">Continue <span>→</span></button>
          </div>
        </div>

        <!-- Step 6: Support areas -->
        <div class="step" data-step="5">
          <p class="step-eyebrow">Section 04 · What You're Looking For</p>
          <h2 class="step-title">What areas are you currently looking for support in?</h2>
          <p class="step-hint">Select all that apply.</p>
          <div class="need-grid" id="supportAreaTiles" style="margin-bottom:32px">
            <div class="need-tile" data-value="Sales &amp; Business Development" onclick="toggleSupport(this)">
              <div class="need-tile-label">Sales &amp; Business Development</div>
            </div>
