            <textarea id="introductions" placeholder="Describe the type of people, industries or expertise you're looking for." rows="3"></textarea>
          </div>
          <div class="step-nav">
            <button type="button" class="next-btn" onclick="nextStep()">Continue <span>→</span></button>
