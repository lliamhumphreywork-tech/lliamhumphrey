            </div>
            <div class="need-tile" data-value="Operations &amp; Systems" onclick="toggleSupport(this)">
              <div class="need-tile-label">Operations &amp; Systems</div>
            </div>
            <div class="need-tile" data-value="Hiring &amp; Recruitment" onclick="toggleSupport(this)">
              <div class="need-tile-label">Hiring &amp; Recruitment</div>
            </div>
            <div class="need-tile" data-value="Finance &amp; Financial Planning" onclick="toggleSupport(this)">
              <div class="need-tile-label">Finance &amp; Financial Planning</div>
            </div>
            <div class="need-tile" data-value="Legal &amp; Compliance" onclick="toggleSupport(this)">
              <div class="need-tile-label">Legal &amp; Compliance</div>
            </div>
            <div class="need-tile" data-value="Technology &amp; AI" onclick="toggleSupport(this)">
              <div class="need-tile-label">Technology &amp; AI</div>
            </div>
            <div class="need-tile" data-value="Strategic Partnerships" onclick="toggleSupport(this)">
              <div class="need-tile-label">Strategic Partnerships</div>
            </div>
            <div class="need-tile" data-value="Personal Development" onclick="toggleSupport(this)">
              <div class="need-tile-label">Personal Development</div>
