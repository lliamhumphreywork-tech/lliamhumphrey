              <div class="need-tile-label">Fashion &amp; Lifestyle</div>
            </div>
            <div class="need-tile" data-value="Arts, Music &amp; Culture" onclick="toggleInterest(this)">
              <div class="need-tile-label">Arts, Music &amp; Culture</div>
            </div>
            <div class="need-tile" data-value="Technology" onclick="toggleInterest(this)">
              <div class="need-tile-label">Technology</div>
