  <div class="card-col">
    <div class="card-inner">
      <div class="preview-card" id="previewCard">
        <div class="preview-card-top">
          <div class="preview-wordmark">Private<br>Victories<br>Club</div>
          <div class="preview-status" id="cardStatus">Member</div>
        </div>
        <div class="preview-mid">
          <div class="preview-name placeholder" id="cardName">Your name here</div>
          <div class="preview-biz" id="cardBiz">What are you building?</div>
        </div>
        <div class="preview-card-bottom">
          <div class="preview-member-label">Active Member</div>
        </div>
        <div class="preview-wm-bg">PVC</div>
      </div>
      <p class="card-caption">Private Victories Club · Membership</p>
    </div>
  </div>

</div>

<script is:inline>
  const TOTAL = 8;
  let current = 0;
  let selectedTeam = '';
  let selectedGoals = [];
  let selectedSupportAreas = [];
  let selectedInterests = [];

  const steps      = document.querySelectorAll('.step');
  const progFill   = document.getElementById('progressFill');
  const backBtn    = document.getElementById('backBtn');
  const stepCtr    = document.getElementById('stepCounter');
  const cardName   = document.getElementById('cardName');
  const cardBiz    = document.getElementById('cardBiz');

  function setStep(n) {
    steps.forEach((s, i) => s.classList.toggle('active', i === n));
    current = n;
    const pct = Math.round(((n + 1) / TOTAL) * 100);
    progFill.style.width = pct + '%';
    backBtn.hidden = n === 0;
    stepCtr.textContent = `${n + 1} / ${TOTAL}`;
    window.scrollTo(0, 0);
  }

  function nextStep() {
    if (current < TOTAL - 1) setStep(current + 1);
  }

  function prevStep() {
    if (current > 0) setStep(current - 1);
  }

  // Live card preview
  document.getElementById('fullName').addEventListener('input', function() {
    const v = this.value.trim();
    if (v) {
      cardName.textContent = v;
      cardName.classList.remove('placeholder');
    } else {
      cardName.textContent = 'Your name here';
      cardName.classList.add('placeholder');
    }
  });

  document.getElementById('businessName').addEventListener('input', function() {
    cardBiz.textContent = this.value.trim() || 'What are you building?';
  });

  // Pre-fill email from URL param
  (function() {
    const p = new URLSearchParams(window.location.search);
    const e = p.get('email');
    if (e) document.getElementById('email').value = e;
  })();

  function selectTeam(tile) {
    document.querySelectorAll('#teamTiles .tile').forEach(t => t.classList.remove('selected'));
    tile.classList.add('selected');
    selectedTeam = tile.dataset.value;
  }

  function toggleGoal(tile) {
    tile.classList.toggle('selected');
    const v = tile.dataset.value;
    selectedGoals = tile.classList.contains('selected')
      ? [...selectedGoals, v]
      : selectedGoals.filter(x => x !== v);
  }

  function toggleSupport(tile) {
    tile.classList.toggle('selected');
    const v = tile.dataset.value;
    selectedSupportAreas = tile.classList.contains('selected')
      ? [...selectedSupportAreas, v]
      : selectedSupportAreas.filter(x => x !== v);
  }

  function toggleInterest(tile) {
    tile.classList.toggle('selected');
    const v = tile.dataset.value;
    selectedInterests = tile.classList.contains('selected')
      ? [...selectedInterests, v]
      : selectedInterests.filter(x => x !== v);
  }

  document.getElementById('onboardForm').addEventListener('submit', async function(e) {
    e.preventDefault();

    const fullName         = document.getElementById('fullName').value.trim();
    const email            = document.getElementById('email').value.trim();
    const businessDesc     = document.getElementById('businessDescription').value.trim();
    const challenge        = document.getElementById('challenge').value.trim();
    const goal90           = document.getElementById('goal90').value.trim();
    const whatYouBring     = document.getElementById('whatYouBring').value.trim();

    let valid = true;
    if (!fullName)   { document.getElementById('fullNameErr').classList.add('visible'); valid = false; }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { document.getElementById('emailErr').classList.add('visible'); valid = false; }
    if (!businessDesc)  { document.getElementById('businessDescErr').classList.add('visible'); valid = false; }
    if (!challenge)     { document.getElementById('challengeErr').classList.add('visible'); valid = false; }
    if (!goal90)        { document.getElementById('goal90Err').classList.add('visible'); valid = false; }
    if (!whatYouBring)  { document.getElementById('whatYouBringErr').classList.add('visible'); valid = false; }

    if (!valid) {
      const errEl = document.getElementById('formError');
      errEl.textContent = 'Please go back and fill in all required fields.';
      errEl.classList.add('visible');
      return;
    }

    const btn = document.getElementById('submitBtn');
    btn.disabled = true;
    btn.querySelector('span').previousSibling.textContent = 'Submitting… ';

    try {
      const res = await fetch('/api/onboarding', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          full_name:         fullName,
          preferred_name:    document.getElementById('preferredName').value.trim(),
          email,
          location:          document.getElementById('location').value.trim(),
          social:            document.getElementById('social').value.trim(),
          business_name:     document.getElementById('businessName').value.trim(),
          business_description: businessDesc,
          team_size:         selectedTeam,
          challenge,
          goal_90_days:      goal90,
          pvc_goals:         selectedGoals.join(', '),
          wants_from_room:   document.getElementById('wantsFromRoom').value.trim(),
          support_areas:     selectedSupportAreas.join(', '),
          introductions:     document.getElementById('introductions').value.trim(),
          what_you_bring:    whatYouBring,
          interests_multi:   selectedInterests.join(', '),
          interests_other:   document.getElementById('interestsOther').value.trim(),
          anything_else:     document.getElementById('anythingElse').value.trim(),
        }),
      });

      if (!res.ok) {
        const d = await res.json().catch(() => ({}));
        throw new Error(d.error || 'Something went wrong. Please try again.');
      }

      document.getElementById('cardStatus').textContent = 'Complete';
      document.getElementById('previewCard').classList.add('submitted');
      document.getElementById('stepsWrap').style.display = 'none';
      document.getElementById('successStep').classList.add('visible');
      window.scrollTo(0, 0);

      if (typeof window.posthog !== 'undefined') {
        window.posthog.capture('onboarding_form_submitted', { email });
      }

    } catch (err) {
      const errEl = document.getElementById('formError');
      errEl.textContent = err.message;
      errEl.classList.add('visible');
      btn.disabled = false;
      btn.querySelector('span').previousSibling.textContent = 'Submit ';
    }
  });

  // PostHog
  const ph = window.__PVC_PH_KEY;
  if (ph) {
    !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+" people (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||(window.posthog=[]));
    window.posthog.init(ph, { api_host: 'https://eu.posthog.com', capture_pageview: true });
    window.posthog.capture('page_viewed', { page: 'onboarding_form' });
  }
</script>
</body>
</html>
