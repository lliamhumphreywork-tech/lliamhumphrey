---
export const prerender = false;
import { PADEL } from '../lib/padel-config';
import { notionQuery } from '../lib/notion';
import crypto from 'crypto';

const MAGIC_LINK_SECRET = import.meta.env.MAGIC_LINK_SECRET ?? '';

const token = Astro.url.searchParams.get('token') ?? '';
const ref   = Astro.url.searchParams.get('ref') ?? '';

// Verify HMAC token against each ticket row (we don't know the email upfront)
// Find the matching ticket first, then verify
let ticket: any = null;
let tokenValid  = false;
let formClosed  = false;

try {
  if (token && ref) {
    const rows = await notionQuery(PADEL.NOTION_PADEL_DB_ID, {
      property: 'Payment ID', rich_text: { equals: ref },
    });
    if (rows.length > 0) {
      const row   = rows[0];
      const email = row.properties['Email']?.email ?? '';
      const expected = MAGIC_LINK_SECRET
        ? crypto.createHmac('sha256', MAGIC_LINK_SECRET).update(`${ref}:${email}`).digest('hex')
        : '';
      tokenValid = expected !== '' && expected === token;
      if (tokenValid) ticket = row;
    }
  }
} catch (e: any) {
  console.error('[padel-confirm] Notion lookup failed:', e.message);
}

const now = new Date();
formClosed = now > new Date(PADEL.FORM_CLOSE_UTC);

// Extract existing answers if form already filled
const p = ticket?.properties ?? {};
const existing = {
  business:    (p['Business']?.rich_text ?? []).map((t: any) => t.plain_text).join(''),
  description: (p['Business Description']?.rich_text ?? []).map((t: any) => t.plain_text).join(''),
  stage:       p['Stage']?.select?.name ?? '',
  workingOn:   (p['Working On']?.rich_text ?? []).map((t: any) => t.plain_text).join(''),
  whoToMeet:   (p['Who to Meet']?.multi_select ?? []).map((t: any) => t.name),
  offer:       (p['Offer']?.rich_text ?? []).map((t: any) => t.plain_text).join(''),
  name:        (p['Name']?.title ?? []).map((t: any) => t.plain_text).join(''),
  email:       p['Email']?.email ?? '',
  playing:     p['Playing']?.select?.name ?? '',
  ticketType:  p['Ticket Type']?.select?.name ?? '',
  completed:   p['Form Completed']?.checkbox ?? false,
  consent:     p['Consent']?.checkbox ?? false,
};

const WHO_OPTIONS = [
  'Investor or VC',
  'Founder / CEO',
  'Scale-up operator',
  'Sales or BD lead',
  'Technical co-founder',
  'Marketing lead',
  'Finance or CFO',
  'Product / Design lead',
  'Lawyer or accountant',
  'Media or PR',
  'Creatives',
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>You're in — Padel Social | PVC</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body style="background:#0d0d0d;color:#fff;margin:0;font-family:'DM Sans',sans-serif;">
  <main class="pc-wrap">

    {!tokenValid ? (
      <div class="pc-card pc-card--error">
        <h1>Invalid or expired link</h1>
        <p>This confirmation link isn't valid. If you purchased a ticket, check your email for the correct link, or contact us at <a href="mailto:hello@privatevictoriesclub.com">hello@privatevictoriesclub.com</a>.</p>
      </div>
    ) : (
      <>
        <div class="pc-ticket">
          <span class="pc-badge">Ticket confirmed</span>
          <h1>You're in, {existing.name.split(' ')[0]}.</h1>
          <p class="pc-ticket-detail">
            <strong>Founders' Padel Social</strong> &mdash; Friday, 11 December 2026<br />
            {existing.playing === 'Yes' ? 'Playing padel' : 'Social only'} &middot; {existing.ticketType === 'Member' ? 'PVC Member' : 'General Admission'}
          </p>
          <p class="pc-ticket-refund">{PADEL.REFUND_POLICY}</p>
          <details class="pc-transfer-section">
            <summary>Transfer your spot to someone else</summary>
            <div class="pc-transfer-body">
              <p>If you can no longer attend, you can transfer your spot to another person before 8 December. Enter their details below — they'll receive a confirmation email and their own profile link.</p>
              <form id="transfer-form" novalidate>
                <input type="hidden" name="token" value={token} />
                <input type="hidden" name="ref"   value={ref} />
                <label class="pc-label">Their full name <span class="req">*</span></label>
                <input class="pc-input" type="text"  name="newName"  required placeholder="Jane Smith" />
                <label class="pc-label">Their email <span class="req">*</span></label>
                <input class="pc-input" type="email" name="newEmail" required placeholder="jane@example.com" />
                <div id="transfer-error"   class="pc-form-error" hidden></div>
                <div id="transfer-success" class="pc-saved-banner" hidden>Spot transferred. A confirmation has been sent to them. This link is now invalid.</div>
                <button type="submit" class="pc-btn" id="transfer-btn" style="background:#555;">Transfer my spot</button>
              </form>
            </div>
          </details>
        </div>

        <div class="pvc-card-section">
          <h2>Your attendee card</h2>
          <p class="pvc-card-desc" id="card-desc">{existing.business ? 'Your card is ready — download and share when you arrive.' : 'Your card is ready now. Complete your profile below to add your business.'}</p>
          <div class="pvc-card-wrap">
            <div
              class="pvc-card"
              id="pvc-card"
              data-name={existing.name}
              data-business={existing.business}
              data-playing={existing.playing === 'Yes' ? 'Playing' : 'Social'}
            >
              <div class="pvc-c-top">
                <span class="pvc-wordmark">PVC</span>
                <span class="pvc-ticket-type">Founders' Padel Social<br />Early Access</span>
              </div>
              <div class="pvc-c-body">
                <div class="pvc-name" id="card-name">{existing.name}</div>
                <div class="pvc-role" id="card-role" hidden={!existing.business}>{existing.business}</div>
                <div class="pvc-badge">
                  <span class="pvc-badge-dot"></span>
                  <span class="pvc-badge-label">{existing.playing === 'Yes' ? 'Playing' : 'Social'}</span>
                </div>
              </div>
              <div class="pvc-c-footer">
                <div class="pvc-event">
                  <div class="pvc-event-name">Founders' Padel Social</div>
                  <div class="pvc-event-detail">11 Dec 2026 · Discovery Padel Park, Sandton</div>
                </div>
                <div class="pvc-ref">PVC-2026</div>
              </div>
            </div>
          </div>
          <button class="pvc-dl-btn" id="dl-btn" type="button">
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
              <path d="M5 1v5.5M2.5 4.5 5 7l2.5-2.5M1 9h8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Download Card
          </button>
          <div id="card-dl-status"></div>
        </div>

        {formClosed ? (
          <div class="pc-card">
            <h2>Introductions closed</h2>
            <p>The attendee profile form closed on 8 December. We'll still use the information you submitted (if any) for introductions on the night.</p>
          </div>
        ) : (
          <div class="pc-form-wrap">
            <h2>Tell us who you are</h2>
            <p class="pc-form-desc">We use this to make introductions at the event. This stays between PVC members — we won't share your revenue numbers or contact details publicly. You can edit this until <strong>8 December at 23:59</strong>.</p>

            {existing.completed && (
              <div class="pc-saved-banner">Your profile is saved. You can update it any time before 8 December.</div>
            )}

            <form id="padel-profile-form" class="pc-form" novalidate>
              <input type="hidden" name="token" value={token} />
              <input type="hidden" name="ref"   value={ref} />

              <label class="pc-label">Your full name <span class="req">*</span></label>
              <input class="pc-input" type="text" name="name" required value={existing.name} />

              <label class="pc-label">Your business name <span class="req">*</span></label>
              <input class="pc-input" type="text" name="business" required value={existing.business} />

              <label class="pc-label">What does your business do? (one sentence) <span class="req">*</span></label>
              <input class="pc-input" type="text" name="description" required maxlength="160" value={existing.description} />

              <label class="pc-label">Stage <span class="req">*</span></label>
              <select class="pc-input" name="stage" required>
                <option value="">Select...</option>
                {['Pre-revenue', 'Early revenue', 'Scaling'].map(s => (
                  <option value={s} selected={existing.stage === s}>{s}</option>
                ))}
              </select>

              <label class="pc-label">What are you working on or stuck on right now?</label>
              <textarea class="pc-input" name="workingOn" rows="3">{existing.workingOn}</textarea>

              <label class="pc-label">Who would be most valuable to meet? (choose up to 2)</label>
              <div class="pc-checkboxes" id="who-to-meet-group">
                {WHO_OPTIONS.map(opt => (
                  <label class="pc-checkbox-label">
                    <input type="checkbox" name="whoToMeet" value={opt}
                      checked={existing.whoToMeet.includes(opt)} />
                    {opt}
                  </label>
                ))}
              </div>

              <label class="pc-label">What can you offer others in the room?</label>
              <textarea class="pc-input" name="offer" rows="2">{existing.offer}</textarea>

              <label class="pc-label pc-popia-label">
                <input type="checkbox" name="consent" id="popia-consent"
                  required checked={existing.consent} />
                <span>I agree that PVC may share my name, business name, and what I can offer with other confirmed attendees for the purpose of making introductions at this event. I understand revenue figures are never shared. I can request deletion by emailing hello@privatevictoriesclub.com. <span class="req">*</span></span>
              </label>

              <div id="form-error" class="pc-form-error" hidden></div>

              <button type="submit" class="pc-btn" id="submit-btn">Save my profile</button>
            </form>
          </div>
        )}
      </>
    )}

  </main>
</body>
</html>

<style>
  .pc-wrap { max-width: 640px; margin: 0 auto; padding: 48px 24px 80px; font-family: 'DM Sans', sans-serif; }
  .pc-ticket { background: #111; color: #fff; border-radius: 12px; padding: 32px; margin-bottom: 32px; }
  .pc-badge { display: inline-block; background: #2d9b6f; color: #fff; font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; border-radius: 100px; padding: 4px 12px; margin-bottom: 16px; }
  .pc-ticket h1 { font-size: 2rem; font-weight: 700; margin: 0 0 12px; }
  .pc-ticket-detail { font-size: 1rem; color: #ccc; margin: 0 0 16px; line-height: 1.6; }
  .pc-ticket-refund { font-size: 0.8rem; color: #888; margin: 0; }
  .pc-card { background: #f7f7f5; border-radius: 12px; padding: 32px; margin-bottom: 32px; }
  .pc-card--error { background: #fff3f3; border: 1px solid #f5c5c5; }
  .pc-card h1, .pc-card h2 { margin: 0 0 12px; }
  .pc-form-wrap h2 { font-size: 1.5rem; font-weight: 700; margin: 0 0 8px; }
  .pc-form-desc { color: #555; margin: 0 0 24px; line-height: 1.6; }
  .pc-saved-banner { background: #e8f7ee; color: #1b6b42; border-radius: 8px; padding: 12px 16px; margin-bottom: 20px; font-size: 0.9rem; font-weight: 500; }
  .pc-form { display: flex; flex-direction: column; gap: 16px; }
  .pc-label { font-weight: 600; font-size: 0.9rem; display: flex; flex-direction: column; gap: 6px; }
  .pc-popia-label { flex-direction: row; align-items: flex-start; gap: 10px; font-weight: 400; line-height: 1.5; }
  .pc-popia-label input { margin-top: 3px; flex-shrink: 0; }
  .pc-input { border: 1px solid #ddd; border-radius: 8px; padding: 10px 14px; font-size: 0.95rem; font-family: inherit; width: 100%; box-sizing: border-box; }
  .pc-input:focus { outline: 2px solid #111; outline-offset: 2px; }
  select.pc-input { background: #fff; cursor: pointer; }
  textarea.pc-input { resize: vertical; }
  .pc-checkboxes { display: flex; flex-direction: column; gap: 8px; }
  .pc-checkbox-label { display: flex; align-items: center; gap: 8px; font-weight: 400; font-size: 0.9rem; cursor: pointer; }
  .req { color: #c0392b; }
  .pc-btn { background: #111; color: #fff; border: none; border-radius: 8px; padding: 14px 28px; font-size: 1rem; font-weight: 600; cursor: pointer; align-self: flex-start; transition: opacity .15s; }
  .pc-btn:hover { opacity: .8; }
  .pc-btn:disabled { opacity: .5; cursor: not-allowed; }
  .pc-form-error { background: #fff3f3; border: 1px solid #f5c5c5; border-radius: 8px; padding: 12px 16px; font-size: 0.9rem; color: #c0392b; }
  .pc-transfer-section { margin-top: 20px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 16px; }
  .pc-transfer-section summary { font-size: 0.85rem; color: #aaa; cursor: pointer; user-select: none; }
  .pc-transfer-section summary:hover { color: #ccc; }
  .pc-transfer-body { padding-top: 16px; display: flex; flex-direction: column; gap: 12px; }
  .pc-transfer-body p { font-size: 0.85rem; color: #aaa; margin: 0 0 8px; line-height: 1.5; }
  .pc-transfer-body .pc-input { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15); color: #fff; }
  .pc-transfer-body .pc-input::placeholder { color: #666; }
  .pc-transfer-body .pc-label { color: #ccc; }

  /* ── Attendee card ── */
  .pvc-card-section { margin-bottom: 36px; }
  .pvc-card-section > h2 { font-size: 1.25rem; font-weight: 700; margin: 0 0 4px; color: #fff; font-family: 'Syne', sans-serif; }
  .pvc-card-desc { font-size: 0.85rem; color: #777; margin: 0 0 18px; line-height: 1.5; }
  .pvc-card-wrap { max-width: 480px; }
  .pvc-card {
    width: 100%; aspect-ratio: 1.58/1;
    background: linear-gradient(132deg, #3D1A28 0%, #1E0A1E 46%, #040208 100%);
    border-radius: 14px; position: relative; overflow: hidden;
    padding: clamp(18px,4%,28px) clamp(20px,5.5%,32px);
    display: flex; flex-direction: column; justify-content: space-between;
    box-shadow: 0 20px 56px rgba(0,0,0,0.65), 0 0 0 1px rgba(196,184,192,0.1), inset 0 1px 0 rgba(196,184,192,0.07);
    margin-bottom: 16px;
  }
  .pvc-card::before {
    content: ''; position: absolute; inset: 0;
    background-image: linear-gradient(rgba(196,184,192,0.028) 1px, transparent 1px), linear-gradient(90deg, rgba(196,184,192,0.028) 1px, transparent 1px);
    background-size: 28px 28px;
  }
  .pvc-card::after {
    content: ''; position: absolute; top: -55%; right: -18%; width: 68%; aspect-ratio: 1;
    background: radial-gradient(circle, rgba(196,184,192,0.075) 0%, transparent 65%);
  }
  .pvc-card > * { position: relative; z-index: 1; }
  .pvc-c-top { display: flex; justify-content: space-between; align-items: flex-start; }
  .pvc-wordmark { font-family: 'Syne', sans-serif; font-size: 10.5px; font-weight: 700; letter-spacing: 0.26em; color: #C4B8C0; opacity: 0.55; }
  .pvc-ticket-type { font-family: 'DM Sans', sans-serif; font-size: 8px; font-weight: 500; letter-spacing: 0.11em; text-transform: uppercase; color: #C4B8C0; opacity: 0.28; text-align: right; line-height: 1.75; }
  .pvc-c-body { display: flex; flex-direction: column; gap: 5px; }
  .pvc-name { font-family: 'Syne', sans-serif; font-size: clamp(19px, 5.5vw, 29px); font-weight: 700; color: #fff; letter-spacing: 0.01em; line-height: 1.05; }
  .pvc-role { font-family: 'DM Sans', sans-serif; font-size: clamp(9px, 2vw, 11px); font-weight: 400; color: rgba(255,255,255,0.38); letter-spacing: 0.02em; line-height: 1.4; margin-bottom: 3px; }
  .pvc-badge { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px 3px 7px; border: 1px solid rgba(196,184,192,0.26); border-radius: 100px; width: fit-content; }
  .pvc-badge-dot { width: 5px; height: 5px; border-radius: 50%; background: #C4B8C0; opacity: 0.72; flex-shrink: 0; }
  .pvc-badge-label { font-family: 'DM Sans', sans-serif; font-size: 8px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: #C4B8C0; }
  .pvc-c-footer { display: flex; justify-content: space-between; align-items: flex-end; gap: 8px; }
  .pvc-event { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .pvc-event-name { font-family: 'Syne', sans-serif; font-size: 7.5px; font-weight: 700; letter-spacing: 0.19em; text-transform: uppercase; color: #C4B8C0; opacity: 0.58; white-space: nowrap; }
  .pvc-event-detail { font-family: 'DM Sans', sans-serif; font-size: 8.5px; color: rgba(255,255,255,0.28); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pvc-ref { font-family: 'DM Sans', sans-serif; font-size: 7px; letter-spacing: 0.1em; color: rgba(196,184,192,0.17); flex-shrink: 0; }
  .pvc-dl-btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 22px; background: transparent;
    border: 1px solid rgba(196,184,192,0.17); color: #C4B8C0;
    font-family: 'Syne', sans-serif; font-size: 9.5px; font-weight: 700;
    letter-spacing: 0.17em; text-transform: uppercase;
    cursor: pointer; transition: border-color .2s, background .2s, opacity .2s;
  }
  .pvc-dl-btn:hover:not(:disabled) { border-color: rgba(196,184,192,0.38); background: rgba(196,184,192,0.04); }
  .pvc-dl-btn:disabled { opacity: 0.32; cursor: not-allowed; }
  #card-dl-status { font-family: 'DM Sans', sans-serif; font-size: 10px; color: #C4B8C0; min-height: 14px; margin-top: 8px; display: none; }
  #card-dl-status.show { display: block; }
</style>

<script>
  const form = document.getElementById('padel-profile-form') as HTMLFormElement | null;
  if (form) {
    const btn       = document.getElementById('submit-btn') as HTMLButtonElement;
    const errorBox  = document.getElementById('form-error') as HTMLElement;
    const whoGroup  = document.getElementById('who-to-meet-group');

    // Cap "who to meet" at 2 selections
    whoGroup?.addEventListener('change', () => {
      const checked = whoGroup.querySelectorAll('input[type="checkbox"]:checked');
      whoGroup.querySelectorAll('input[type="checkbox"]').forEach((cb: any) => {
        cb.disabled = checked.length >= 2 && !cb.checked;
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.hidden = true;
      btn.disabled = true;
      btn.textContent = 'Saving...';

      const fd = new FormData(form);
      const payload: Record<string, any> = {
        token:       fd.get('token'),
        ref:         fd.get('ref'),
        name:        fd.get('name'),
        business:    fd.get('business'),
        description: fd.get('description'),
        stage:       fd.get('stage'),
        workingOn:   fd.get('workingOn'),
        whoToMeet:   fd.getAll('whoToMeet'),
        offer:       fd.get('offer'),
        consent:     fd.get('consent') === 'on',
      };

      try {
        const res = await fetch('/api/padel/profile-form', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok) {
          errorBox.textContent = data.error ?? 'Something went wrong. Please try again.';
          errorBox.hidden = false;
          btn.disabled = false;
          btn.textContent = 'Save my profile';
        } else {
          btn.textContent = 'Saved!';
          btn.style.background = '#2d9b6f';
          // Show saved banner
          const banner = document.querySelector('.pc-saved-banner') as HTMLElement;
          if (banner) { banner.hidden = false; }
          else {
            const b = document.createElement('div');
            b.className = 'pc-saved-banner';
            b.textContent = 'Your profile is saved. You can update it any time before 8 December.';
            form.before(b);
          }
          // Sync attendee card with new profile data
          const cardEl = document.getElementById('pvc-card') as HTMLElement | null;
          const cardNameEl = document.getElementById('card-name') as HTMLElement | null;
          const cardRoleEl = document.getElementById('card-role') as HTMLElement | null;
          const cardDescEl = document.getElementById('card-desc') as HTMLElement | null;
          if (cardEl && payload.name) {
            cardEl.dataset.name = payload.name as string;
            if (cardNameEl) cardNameEl.textContent = payload.name as string;
          }
          if (cardEl && payload.business) {
            cardEl.dataset.business = payload.business as string;
            if (cardRoleEl) {
              cardRoleEl.textContent = payload.business as string;
              cardRoleEl.hidden = false;
            }
          }
          if (cardDescEl) cardDescEl.textContent = 'Your card is ready — download and share when you arrive.';
          setTimeout(() => {
            btn.disabled = false;
            btn.textContent = 'Save my profile';
            btn.style.background = '';
          }, 3000);
        }
      } catch {
        errorBox.textContent = 'Network error. Please check your connection and try again.';
        errorBox.hidden = false;
        btn.disabled = false;
        btn.textContent = 'Save my profile';
      }
    });
  }

  // ── Attendee card download ──
  function dlSetStatus(msg: string) {
    const el = document.getElementById('card-dl-status') as HTMLElement | null;
    if (!el) return;
    el.textContent = msg;
    el.classList.add('show');
    setTimeout(() => el.classList.remove('show'), 3200);
  }

  async function renderCardCanvas(W: number): Promise<HTMLCanvasElement> {
    const H = Math.round(W / 1.58);
    const canvas = document.createElement('canvas');
    canvas.width = W; canvas.height = H;
    const ctx = canvas.getContext('2d')!;
    await document.fonts.ready;

    const cardEl = document.getElementById('pvc-card') as HTMLElement;
    const name     = cardEl?.dataset.name     ?? '';
    const business = cardEl?.dataset.business ?? '';
    const playing  = cardEl?.dataset.playing  ?? 'Social';

    ctx.beginPath();
    ctx.roundRect(0, 0, W, H, 18);
    ctx.clip();

    const bg = ctx.createLinearGradient(0, 0, W, H);
    bg.addColorStop(0, '#3D1A28'); bg.addColorStop(0.46, '#1E0A1E'); bg.addColorStop(1, '#040208');
    ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);

    ctx.strokeStyle = 'rgba(196,184,192,0.03)'; ctx.lineWidth = 1;
    const gs = Math.round(W / 18);
    for (let x = gs; x < W; x += gs) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke(); }
    for (let y = gs; y < H; y += gs) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke(); }

    const rg = ctx.createRadialGradient(W * 0.87, H * -0.35, 0, W * 0.87, H * -0.35, W * 0.72);
    rg.addColorStop(0, 'rgba(196,184,192,0.1)'); rg.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = rg; ctx.fillRect(0, 0, W, H);

    ctx.strokeStyle = 'rgba(196,184,192,0.1)'; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.roundRect(0.75, 0.75, W - 1.5, H - 1.5, 17.5); ctx.stroke();

    const pad = Math.round(W * 0.072);
    const fs  = W / 760;

    // Top
    ctx.textAlign = 'left';
    ctx.font = `700 ${Math.round(20 * fs)}px 'Syne', sans-serif`;
    (ctx as any).letterSpacing = `${Math.round(5 * fs)}px`;
    ctx.fillStyle = 'rgba(196,184,192,0.5)';
    ctx.fillText('PVC', pad, pad + Math.round(17 * fs));

    ctx.font = `500 ${Math.round(14 * fs)}px 'DM Sans', sans-serif`;
    (ctx as any).letterSpacing = `${Math.round(1.5 * fs)}px`;
    ctx.fillStyle = 'rgba(196,184,192,0.26)';
    ctx.textAlign = 'right';
    ctx.fillText("FOUNDERS' PADEL SOCIAL", W - pad, pad + Math.round(14 * fs));
    ctx.fillText('EARLY ACCESS', W - pad, pad + Math.round(31 * fs));

    // Name
    ctx.textAlign = 'left';
    (ctx as any).letterSpacing = `${Math.round(0.5 * fs)}px`;
    const nameY = business ? H / 2 - Math.round(2 * fs) : H / 2 + Math.round(10 * fs);
    ctx.font = `700 ${Math.round(56 * fs)}px 'Syne', sans-serif`;
    ctx.fillStyle = '#FFFFFF';
    ctx.fillText(name, pad, nameY);

    // Role line (business)
    let badgeBaseY = nameY + Math.round(26 * fs);
    if (business) {
      ctx.font = `400 ${Math.round(16 * fs)}px 'DM Sans', sans-serif`;
      (ctx as any).letterSpacing = `${Math.round(0.4 * fs)}px`;
      ctx.fillStyle = 'rgba(255,255,255,0.36)';
      ctx.fillText(business, pad, nameY + Math.round(30 * fs));
      badgeBaseY = nameY + Math.round(52 * fs);
    }

    // Badge
    ctx.font = `600 ${Math.round(14 * fs)}px 'DM Sans', sans-serif`;
    (ctx as any).letterSpacing = `${Math.round(2 * fs)}px`;
    const bTW  = ctx.measureText(playing.toUpperCase()).width;
    const bPH  = Math.round(16 * fs), dotR = Math.round(4.5 * fs), dotGap = Math.round(9 * fs);
    const bH2  = Math.round(28 * fs), bW = bPH + dotR * 2 + dotGap + bTW + bPH;
    ctx.strokeStyle = 'rgba(196,184,192,0.28)'; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.roundRect(pad, badgeBaseY, bW, bH2, bH2 / 2); ctx.stroke();
    ctx.fillStyle = 'rgba(196,184,192,0.72)';
    ctx.beginPath(); ctx.arc(pad + bPH + dotR, badgeBaseY + bH2 / 2, dotR, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = '#C4B8C0'; ctx.textAlign = 'left';
    ctx.fillText(playing.toUpperCase(), pad + bPH + dotR * 2 + dotGap, badgeBaseY + bH2 / 2 + Math.round(5 * fs));

    // Footer
    ctx.font = `700 ${Math.round(15 * fs)}px 'Syne', sans-serif`;
    (ctx as any).letterSpacing = `${Math.round(3 * fs)}px`;
    ctx.fillStyle = 'rgba(196,184,192,0.55)';
    ctx.fillText("FOUNDERS' PADEL SOCIAL", pad, H - Math.round(40 * fs));

    ctx.font = `400 ${Math.round(14 * fs)}px 'DM Sans', sans-serif`;
    (ctx as any).letterSpacing = `${Math.round(0.4 * fs)}px`;
    ctx.fillStyle = 'rgba(255,255,255,0.28)';
    ctx.fillText('11 Dec 2026 · Discovery Padel Park, Sandton', pad, H - Math.round(22 * fs));

    ctx.font = `500 ${Math.round(12 * fs)}px 'DM Sans', sans-serif`;
    (ctx as any).letterSpacing = `${Math.round(1.5 * fs)}px`;
    ctx.fillStyle = 'rgba(196,184,192,0.17)';
    ctx.textAlign = 'right';
    ctx.fillText('PVC-2026', W - pad, H - Math.round(22 * fs));

    return canvas;
  }

  async function downloadCard() {
    const btn = document.getElementById('dl-btn') as HTMLButtonElement | null;
    if (btn) btn.disabled = true;
    dlSetStatus('Rendering…');

    try {
      const canvas = await renderCardCanvas(760);

      // iOS Safari (WKWebView) silently ignores <a download> on blob URLs.
      // Fall back to opening the data URL in a new tab so the user can long-press to save.
      const isIOS = /iPhone|iPad|iPod/.test(navigator.userAgent) && !(window as any).MSStream;
      if (isIOS) {
        const dataUrl = canvas.toDataURL('image/png');
        const w = window.open(dataUrl, '_blank');
        if (w) {
          dlSetStatus('Press and hold the image → Save to Photos');
        } else {
          dlSetStatus('Allow pop-ups then try again');
        }
        if (btn) btn.disabled = false;
        return;
      }

      canvas.toBlob((blob) => {
        if (!blob) { dlSetStatus('Render failed — try again'); if (btn) btn.disabled = false; return; }
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = 'pvc-padel-card.png';
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
        setTimeout(() => URL.revokeObjectURL(url), 1000);
        dlSetStatus('Card downloaded');
        if (btn) btn.disabled = false;
      }, 'image/png');
    } catch (e) {
      console.error('[pvc-card]', e);
      dlSetStatus('Could not render — try again');
      if (btn) btn.disabled = false;
    }
  }

  document.getElementById('dl-btn')?.addEventListener('click', downloadCard);

  // Transfer form
  const transferForm = document.getElementById('transfer-form') as HTMLFormElement | null;
  if (transferForm) {
    const transferBtn     = document.getElementById('transfer-btn') as HTMLButtonElement;
    const transferError   = document.getElementById('transfer-error') as HTMLElement;
    const transferSuccess = document.getElementById('transfer-success') as HTMLElement;

    transferForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      transferError.hidden = true;
      transferBtn.disabled = true;
      transferBtn.textContent = 'Transferring...';

      const fd = new FormData(transferForm);
      const payload = {
        token:    fd.get('token'),
        ref:      fd.get('ref'),
        newName:  (fd.get('newName') as string)?.trim(),
        newEmail: (fd.get('newEmail') as string)?.trim().toLowerCase(),
      };

      try {
        const res  = await fetch('/api/padel/transfer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (res.ok) {
          transferSuccess.hidden = false;
          transferForm.hidden    = true;
        } else {
          transferError.textContent = data.error ?? 'Transfer failed. Please try again.';
          transferError.hidden      = false;
          transferBtn.disabled      = false;
          transferBtn.textContent   = 'Transfer my spot';
        }
      } catch {
        transferError.textContent = 'Network error. Please check your connection and try again.';
        transferError.hidden      = false;
        transferBtn.disabled      = false;
        transferBtn.textContent   = 'Transfer my spot';
      }
    });
  }
</script>
