---
export const prerender = false;
import '../styles/global.css';
const PS_KEY = import.meta.env.PUBLIC_PAYSTACK_KEY ?? '';
const PH_KEY = import.meta.env.PUBLIC_POSTHOG_KEY ?? '';
// Member ticket URL param — not linked from this page, shared privately only
const isMemberUrl = Astro.url.searchParams.get('member') === '1';

const NOISE = (id: string) => `
  <filter id="${id}"><feTurbulence type="fractalNoise" baseFrequency="0.7" numOctaves="3" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter>
  <rect width="100%" height="100%" filter="url(#${id})"/>
`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Founders' Padel Social · Private Victories Club</title>
  <meta name="description" content="Play padel with other founders, creatives and builders. Leave with people you want to know. Friday 11 December · Discovery Padel Park · Johannesburg." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet" />
{PH_KEY && <script define:vars={{ PH_KEY }}>
    !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+" people (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||(window.posthog=[]));
    posthog.init(PH_KEY, {api_host: 'https://eu.posthog.com', capture_pageview: true});
  </script>}
<script is:inline>
  !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
  fbq('init', '2322669691834876');
  fbq('track', 'PageView');
</script>
<noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=2322669691834876&ev=PageView&noscript=1" /></noscript>
</head>
<body>

<!-- NAV -->
<nav id="nav" class="pd-nav">
  <a href="https://privatevictoriesclub.com" class="pd-nav-logo">
    <span>Private Victories</span>
  </a>
  <a href="#tickets" class="pd-nav-cta scroll-to-tickets">Reserve Your Spot</a>
</nav>

<!-- HERO -->
<section class="pd-hero">
  <img class="pd-hero-bg" src="/images/padel-hero.jpg" alt="" aria-hidden="true" fetchpriority="high" />
  <div class="pd-hero-overlay"></div>
  <svg class="noise-layer" xmlns="http://www.w3.org/2000/svg" set:html={NOISE('pd1')} />
  <div class="pd-hero-inner">
    <p class="pd-hero-label reveal">Johannesburg · December 2026</p>
    <h1 class="pd-hero-word reveal d1">Padel</h1>
    <p class="pd-hero-sub reveal d2">A Private Victories Social</p>
    <a href="#tickets" class="pd-hero-cta scroll-to-tickets reveal d3">Reserve My Spot</a>
    <div class="pd-hero-meta reveal d4">
      <span>11 Dec</span>
      <span class="pd-hero-dot">·</span>
      <span>In-Person</span>
      <span class="pd-hero-dot">·</span>
      <span>Limited to 40 people</span>
    </div>
  </div>
</section>

<!-- STICKY BAR -->
<div class="pd-sticky-bar" id="pd-sticky">
  <span class="pd-sticky-label">Johannesburg · 11 Dec</span>
  <a href="#tickets" class="pd-sticky-cta scroll-to-tickets">Reserve Your Spot</a>
</div>

<!-- PREVIOUS EVENTS HEADER -->
<div class="pd-events-header">
  <span>Our Previous Events</span>
</div>

<!-- PHOTO STRIP — previous events -->
<div class="pd-photo-strip">
  <div class="pd-photo-track">
    <div class="pd-photo-item">
      <img src="/images/dinner-cam-group.jpg" alt="PVC founders" loading="lazy" />
      <div class="pd-photo-overlay"></div>
      <span class="pd-photo-caption">The Founding Dinner · Rosebank</span>
    </div>
    <div class="pd-photo-item">
      <img src="/images/dinner-cam-speaking.jpg" alt="Founder speaking" loading="lazy" />
      <div class="pd-photo-overlay"></div>
    </div>
    <div class="pd-photo-item">
      <img src="/images/dinner-cam-laugh.jpg" alt="Founders laughing" loading="lazy" style="object-position: center 30%;" />
      <div class="pd-photo-overlay"></div>
    </div>
    <div class="pd-photo-item">
      <img src="/images/dinner-cam-connect.jpg" alt="Founders connecting" loading="lazy" />
      <div class="pd-photo-overlay"></div>
    </div>
  </div>
</div>

<!-- COUNTDOWN -->
<section class="pd-countdown-bar">
  <div class="pd-countdown-inner">
    <div class="pd-countdown-label">Founders' Padel Social · 11 Dec 2026</div>
    <div class="pd-countdown-units" id="pd-cd">
      <div class="pd-cd-unit"><span class="pd-cd-num" id="cd-days">--</span><span class="pd-cd-lbl">Days</span></div>
      <div class="pd-cd-sep"></div>
      <div class="pd-cd-unit"><span class="pd-cd-num" id="cd-hours">--</span><span class="pd-cd-lbl">Hours</span></div>
      <div class="pd-cd-sep"></div>
      <div class="pd-cd-unit"><span class="pd-cd-num" id="cd-mins">--</span><span class="pd-cd-lbl">Minutes</span></div>
      <div class="pd-cd-sep"></div>
      <div class="pd-cd-unit"><span class="pd-cd-num" id="cd-secs">--</span><span class="pd-cd-lbl">Seconds</span></div>
    </div>
  </div>
</section>

<!-- PREMISE -->
<section class="pd-section pd-premise">
  <div class="pd-inner">
    <div class="pd-label reveal">The Premise</div>
    <p class="pd-premise-lead reveal d1">Not just a sports session.</p>
    <p class="pd-premise-body reveal d2">90 minutes of padel across the courts, rotating games so you actually meet people, and a room limited to 40 founders, creatives and builders. Playing or not, you're in the room: intros set up before you arrive, name tags, and the lounge after. No pitching. No panels. Just play. The conversations happen naturally when you're in motion.</p>
    <div class="pd-stats reveal d3">
      <div class="pd-stat">
        <div class="pd-stat-num">40</div>
        <div class="pd-stat-label">Spots only</div>
      </div>
      <div class="pd-stat-div"></div>
      <div class="pd-stat">
        <div class="pd-stat-num">6</div>
        <div class="pd-stat-label">Courts</div>
      </div>
      <div class="pd-stat-div"></div>
      <div class="pd-stat">
        <div class="pd-stat-num">90</div>
        <div class="pd-stat-label">Minutes</div>
      </div>
    </div>
  </div>
</section>

<!-- FULL-BLEED PHOTO BREAK -->
<div class="pd-full-break">
  <img src="/images/ct-promenade.jpg" alt="Cape Town promenade" loading="lazy" />
  <div class="pd-full-break-overlay"></div>
  <svg class="noise-layer" xmlns="http://www.w3.org/2000/svg" set:html={NOISE('pd2')} />
  <div class="pd-full-break-caption">Cape Town · 2026</div>
</div>

<!-- STATEMENT -->
<section class="pd-section pd-statement">
  <svg class="noise-layer" xmlns="http://www.w3.org/2000/svg" set:html={NOISE('pd3')} />
  <div class="pd-inner pd-statement-inner">
    <h2 class="pd-statement-head reveal">The best business conversations happen when you're not sitting across a conference table.</h2>
    <p class="pd-statement-sub reveal d1">Get in motion. Meet the room. See who you want to know better.</p>
  </div>
</section>

<!-- FORMAT -->
<section class="pd-section pd-format">
  <div class="pd-inner">
    <div class="pd-label reveal">The Format</div>
    <ol class="pd-schedule">
      <li class="pd-sched reveal d1">
        <div class="pd-sched-num">01</div>
        <div class="pd-sched-body">
          <div class="pd-sched-tag">Arrive</div>
          <div class="pd-sched-desc">Check in, pick up your racket, meet your first group.</div>
        </div>
      </li>
      <li class="pd-sched reveal d2">
        <div class="pd-sched-num">02</div>
        <div class="pd-sched-body">
          <div class="pd-sched-tag">Play</div>
          <div class="pd-sched-desc">90 minutes across the courts. Rotating games so you don't just play with the people you arrived with. Rackets and balls included.</div>
        </div>
      </li>
      <li class="pd-sched reveal d3">
        <div class="pd-sched-num">03</div>
        <div class="pd-sched-body">
          <div class="pd-sched-tag">Wind Down</div>
          <div class="pd-sched-desc">Food and drinks at venue. The real conversations happen here.</div>
        </div>
      </li>
    </ol>
    <p class="pd-format-note reveal d4">No padel experience needed. Beginner friendly. We'll mix levels so everyone gets a game.</p>
  </div>
</section>

<!-- PREVIOUS EVENTS VIDEO HEADER -->
<div class="pd-events-header" style="background: var(--charcoal);">
  <span>Our Previous Events</span>
</div>

<!-- VIDEO STRIP -->
<div class="pd-video-section">
  <div class="pd-video-event-block">
    <div class="pd-video-event-label">PVC Events</div>
    <div class="pd-video-grid pd-video-grid--stack">
      <div class="pd-video-slot pd-video-slot--wide">
        <video autoplay muted loop playsinline>
          <source src="/videos/dinner-energy.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="pd-video-slot pd-video-slot--wide">
        <video autoplay muted loop playsinline>
          <source src="/videos/dinner-conversation.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="pd-photo-pair">
        <div class="pd-video-slot pd-video-slot--portrait">
          <img src="/images/ct-mastermind-1.jpg" alt="Cape Town Mastermind" loading="lazy" />
        </div>
        <div class="pd-video-slot pd-video-slot--portrait">
          <img src="/images/ct-mastermind-2.jpg" alt="Cape Town Mastermind" loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</div>

<!-- WHO IT'S FOR -->
<section class="pd-section pd-who">
  <div class="pd-inner">
    <div class="pd-label reveal">Who This Is For</div>
    <p class="pd-who-lead reveal d1">Founders, creatives and builders working on something real.</p>
    <ul class="pd-who-list">
      <li class="reveal d2" data-num="01">You want to meet other founders, creatives and builders outside of a formal setting.</li>
      <li class="reveal d3" data-num="02">You believe the right room changes what's possible.</li>
      <li class="reveal d4" data-num="03">You'd rather play than sit through another panel.</li>
    </ul>
  </div>
</section>

<!-- DETAILS -->
<section class="pd-section pd-details">
  <div class="pd-inner">
    <div class="pd-label reveal">The Details</div>
    <div class="pd-details-grid reveal d1">
      <span class="pd-dk">Date</span>
      <span class="pd-dv">Friday 11 December</span>
      <span class="pd-dk">Venue</span>
      <span class="pd-dv">Discovery Padel Park · Johannesburg</span>
      <span class="pd-dk">Courts</span>
      <span class="pd-dv">5pm – 6:30pm</span>
      <span class="pd-dk">Lounge</span>
      <span class="pd-dv">Until 9:30pm</span>
      <span class="pd-dk">What's included</span>
      <span class="pd-dv">Courts, rackets, balls</span>
      <span class="pd-dk">Food &amp; drink</span>
      <span class="pd-dv">Available at venue, paid on the day</span>
      <span class="pd-dk">Wear</span>
      <span class="pd-dv">Sportswear &amp; flat-soled trainers</span>
    </div>
  </div>
</section>

<!-- TICKETS -->
<section id="tickets" class="pd-tickets-section">
  <svg class="noise-layer" xmlns="http://www.w3.org/2000/svg" set:html={NOISE('pd4')} />
  <div class="pd-tickets-inner">

    <div id="pd-tier-view">
      <div class="pd-tickets-head">
        <div class="pd-label reveal" style="justify-content:center;">Reserve Your Spot</div>
        <p class="pd-tickets-note reveal d1">First come, first served.</p>
        <div class="pd-caps-display reveal d2" id="pd-caps-display" aria-live="polite">
          <span id="pd-caps-text">Loading availability...</span>
        </div>
        <div class="pd-tier-info reveal d3" id="pd-tier-info" style="display:none;">
          <span id="pd-tier-info-text"></span>
        </div>
      </div>

      {isMemberUrl && (
        <div class="pd-ticket-toggle reveal d1" id="pd-ticket-toggle">
          <button class="pd-tt-btn pd-tt-btn--active" data-type="ga" id="pd-tt-ga">General Admission</button>
          <button class="pd-tt-btn" data-type="member" id="pd-tt-member">PVC Member</button>
        </div>
      )}

      <div class="pd-tier reveal d2">
        <div class="pd-tier-left">
          <div class="pd-tier-badge" id="pd-tier-badge">General Admission</div>
          <div class="pd-early-badge" id="pd-early-badge" style="display:none;">Early Access</div>
          <div class="pd-tier-price" id="pd-tier-price">R400</div>
          <div class="pd-tier-hint" id="pd-tier-hint">Open to all.</div>
          <div class="pd-tier-wm" aria-hidden="true">PVC</div>
        </div>
        <div class="pd-tier-right">
          <ul class="pd-tier-list">
            <li><span>·</span>90 min padel across the courts</li>
            <li><span>·</span>Rackets and balls included for players</li>
            <li><span>·</span>Rotating games, so you meet more than your own court</li>
            <li><span>·</span>Room of 40 founders, creatives and builders</li>
          </ul>
          <button class="cta-btn pd-pay-btn" id="pd-pay-btn">Reserve Your Spot</button>
        </div>
      </div>
    </div>

    <!-- PAYMENT FORM -->
    <div id="pd-form-view" style="display:none;" class="pd-form-wrap">
      <button class="pd-back-btn" id="pd-back">&larr; Back</button>
      <div class="pd-form-eyebrow">Founders Padel Social · Johannesburg</div>
      <div class="pd-form-field">
        <label class="pd-form-label" for="pd-name">Full Name</label>
        <input type="text" id="pd-name" placeholder="Your name" autocomplete="name" />
      </div>
      <div class="pd-form-field">
        <label class="pd-form-label" for="pd-email">Email</label>
        <input type="email" id="pd-email" placeholder="you@example.com" autocomplete="email" />
      </div>

      <!-- Playing question -->
      <div class="pd-form-field">
        <label class="pd-form-label">Will you be playing padel?</label>
        <div class="pd-playing-opts">
          <label class="pd-playing-label" id="pd-play-yes-label">
            <input type="radio" name="playing" id="pd-play-yes" value="Yes" checked />
            <span class="pd-playing-opt-inner">
              <span class="pd-playing-opt-title">Yes, I'll play</span>
              <span class="pd-playing-opt-sub">Join a rotating court. No experience needed.</span>
            </span>
          </label>
          <label class="pd-playing-label" id="pd-play-no-label">
            <input type="radio" name="playing" id="pd-play-no" value="No" />
            <span class="pd-playing-opt-inner">
              <span class="pd-playing-opt-title">No, I'll socialise</span>
              <span class="pd-playing-opt-sub">Watch the games, meet people, stay for the lounge.</span>
            </span>
          </label>
        </div>
        <p class="pd-player-cap-note" id="pd-player-cap-note" style="display:none;">
          Player spots are full. You can still join as social-only.
        </p>
      </div>

      <button class="cta-btn" id="pd-checkout" style="width:100%;margin-top:8px;">Proceed to Checkout</button>
      <p class="pd-secure-note">Secure checkout via Paystack &nbsp;·&nbsp; <a href="#refund-policy" class="pd-refund-link">Refund policy</a></p>
      <div class="pd-error" id="pd-error" style="display:none;"></div>
    </div>

    <!-- SOLD OUT — WAITLIST -->
    <div id="pd-waitlist-view" style="display:none;" class="pd-waitlist-wrap">
      <div class="pd-success-mark">✗</div>
      <h2 class="pd-success-title">Sold Out</h2>
      <p class="pd-success-body">All 40 spots are taken. Leave your email and we'll let you know if a spot opens up.</p>
      <div class="pd-form-field" style="margin-top:20px;">
        <input type="text" id="pd-wl-name" placeholder="Your name" autocomplete="name" style="width:100%;margin-bottom:10px;" />
        <input type="email" id="pd-wl-email" placeholder="Your email" autocomplete="email" style="width:100%;" />
      </div>
      <button class="cta-btn" id="pd-wl-submit" style="width:100%;margin-top:12px;">Join Waitlist</button>
      <div class="pd-error" id="pd-wl-error" style="display:none;margin-top:8px;"></div>
      <p id="pd-wl-success" style="display:none;color:#2d9b6f;margin-top:12px;text-align:center;">You're on the list. We'll be in touch.</p>
    </div>

    <!-- SUCCESS -->
    <div id="pd-success" style="display:none;" class="pd-success">
      <div class="pd-success-mark">✓</div>
      <h2 class="pd-success-title">You're in.</h2>
      <p class="pd-success-body">Check your inbox. Confirmation is on its way. See you on the courts.</p>
    </div>

    <div class="pd-fine-print reveal" id="refund-policy">
      <p><strong>Refund policy:</strong> Full refund up to 7 days before the event (by 4 December at 17:00). After that, tickets are non-refundable but you can transfer your spot. If we cancel or postpone, you get a full refund.</p>
      <p>Questions? DM <a href="https://instagram.com/privatevictories.club" target="_blank" rel="noopener">@privatevictories.club</a> on Instagram.</p>
    </div>
  </div>
</section>

<!-- CLOSE -->
<section class="pd-section pd-close">
  <svg class="noise-layer" xmlns="http://www.w3.org/2000/svg" set:html={NOISE('pd5')} />
  <div class="pd-inner pd-close-inner">
    <p class="pd-close-quote reveal">The wins you have in public are proportionate to the victories you have in private.</p>
    <a href="#tickets" class="cta-btn scroll-to-tickets reveal d1">Reserve Your Spot</a>
    <p class="cta-note reveal d2">40 spots only. Friday 11 December.</p>
  </div>
</section>

<!-- FOOTER -->
<footer class="d-footer">
  <div class="footer-bottom">
    <div class="footer-lock">
      <div class="footer-mark" style="font-size:10px;font-weight:700;letter-spacing:2px;color:var(--lavender-dim);width:auto;height:auto;">PVC</div>
      <div class="footer-name">Private Victories Club</div>
    </div>
    <div class="footer-handle"><a href="https://instagram.com/privatevictories.club" target="_blank" rel="noopener">@privatevictories.club</a> · Built in Africa</div>
    <div class="footer-copy">© MMXXVI · Build in private. Win in public.</div>
  </div>
</footer>

<script define:vars={{ PS_KEY }}>
  // Smooth scroll
  document.querySelectorAll('.scroll-to-tickets').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      document.getElementById('tickets')?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  // Nav scroll state
  const nav = document.getElementById('nav');
  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 60);
  window.addEventListener('scroll', onScroll);
  onScroll();

  // Sticky bar: show after hero
  const sticky = document.getElementById('pd-sticky');
  const hero = document.querySelector('.pd-hero');
  const stickyObserver = new IntersectionObserver(([e]) => {
    sticky?.classList.toggle('visible', !e.isIntersecting);
  }, { threshold: 0 });
  if (hero) stickyObserver.observe(hero);

  // Scroll reveal
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  setTimeout(() => {
    document.querySelectorAll('.pd-hero .reveal').forEach((el) => el.classList.add('visible'));
  }, 100);

  // Countdown to 11 Dec 2026 17:00 SAST (UTC+2 = 15:00 UTC)
  const eventDate = new Date('2026-12-11T15:00:00Z');
  function tick() {
    const diff = eventDate - Date.now();
    const pad = (n) => String(Math.max(0, n)).padStart(2, '0');
    if (diff <= 0) {
      ['cd-days','cd-hours','cd-mins','cd-secs'].forEach(id => {
        const el = document.getElementById(id); if (el) el.textContent = '00';
      });
      return;
    }
    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    const days = document.getElementById('cd-days'); if (days) days.textContent = pad(d);
    const hours = document.getElementById('cd-hours'); if (hours) hours.textContent = pad(h);
    const mins = document.getElementById('cd-mins'); if (mins) mins.textContent = pad(m);
    const secs = document.getElementById('cd-secs'); if (secs) secs.textContent = pad(s);
  }
  tick(); setInterval(tick, 1000);

  // ── Ticket type state ──
  let selectedTicketType = 'ga';

  function updateTicketDisplay() {
    const badge = document.getElementById('pd-tier-badge');
    const earlyBadge = document.getElementById('pd-early-badge');
    const price = document.getElementById('pd-tier-price');
    const hint  = document.getElementById('pd-tier-hint');
    const isEarly = capsData.tier === 'early';
    if (earlyBadge) earlyBadge.style.display = isEarly ? '' : 'none';
    if (selectedTicketType === 'member') {
      if (badge) badge.textContent = 'PVC Member';
      if (price) price.textContent = `R${capsData.memberPrice ?? (isEarly ? 200 : 250)}`;
      if (hint)  hint.textContent  = 'PVC Members only.';
    } else {
      if (badge) badge.textContent = 'General Admission';
      if (price) price.textContent = `R${capsData.gaPrice ?? (isEarly ? 400 : 500)}`;
      if (hint)  hint.textContent  = 'Open to all.';
    }
    // Update toggle button labels with current prices
    const gaBtn = document.getElementById('pd-tt-ga');
    const memberBtn = document.getElementById('pd-tt-member');
    if (gaBtn) gaBtn.textContent = `General Admission — R${capsData.gaPrice ?? (isEarly ? 400 : 500)}`;
    if (memberBtn) memberBtn.textContent = `PVC Member — R${capsData.memberPrice ?? (isEarly ? 200 : 250)}`;
  }

  const toggle = document.getElementById('pd-ticket-toggle');
  if (toggle) {
    toggle.querySelectorAll('.pd-tt-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        toggle.querySelectorAll('.pd-tt-btn').forEach(b => b.classList.remove('pd-tt-btn--active'));
        btn.classList.add('pd-tt-btn--active');
        selectedTicketType = btn.dataset.type;
        updateTicketDisplay();
      });
    });
  }

  // ── Load real cap data ──
  let capsData = { total: 0, players: 0, totalCap: 40, playerCap: 28, totalFull: false, playerFull: false,
    tier: 'early', earlyRemaining: 15, earlyCap: 15, earlyCutoff: '27 Nov',
    gaPrice: 400, memberPrice: 200, nextGaPrice: 500 };

  async function loadCaps() {
    try {
      const res = await fetch('/api/padel/caps', { cache: 'no-store' });
      if (res.ok) capsData = await res.json();
    } catch { /* fail open */ }
    renderCaps();
  }

  function renderCaps() {
    const el = document.getElementById('pd-caps-text');
    if (!el) return;
    if (capsData.totalFull) {
      el.textContent = 'Sold out — no spots remaining.';
      // Show waitlist instead of ticket form
      document.getElementById('pd-tier-view')?.style && (document.getElementById('pd-tier-view').style.display = 'none');
      document.getElementById('pd-waitlist-view')?.style && (document.getElementById('pd-waitlist-view').style.display = 'block');
    } else {
      el.textContent = `${capsData.totalCap} spots.`;
    }

    // Show tier info
    const tierInfo = document.getElementById('pd-tier-info');
    const tierInfoText = document.getElementById('pd-tier-info-text');
    if (tierInfo && tierInfoText && !capsData.totalFull) {
      if (capsData.tier === 'early' && capsData.nextGaPrice) {
        const spotsLeft = capsData.earlyRemaining;
        tierInfoText.textContent = `Early access pricing. Goes up once early access is over.`;
        tierInfo.style.display = '';
      } else {
        tierInfoText.textContent = `Standard pricing — R${capsData.gaPrice}.`;
        tierInfo.style.display = '';
      }
    }

    // Update ticket price display
    updateTicketDisplay();

    // Player cap note in form
    const note = document.getElementById('pd-player-cap-note');
    if (note && capsData.playerFull) {
      note.style.display = 'block';
      const yesLabel = document.getElementById('pd-play-yes-label');
      const yesInput = document.getElementById('pd-play-yes');
      if (yesLabel) yesLabel.classList.add('pd-playing-label--disabled');
      if (yesInput) { yesInput.disabled = true; document.getElementById('pd-play-no').checked = true; }
    }
  }

  loadCaps();

  // Pay flow
  document.getElementById('pd-pay-btn')?.addEventListener('click', () => {
    document.getElementById('pd-tier-view').style.display = 'none';
    document.getElementById('pd-form-view').style.display = 'block';
    document.getElementById('pd-form-view').scrollIntoView({ behavior: 'smooth', block: 'start' });
    window.posthog?.capture?.('padel_checkout_started', { ticket_type: selectedTicketType });
    (window as any).fbq?.('track', 'InitiateCheckout', { content_name: 'Padel Social Ticket', content_type: selectedTicketType });
  });

  document.getElementById('pd-back')?.addEventListener('click', () => {
    document.getElementById('pd-form-view').style.display = 'none';
    document.getElementById('pd-tier-view').style.display = '';
    document.getElementById('pd-error').style.display = 'none';
  });

  // ── ANALYTICS ──

  document.querySelectorAll('.scroll-to-tickets, .pd-nav-cta, .pd-sticky-cta').forEach((el) => {
    el.addEventListener('click', () => {
      window.posthog?.capture?.('padel_cta_clicked', {
        label: el.textContent?.trim(),
        location: el.closest('.pd-hero') ? 'hero'
          : el.closest('.pd-sticky-bar') ? 'sticky_bar'
          : el.closest('.pd-nav') ? 'nav'
          : el.closest('.pd-close') ? 'close_section'
          : 'other',
      });
    });
  });

  const ticketsSection = document.getElementById('tickets');
  if (ticketsSection) {
    const ticketObs = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) {
        window.posthog?.capture?.('padel_tickets_section_reached');
        (window as any).fbq?.('track', 'ViewContent', { content_name: 'Padel Social Tickets' });
        ticketObs.disconnect();
      }
    }, { threshold: 0.2 });
    ticketObs.observe(ticketsSection);
  }

  let formStarted = false;
  ['pd-name', 'pd-email'].forEach((id) => {
    document.getElementById(id)?.addEventListener('focus', () => {
      if (!formStarted) {
        formStarted = true;
        window.posthog?.capture?.('padel_form_started');
      }
    }, { once: true });
  });

  const depthHits = new Set();
  window.addEventListener('scroll', () => {
    const pct = Math.round((window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100);
    [25, 50, 75, 100].forEach((mark) => {
      if (pct >= mark && !depthHits.has(mark)) {
        depthHits.add(mark);
        window.posthog?.capture?.('padel_scroll_depth', { depth: mark });
      }
    });
  }, { passive: true });

  // ── Checkout via Paystack Initialize Transaction API ──
  document.getElementById('pd-checkout')?.addEventListener('click', async function() {
    const nameVal  = document.getElementById('pd-name').value.trim();
    const emailVal = document.getElementById('pd-email').value.trim();
    const playing  = document.querySelector('input[name="playing"]:checked')?.value ?? 'No';
    const errEl    = document.getElementById('pd-error');

    if (!nameVal || !emailVal) { errEl.textContent = 'Please enter your name and email.'; errEl.style.display = 'block'; return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) { errEl.textContent = 'Please enter a valid email address.'; errEl.style.display = 'block'; return; }
    errEl.style.display = 'none';

    this.textContent = 'Taking you to checkout...';
    this.style.opacity = '0.7';
    this.disabled = true;

    try {
      const res = await fetch('/api/padel/init-checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: nameVal, email: emailVal, playing, ticketType: selectedTicketType }),
      });
      const data = await res.json();
      if (!res.ok) {
        errEl.textContent = data.error ?? 'Something went wrong. Please try again.';
        errEl.style.display = 'block';
        this.textContent = 'Proceed to Checkout';
        this.style.opacity = '';
        this.disabled = false;
        return;
      }
      window.location.href = data.url;
    } catch (e) {
      errEl.textContent = 'Network error. Please try again.';
      errEl.style.display = 'block';
      this.textContent = 'Proceed to Checkout';
      this.style.opacity = '';
      this.disabled = false;
    }
  });

  // Waitlist form
  document.getElementById('pd-wl-submit')?.addEventListener('click', async function() {
    const nameVal  = /** @type {HTMLInputElement|null} */ (document.getElementById('pd-wl-name'))?.value.trim() ?? '';
    const emailVal = /** @type {HTMLInputElement|null} */ (document.getElementById('pd-wl-email'))?.value.trim() ?? '';
    const errEl    = document.getElementById('pd-wl-error');
    const sucEl    = document.getElementById('pd-wl-success');
    if (!emailVal || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) {
      if (errEl) { errEl.textContent = 'Please enter a valid email.'; errEl.style.display = 'block'; }
      return;
    }
    if (errEl) errEl.style.display = 'none';
    this.disabled = true;
    this.textContent = 'Joining...';
    try {
      await fetch('/api/padel/waitlist', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: emailVal, name: nameVal }),
      });
      if (sucEl) sucEl.style.display = 'block';
      this.style.display = 'none';
    } catch {
      if (errEl) { errEl.textContent = 'Network error. Please try again.'; errEl.style.display = 'block'; }
      this.disabled = false;
      this.textContent = 'Join Waitlist';
    }
  });
</script>

