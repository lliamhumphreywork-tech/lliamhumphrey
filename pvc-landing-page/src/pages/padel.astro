    <p class="pd-close-quote reveal">The wins you have in public are proportionate to the victories you have in private.</p>
    <a href="#tickets" class="cta-btn scroll-to-tickets reveal d1">Reserve Your Spot</a>
    <p class="cta-note reveal d2">40 spots only. Friday 11 December.</p>
  </div>
</section>

<!-- FOOTER -->
<footer class="d-footer">
  <div class="footer-lock">
    <div class="footer-mark">PVC</div>
    <div class="footer-name">Private Victories Club</div>
  </div>
  <div class="footer-handle"><a href="https://instagram.com/privatevictories.club" target="_blank" rel="noopener">@privatevictories.club</a> · Built in Africa</div>
  <div class="footer-copy">© MMXXVI · Build in private. Win in public.</div>
</footer>

<script define:vars={{ PS_KEY }}>
  // Smooth scroll
  document.querySelectorAll('.scroll-to-tickets').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      document.getElementById('tickets')?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  // Nav scroll state
  const nav = document.getElementById('nav');
  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 60);
  window.addEventListener('scroll', onScroll);
  onScroll();

  // Sticky bar: show after hero
  const sticky = document.getElementById('pd-sticky');
  const hero = document.querySelector('.pd-hero');
  const stickyObserver = new IntersectionObserver(([e]) => {
    sticky?.classList.toggle('visible', !e.isIntersecting);
  }, { threshold: 0 });
  if (hero) stickyObserver.observe(hero);

  // Scroll reveal
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  setTimeout(() => {
    document.querySelectorAll('.pd-hero .reveal').forEach((el) => el.classList.add('visible'));
  }, 100);

  // Countdown to 11 Dec 2026 10:00 SAST (UTC+2)
  const eventDate = new Date('2026-12-11T08:00:00Z');
  function tick() {
    const diff = eventDate - Date.now();
    const pad = (n) => String(Math.max(0, n)).padStart(2, '0');
    if (diff <= 0) {
      ['cd-days','cd-hours','cd-mins','cd-secs'].forEach(id => {
        const el = document.getElementById(id); if (el) el.textContent = '00';
      });
      return;
    }
    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    const days = document.getElementById('cd-days'); if (days) days.textContent = pad(d);
    const hours = document.getElementById('cd-hours'); if (hours) hours.textContent = pad(h);
    const mins = document.getElementById('cd-mins'); if (mins) mins.textContent = pad(m);
    const secs = document.getElementById('cd-secs'); if (secs) secs.textContent = pad(s);
  }
  tick(); setInterval(tick, 1000);

  // Pay flow
  document.querySelector('.pd-pay-btn')?.addEventListener('click', () => {
    document.getElementById('pd-tier-view').style.display = 'none';
    document.getElementById('pd-form-view').style.display = 'block';
    document.getElementById('pd-form-view').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  document.getElementById('pd-back')?.addEventListener('click', () => {
    document.getElementById('pd-form-view').style.display = 'none';
    document.getElementById('pd-tier-view').style.display = '';
    document.getElementById('pd-error').style.display = 'none';
  });

  document.getElementById('pd-checkout')?.addEventListener('click', () => {
    const name = document.getElementById('pd-name').value.trim();
    const email = document.getElementById('pd-email').value.trim();
    const errEl = document.getElementById('pd-error');
    if (!name || !email) { errEl.textContent = 'Please enter your name and email.'; errEl.style.display = 'block'; return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { errEl.textContent = 'Please enter a valid email address.'; errEl.style.display = 'block'; return; }
    errEl.style.display = 'none';
    window.posthog?.capture?.('padel_checkout_started', { event: 'padel-dec-2026' });
    const url = new URL('https://paystack.com/buy/private-victories-jhb-padel-social-ga-himeyd');
    url.searchParams.set('name', name);
    url.searchParams.set('email', email);
    window.location.href = url.toString();
  });
</script>

<style>
  /* ── NAV ── */
  .pd-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 24px 48px;
    transition: background 0.3s, padding 0.3s;
  }
  .pd-nav.scrolled { background: rgba(8,8,8,0.92); backdrop-filter: blur(12px); padding: 16px 48px; }
  @media (max-width: 768px) { .pd-nav { padding: 20px 24px; } .pd-nav.scrolled { padding: 14px 24px; } }

  .pd-nav-logo {
    font-family: var(--g); font-size: 10px; letter-spacing: 4px;
    text-transform: uppercase; color: var(--lavender-dim); text-decoration: none;
    transition: color 0.2s;
  }
  .pd-nav-logo:hover { color: var(--lavender); }

  .pd-nav-cta {
    font-family: var(--g); font-size: 10px; letter-spacing: 3px; text-transform: uppercase;
    color: var(--white); background: var(--plum); text-decoration: none;
    padding: 12px 24px; transition: background 0.2s;
  }
  .pd-nav-cta:hover { background: var(--plum-mid); }

  /* ── HERO ── */
  .pd-hero {
    min-height: 100svh; background: var(--black);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; position: relative; overflow: hidden;
    padding: 120px 24px 180px;
  }
  .pd-hero-bg {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    opacity: 0.35; z-index: 0;
  }
  .pd-hero-overlay {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(to bottom, rgba(8,8,8,0.55) 0%, rgba(8,8,8,0.3) 40%, rgba(8,8,8,0.75) 100%);
  }
  .pd-hero-inner { position: relative; z-index: 3; display: flex; flex-direction: column; align-items: center; gap: 0; }

  .pd-hero-label {
    font-size: 10px; letter-spacing: 5px; text-transform: uppercase;
    color: var(--lavender-dim); margin-bottom: 24px;
  }

  .pd-hero-word {
    font-family: var(--g); font-weight: 800;
    font-size: clamp(96px, 22vw, 280px);
    letter-spacing: -6px; line-height: 0.88;
    text-transform: uppercase; color: var(--white);
    margin-bottom: 32px;
  }

  .pd-hero-sub {
    font-family: var(--s); font-size: 14px; letter-spacing: 3px;
    text-transform: uppercase; color: var(--lavender-dim); margin-bottom: 48px;
  }

  .pd-hero-cta {
    display: inline-block; background: var(--plum); color: var(--white);
    font-family: var(--g); font-size: 11px; letter-spacing: 3.5px; text-transform: uppercase;
    text-decoration: none; padding: 20px 64px;
    transition: background 0.2s, transform 0.15s; margin-bottom: 40px;
  }
  .pd-hero-cta:hover { background: var(--plum-mid); transform: translateY(-1px); }

  .pd-hero-meta {
    display: flex; align-items: center; gap: 12px;
    font-family: var(--s); font-size: 12px; color: var(--lavender-dim);
    letter-spacing: 1px;
  }
  .pd-hero-dot { color: rgba(196,184,192,0.3); }

  /* ── STICKY BAR ── */
  .pd-sticky-bar {
    position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
    display: flex; align-items: center; gap: 24px;
    background: rgba(10,10,10,0.95); backdrop-filter: blur(16px);
    border: 1px solid rgba(196,184,192,0.12);
    padding: 14px 14px 14px 28px;
    z-index: 90; white-space: nowrap;
    opacity: 0; pointer-events: none;
    transition: opacity 0.3s, transform 0.3s;
    transform: translateX(-50%) translateY(8px);
  }
  .pd-sticky-bar.visible { opacity: 1; pointer-events: all; transform: translateX(-50%) translateY(0); }
  @media (max-width: 480px) { .pd-sticky-bar { left: 16px; right: 16px; transform: none; bottom: 16px; justify-content: space-between; }
    .pd-sticky-bar.visible { transform: none; }
  }

  .pd-sticky-label {
    font-family: var(--s); font-size: 13px; color: var(--lavender-dim);
  }
  .pd-sticky-cta {
    font-family: var(--g); font-size: 10px; letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--white); background: var(--plum); text-decoration: none;
    padding: 12px 20px; transition: background 0.2s;
  }
  .pd-sticky-cta:hover { background: var(--plum-mid); }

  /* ── PHOTO STRIP ── */
  .pd-photo-strip {
    overflow-x: auto; overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    background: var(--pure-black);
  }
  .pd-photo-strip::-webkit-scrollbar { display: none; }

  .pd-photo-track {
    display: flex; gap: 2px; align-items: stretch;
    min-width: max-content; height: 460px;
  }
  @media (max-width: 768px) { .pd-photo-track { height: 320px; } }

  .pd-photo-item {
    position: relative; overflow: hidden; flex-shrink: 0;
    width: 340px; height: 100%;
  }
  .pd-photo-item--tall { width: 280px; }
  @media (max-width: 768px) { .pd-photo-item { width: 240px; } .pd-photo-item--tall { width: 200px; } }

  .pd-photo-item img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.6s ease;
  }
  .pd-photo-item:hover img { transform: scale(1.03); }

  .pd-photo-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(8,8,8,0.6) 0%, rgba(8,8,8,0.1) 50%, transparent 100%);
  }

  .pd-photo-caption {
    position: absolute; bottom: 16px; left: 16px;
    font-size: 9px; letter-spacing: 3px; text-transform: uppercase;
    color: rgba(196,184,192,0.6);
  }

  /* ── COUNTDOWN ── */
  .pd-countdown-bar {
    background: var(--pure-black);
    border-top: 1px solid rgba(196,184,192,0.1);
    border-bottom: 1px solid rgba(196,184,192,0.1);
    padding: 56px 24px;
  }
  .pd-countdown-inner {
    max-width: 900px; margin: 0 auto;
    display: flex; flex-direction: column; align-items: center; gap: 24px; text-align: center;
  }
  .pd-countdown-label { font-size: 10px; letter-spacing: 4px; text-transform: uppercase; color: var(--lavender-dim); }

  .pd-countdown-units { display: flex; align-items: flex-start; }
  .pd-cd-unit {
    display: flex; flex-direction: column; align-items: center;
    padding: 0 24px;
    border-right: 1px solid rgba(196,184,192,0.1);
  }
  .pd-cd-unit:last-child { border-right: none; }
  @media (max-width: 480px) { .pd-cd-unit { padding: 0 14px; } }

  .pd-cd-num {
    font-family: var(--g); font-size: clamp(48px, 10vw, 96px);
    font-weight: 700; color: var(--white); line-height: 1; letter-spacing: -3px;
  }
  .pd-cd-lbl { font-size: 9px; letter-spacing: 3px; text-transform: uppercase; color: var(--lavender-dim); margin-top: 10px; }
  .pd-cd-sep { display: none; }

  /* ── SECTIONS ── */
  .pd-section { position: relative; padding: 96px 48px; overflow: hidden; }
  @media (max-width: 768px) { .pd-section { padding: 72px 24px; } }

  .pd-inner { max-width: 900px; margin: 0 auto; }

  .pd-label {
    font-size: 9.5px; letter-spacing: 4px; text-transform: uppercase;
    color: var(--lavender-dim); margin-bottom: 32px;
    display: flex; align-items: center; gap: 20px;
  }
  .pd-label::after { content: ''; display: block; height: 1px; flex: 0 0 60px; background: var(--lavender-dim); }

  /* ── PREMISE ── */
  .pd-premise { background: var(--charcoal); }
  .pd-premise-lead {
    font-family: var(--g); font-size: clamp(28px, 4vw, 52px);
    font-weight: 700; color: var(--white); letter-spacing: -1.5px; margin-bottom: 20px;
  }
  .pd-premise-body {
    font-family: var(--s); font-size: 17px; color: var(--lavender-dim);
    line-height: 1.7; max-width: 640px; margin-bottom: 56px;
  }

  .pd-stats {
    display: flex; align-items: center;
    border-top: 1px solid rgba(196,184,192,0.1); padding-top: 40px;
    flex-wrap: wrap; gap: 0;
  }
  .pd-stat { padding-right: 48px; }
  .pd-stat-num {
    font-family: var(--g); font-size: clamp(52px, 8vw, 88px);
    font-weight: 700; color: var(--white); line-height: 1; letter-spacing: -3px;
  }
  .pd-stat-label { font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: var(--lavender-dim); margin-top: 8px; }
  .pd-stat-div { width: 1px; height: 80px; background: rgba(196,184,192,0.1); margin-right: 48px; }
  @media (max-width: 600px) { .pd-stats { gap: 32px; } .pd-stat { padding-right: 0; } .pd-stat-div { display: none; } }

  /* ── FULL BREAK ── */
  .pd-full-break {
    height: 70vh; min-height: 400px; position: relative; overflow: hidden;
  }
  .pd-full-break img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .pd-full-break-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, rgba(8,8,8,0.3) 0%, rgba(8,8,8,0.15) 50%, rgba(8,8,8,0.5) 100%);
  }
  .pd-full-break-caption {
    position: absolute; bottom: 24px; right: 48px;
    font-size: 9px; letter-spacing: 3px; text-transform: uppercase;
    color: rgba(196,184,192,0.5); z-index: 3;
  }
  @media (max-width: 768px) { .pd-full-break-caption { right: 24px; } }

  /* ── STATEMENT ── */
  .pd-statement { background: var(--plum-deep); }
  .pd-statement-inner { text-align: center; }
  .pd-statement-head {
    font-family: var(--g); font-size: clamp(22px, 3.5vw, 44px);
    font-weight: 700; color: var(--white); letter-spacing: -1.5px;
    line-height: 1.1; margin-bottom: 24px; max-width: 760px; margin-left: auto; margin-right: auto;
  }
  .pd-statement-sub { font-family: var(--s); font-size: 16px; color: var(--lavender-dim); }

  /* ── FORMAT ── */
  .pd-format { background: var(--black); }
  .pd-schedule { list-style: none; }
  .pd-sched {
    display: grid; grid-template-columns: 64px 1fr;
    gap: 24px; padding: 28px 0;
    border-bottom: 1px solid rgba(196,184,192,0.08);
    align-items: start;
  }
  .pd-sched:first-child { border-top: 1px solid rgba(196,184,192,0.08); }
  @media (max-width: 600px) { .pd-sched { grid-template-columns: 40px 1fr; gap: 16px; } }

  .pd-sched-num { font-size: 10px; letter-spacing: 2px; color: rgba(196,184,192,0.25); padding-top: 3px; }
  .pd-sched-tag { font-family: var(--g); font-size: 15px; font-weight: 600; color: var(--lavender); margin-bottom: 6px; }
  .pd-sched-desc { font-family: var(--s); font-size: 15px; color: var(--lavender-dim); line-height: 1.65; }
  .pd-format-note {
    font-family: var(--s); font-size: 13px; color: var(--lavender-dim);
    margin-top: 32px; padding-top: 32px;
    border-top: 1px solid rgba(196,184,192,0.08);
  }

  /* ── VIDEO SECTION ── */
  .pd-video-section { background: var(--charcoal); padding: 24px; display: flex; flex-direction: column; gap: 16px; }

  .pd-video-grid {
    display: grid; gap: 16px;
  }
  .pd-video-grid--2 { grid-template-columns: 1fr 1fr; }
  .pd-video-grid--3 { grid-template-columns: 1fr 1fr 1fr; }

  @media (max-width: 768px) {
    .pd-video-grid--2 { grid-template-columns: 1fr; }
    .pd-video-grid--3 { grid-template-columns: 1fr 1fr; }
    .pd-video-section { padding: 16px; gap: 12px; }
  }
  @media (max-width: 480px) { .pd-video-grid--3 { grid-template-columns: 1fr; } }

  .pd-video-slot {
    position: relative; overflow: hidden; aspect-ratio: 4/3;
    background: var(--black);
  }
  .pd-video-grid--3 .pd-video-slot { aspect-ratio: 3/4; }

  .pd-video-slot video {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .pd-video-label {
    position: absolute; bottom: 14px; left: 14px;
    font-size: 9px; letter-spacing: 3px; text-transform: uppercase;
    color: rgba(196,184,192,0.5); z-index: 2;
  }

  /* ── WHO ── */
  .pd-who { background: var(--charcoal); }
  .pd-who-lead {
    font-family: var(--g); font-size: clamp(22px, 3vw, 36px);
    font-weight: 700; color: var(--white); letter-spacing: -0.5px; margin-bottom: 32px;
  }
  .pd-who-list { list-style: none; }
  .pd-who-list li {
    font-family: var(--s); font-size: 16px; color: var(--lavender-dim);
    padding: 20px 0 20px 56px; border-bottom: 1px solid rgba(196,184,192,0.08);
    position: relative; line-height: 1.6;
  }
  .pd-who-list li:first-child { border-top: 1px solid rgba(196,184,192,0.08); }
  .pd-who-list li::before {
    content: attr(data-num); position: absolute; left: 0; top: 50%; transform: translateY(-50%);
    font-size: 10px; letter-spacing: 2px; color: rgba(196,184,192,0.25);
  }

  /* ── DETAILS ── */
  .pd-details { background: var(--black); }
  .pd-details-grid {
    display: grid; grid-template-columns: 220px 1fr; gap: 0;
    border-top: 1px solid rgba(196,184,192,0.1);
  }
  .pd-dk {
    font-size: 10px; letter-spacing: 3px; text-transform: uppercase;
    color: var(--lavender-dim); padding: 20px 0;
    border-bottom: 1px solid rgba(196,184,192,0.07);
    display: flex; align-items: center;
  }
  .pd-dv {
    font-family: var(--s); font-size: 15px; color: var(--white);
    padding: 20px 0; border-bottom: 1px solid rgba(196,184,192,0.07);
    display: flex; align-items: center;
  }
  .pd-tbd { color: var(--lavender-dim); font-style: italic; }
  @media (max-width: 600px) {
    .pd-details-grid { grid-template-columns: 1fr; }
    .pd-dk { border-bottom: none; padding-bottom: 4px; }
    .pd-dv { padding-top: 0; }
  }

  /* ── TICKETS ── */
  .pd-tickets-section {
    background: var(--charcoal); position: relative;
    padding: 96px 48px; overflow: hidden;
  }
  @media (max-width: 768px) { .pd-tickets-section { padding: 72px 24px; } }
  .pd-tickets-inner { max-width: 900px; margin: 0 auto; }

  .pd-tickets-head { text-align: center; margin-bottom: 56px; }
  .pd-tickets-note { font-family: var(--s); font-size: 15px; color: var(--lavender-dim); margin-bottom: 20px; }
  .pd-social-proof { display: inline-flex; align-items: center; gap: 10px; font-family: var(--s); font-size: 13px; color: var(--lavender-dim); }
  .pd-proof-dot { width: 7px; height: 7px; border-radius: 50%; background: #4ade80; flex-shrink: 0; animation: proof-pulse 2s ease-in-out infinite; }
  @keyframes proof-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

  .pd-tier {
    display: grid; grid-template-columns: 220px 1fr;
    border: 1px solid rgba(196,184,192,0.12);
    margin-bottom: 48px;
  }
  @media (max-width: 700px) { .pd-tier { grid-template-columns: 1fr; } }

  .pd-tier-left {
    background: rgba(69,24,63,0.2); padding: 40px 32px;
    display: flex; flex-direction: column; gap: 8px;
    border-right: 1px solid rgba(196,184,192,0.12);
    position: relative; overflow: hidden;
  }
  @media (max-width: 700px) { .pd-tier-left { border-right: none; border-bottom: 1px solid rgba(196,184,192,0.12); } }

  .pd-tier-badge { font-size: 9.5px; letter-spacing: 4px; text-transform: uppercase; color: var(--lavender); }
  .pd-tier-hint { font-family: var(--s); font-size: 12px; color: var(--lavender-dim); margin-top: 6px; }
  .pd-tier-wm {
    position: absolute; bottom: -10px; right: -4px;
    font-family: var(--g); font-size: 72px; font-weight: 800;
    color: rgba(196,184,192,0.05); pointer-events: none; user-select: none; line-height: 1;
  }

  .pd-tier-right { padding: 40px; }
  .pd-tier-list { list-style: none; display: flex; flex-direction: column; gap: 12px; margin-bottom: 32px; }
  .pd-tier-list li { font-family: var(--s); font-size: 15px; color: var(--lavender-dim); display: flex; gap: 12px; }
  .pd-tier-list span { color: var(--lavender); flex-shrink: 0; }

  /* Payment form */
  .pd-form-wrap { padding: 48px 0; }
  .pd-back-btn {
    background: none; border: none; color: var(--lavender-dim);
    font-family: var(--s); font-size: 13px; cursor: pointer;
    padding: 0; margin-bottom: 32px; transition: color 0.2s;
  }
  .pd-back-btn:hover { color: var(--lavender); }
  .pd-form-eyebrow { font-size: 9.5px; letter-spacing: 4px; text-transform: uppercase; color: var(--lavender); margin-bottom: 32px; }
  .pd-form-field { margin-bottom: 24px; }
  .pd-form-label { display: block; font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: var(--lavender-dim); margin-bottom: 10px; }
  .pd-form-field input {
    width: 100%; background: rgba(255,255,255,0.03);
    border: 1px solid rgba(196,184,192,0.15);
    color: var(--white); font-family: var(--s); font-size: 15px;
    padding: 14px 16px; outline: none;
    transition: border-color 0.2s; border-radius: 0;
  }
  .pd-form-field input:focus { border-color: rgba(196,184,192,0.4); }
  .pd-form-field input::placeholder { color: var(--lavender-dim); }
  .pd-error { margin-top: 16px; padding: 14px 16px; background: rgba(200,80,80,0.1); border: 1px solid rgba(200,80,80,0.3); color: #e09090; font-family: var(--s); font-size: 14px; }

  /* Success */
  .pd-success { text-align: center; padding: 80px 0; }
  .pd-success-mark { font-family: var(--g); font-size: 72px; color: var(--lavender); line-height: 1; margin-bottom: 24px; }
  .pd-success-title { font-family: var(--g); font-size: 48px; font-weight: 700; color: var(--white); letter-spacing: -2px; margin-bottom: 16px; }
  .pd-success-body { font-family: var(--s); font-size: 16px; color: var(--lavender-dim); }

  /* Secure note */
  .pd-secure-note {
    text-align: center; margin-top: 14px;
    font-family: var(--s); font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
    color: rgba(196,184,192,0.35);
  }

  /* Fine print */
  .pd-fine-print { margin-top: 48px; border-top: 1px solid rgba(196,184,192,0.1); padding-top: 32px; display: flex; flex-direction: column; gap: 12px; }
  .pd-fine-print p { font-family: var(--s); font-size: 13px; color: var(--lavender-dim); line-height: 1.65; }
  .pd-fine-print strong { color: rgba(196,184,192,0.6); font-weight: 500; }
  .pd-fine-print a { color: var(--lavender-dim); border-bottom: 1px solid rgba(196,184,192,0.2); text-decoration: none; }
  .pd-fine-print a:hover { color: var(--lavender); }

  /* ── CLOSE ── */
  .pd-close { background: var(--plum-deep); }
  .pd-close-inner { text-align: center; }
  .pd-close-quote {
    font-family: var(--g); font-size: clamp(20px, 3vw, 36px);
    font-weight: 700; color: var(--white); letter-spacing: -1px;
    max-width: 640px; margin: 0 auto 40px; line-height: 1.2;
  }

  /* ── REVEAL ── */
  .reveal { opacity: 0; transform: translateY(20px); transition: opacity 0.65s ease, transform 0.65s ease; }
  .reveal.visible { opacity: 1; transform: none; }
  .d1 { transition-delay: 0.1s; } .d2 { transition-delay: 0.2s; }
  .d3 { transition-delay: 0.3s; } .d4 { transition-delay: 0.4s; }
</style>

</body>
</html>
