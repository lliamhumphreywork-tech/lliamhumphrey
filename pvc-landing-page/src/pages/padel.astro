      <p class="pd-secure-note">Secure checkout on Paystack</p>
      <div class="pd-error" id="pd-error" style="display:none;"></div>
    </div>

    <!-- SUCCESS -->
    <div id="pd-success" style="display:none;" class="pd-success">
      <div class="pd-success-mark">✓</div>
      <h2 class="pd-success-title">You're in.</h2>
      <p class="pd-success-body">Check your inbox. Confirmation is on its way. See you on the courts.</p>
    </div>

    <div class="pd-fine-print reveal">
      <p><strong>Refund policy:</strong> Full refund if you cancel more than 7 days before the event. No refunds within 7 days, but your spot is transferable.</p>
      <p>Questions? DM <a href="https://instagram.com/privatevictories.club" target="_blank" rel="noopener">@privatevictories.club</a> on Instagram.</p>
    </div>
  </div>
