  /* ── DETAILS ── */
  .pd-details { background: var(--black); }
  .pd-details-grid {
    display: grid; grid-template-columns: 220px 1fr; gap: 0;
    border-top: 1px solid rgba(196,184,192,0.1);
  }
  .pd-dk {
    font-size: 10px; letter-spacing: 3px; text-transform: uppercase;
    color: var(--lavender-dim); padding: 20px 0;
    border-bottom: 1px solid rgba(196,184,192,0.07);
    display: flex; align-items: center;
  }
  .pd-dv {
    font-family: var(--s); font-size: 15px; color: var(--white);
    padding: 20px 0; border-bottom: 1px solid rgba(196,184,192,0.07);
    display: flex; align-items: center;
  }
  .pd-tbd { color: var(--lavender-dim); font-style: italic; }
  @media (max-width: 600px) {
    .pd-details-grid { grid-template-columns: 1fr; }
    .pd-dk { border-bottom: none; padding-bottom: 4px; }
    .pd-dv { padding-top: 0; }
  }

  /* ── TICKETS ── */
  .pd-tickets-section {
    background: var(--charcoal); position: relative;
    padding: 96px 48px; overflow: hidden;
  }
  @media (max-width: 768px) { .pd-tickets-section { padding: 72px 24px; } }
  .pd-tickets-inner { max-width: 900px; margin: 0 auto; }

  .pd-tickets-head { text-align: center; margin-bottom: 56px; }
  .pd-tickets-note { font-family: var(--s); font-size: 15px; color: var(--lavender-dim); margin-bottom: 20px; }
  .pd-social-proof { display: inline-flex; align-items: center; gap: 10px; font-family: var(--s); font-size: 13px; color: var(--lavender-dim); }
  .pd-proof-dot { width: 7px; height: 7px; border-radius: 50%; background: #4ade80; flex-shrink: 0; animation: proof-pulse 2s ease-in-out infinite; }
  @keyframes proof-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

  .pd-tier {
    display: grid; grid-template-columns: 220px 1fr;
    border: 1px solid rgba(196,184,192,0.12);
    margin-bottom: 48px;
  }
  @media (max-width: 700px) { .pd-tier { grid-template-columns: 1fr; } }

  .pd-tier-left {
    background: rgba(69,24,63,0.2); padding: 40px 32px;
    display: flex; flex-direction: column; gap: 8px;
    border-right: 1px solid rgba(196,184,192,0.12);
    position: relative; overflow: hidden;
  }
  @media (max-width: 700px) { .pd-tier-left { border-right: none; border-bottom: 1px solid rgba(196,184,192,0.12); } }

  .pd-tier-badge { font-size: 9.5px; letter-spacing: 4px; text-transform: uppercase; color: var(--lavender); }
  .pd-early-badge { display: inline-block; margin-top: 6px; padding: 3px 8px; background: var(--lavender); color: #0d0d0d; font-size: 9px; letter-spacing: 3px; text-transform: uppercase; font-weight: 700; border-radius: 2px; }
  .pd-tier-hint { font-family: var(--s); font-size: 12px; color: var(--lavender-dim); margin-top: 6px; }
  .pd-tier-wm {
    position: absolute; bottom: -10px; right: -4px;
    font-family: var(--g); font-size: 72px; font-weight: 800;
    color: rgba(196,184,192,0.05); pointer-events: none; user-select: none; line-height: 1;
  }

  .pd-tier-right { padding: 40px; }
  @media (max-width: 480px) { .pd-tier-right { padding: 28px 20px; } }
  .pd-tier-list { list-style: none; display: flex; flex-direction: column; gap: 12px; margin-bottom: 32px; }
  .pd-tier-list li { font-family: var(--s); font-size: 15px; color: var(--lavender-dim); display: flex; gap: 12px; }
  .pd-tier-list span { color: var(--lavender); flex-shrink: 0; }

  /* Payment form */
  .pd-form-wrap { padding: 48px 0; }
  .pd-back-btn {
    background: none; border: none; color: var(--lavender-dim);
    font-family: var(--s); font-size: 13px; cursor: pointer;
    padding: 0; margin-bottom: 32px; transition: color 0.2s;
  }
  .pd-back-btn:hover { color: var(--lavender); }
  .pd-form-eyebrow { font-size: 9.5px; letter-spacing: 4px; text-transform: uppercase; color: var(--lavender); margin-bottom: 32px; }
  .pd-form-field { margin-bottom: 24px; }
  .pd-form-label { display: block; font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: var(--lavender-dim); margin-bottom: 10px; }
  .pd-form-field input:not([type="radio"]) {
    width: 100%; background: rgba(255,255,255,0.03);
    border: 1px solid rgba(196,184,192,0.15);
    color: var(--white); font-family: var(--s); font-size: 15px;
    padding: 14px 16px; outline: none;
    transition: border-color 0.2s; border-radius: 0;
  }
  .pd-form-field input:not([type="radio"]):focus { border-color: rgba(196,184,192,0.4); }
  .pd-form-field input::placeholder { color: var(--lavender-dim); }
  .pd-error { margin-top: 16px; padding: 14px 16px; background: rgba(200,80,80,0.1); border: 1px solid rgba(200,80,80,0.3); color: #e09090; font-family: var(--s); font-size: 14px; }

  /* Success */
  .pd-success { text-align: center; padding: 80px 0; }
  .pd-success-mark { font-family: var(--g); font-size: 72px; color: var(--lavender); line-height: 1; margin-bottom: 24px; }
  .pd-success-title { font-family: var(--g); font-size: 48px; font-weight: 700; color: var(--white); letter-spacing: -2px; margin-bottom: 16px; }
  .pd-success-body { font-family: var(--s); font-size: 16px; color: var(--lavender-dim); }

  /* Secure note */
  .pd-secure-note {
    text-align: center; margin-top: 14px;
    font-family: var(--s); font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
    color: rgba(196,184,192,0.35);
  }

  /* Caps display */
  .pd-caps-display { font-family: var(--s); font-size: 13px; color: var(--lavender-dim); }

  /* Ticket toggle (member URL only) */
  .pd-ticket-toggle { display: flex; gap: 0; margin-bottom: 24px; border: 1px solid rgba(196,184,192,0.15); overflow: hidden; }
  .pd-tt-btn { flex: 1; background: none; border: none; color: var(--lavender-dim); font-family: var(--s); font-size: 13px; padding: 14px 20px; cursor: pointer; transition: background .2s, color .2s; }
  .pd-tt-btn--active { background: rgba(196,184,192,0.1); color: var(--white); }
  .pd-tt-btn:not(:last-child) { border-right: 1px solid rgba(196,184,192,0.15); }

  /* Tier price */
  .pd-tier-price { font-family: var(--g); font-size: 32px; font-weight: 700; color: var(--white); letter-spacing: -1px; margin: 8px 0 4px; }

  /* Playing options */
  .pd-playing-opts { display: flex; flex-direction: column; gap: 10px; margin-top: 2px; }
  .pd-playing-label {
    display: flex; align-items: flex-start; gap: 12px;
    width: 100%; box-sizing: border-box;
    border: 1px solid rgba(196,184,192,0.12); padding: 16px;
    cursor: pointer; transition: border-color .2s;
  }
  .pd-playing-label:has(input:checked) {
    border-color: var(--lavender);
    background: rgba(196,184,192,0.08);
  }
  .pd-playing-label:has(input:checked) .pd-playing-opt-title { color: var(--lavender); }
  .pd-playing-label--disabled { opacity: .45; cursor: not-allowed; }
  .pd-playing-label input[type="radio"] { margin-top: 3px; flex-shrink: 0; accent-color: var(--lavender); }
  .pd-playing-opt-inner { display: flex; flex-direction: column; gap: 3px; }
  .pd-playing-opt-title { font-family: var(--s); font-size: 15px; color: var(--white); font-weight: 500; }
  .pd-playing-opt-sub { font-family: var(--s); font-size: 13px; color: var(--lavender-dim); line-height: 1.4; }
  .pd-player-cap-note { font-family: var(--s); font-size: 13px; color: #e09090; margin-top: 8px; }

  /* Fine print */
  .pd-fine-print { margin-top: 48px; border-top: 1px solid rgba(196,184,192,0.1); padding-top: 32px; display: flex; flex-direction: column; gap: 12px; }
  .pd-fine-print p { font-family: var(--s); font-size: 13px; color: var(--lavender-dim); line-height: 1.65; }
  .pd-fine-print strong { color: rgba(196,184,192,0.6); font-weight: 500; }
  .pd-fine-print a { color: var(--lavender-dim); border-bottom: 1px solid rgba(196,184,192,0.2); text-decoration: none; }
  .pd-fine-print a:hover { color: var(--lavender); }

  /* ── CLOSE ── */
  .pd-close { background: var(--plum-deep); }
  .pd-close-inner { text-align: center; }
  .pd-close-quote {
    font-family: var(--g); font-size: clamp(20px, 3vw, 36px);
    font-weight: 700; color: var(--white); letter-spacing: -1px;
    max-width: 640px; margin: 0 auto 40px; line-height: 1.2;
  }

  /* ── REVEAL ── */
  .reveal { opacity: 0; transform: translateY(20px); transition: opacity 0.65s ease, transform 0.65s ease; }
  .reveal.visible { opacity: 1; transform: none; }
  .d1 { transition-delay: 0.1s; } .d2 { transition-delay: 0.2s; }
  .d3 { transition-delay: 0.3s; } .d4 { transition-delay: 0.4s; }
</style>

</body>
</html>
